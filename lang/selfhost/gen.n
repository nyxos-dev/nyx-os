            tv := sb[n0 + j3];             // returning arm never reaches
            if tr == 1 && er == 1 { va7[j3 * 10 + 8] = tv; }   // it; with
            if tr == 0 && er == 1 { va7[j3 * 10 + 8] = tv; }   // both live
            if tr == 0 && er == 0 && tv != va7[j3 * 10 + 8] {  // they must
