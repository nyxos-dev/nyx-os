        n0 := st[40];                      // tracking: BOTH arms check
        sb := arena_alloc((n0 * 2 + 1) * 8) as *i64;   // from the same pre-if
        va7 := st[39] as *i64;             // states, and the two exits
        mut j := 0;                        // must AGREE at the merge
        while j < n0 {                     // point below
            sb[j] = va7[j * 10 + 8];       // pre[] = the pre-if states
            j = j + 1;
