// Block scope: record the name count on entry, truncate on exit —
// ncc's gen_block move.
#[caps(syscall)]
fn cblock(p: *u8, st: *i64, i: i64) {
    if st[41] == 1 { return; }
    if i == 0 { return; }
    nd := st[33] as *i64;
    vsave := st[40];
    st[43] = st[43] + 1;                   // ncc's BLOCK_DEPTH: 1 = the
    mut s := nd[i * 8 + 1];                // function's own block
    while s > 0 {
        cstmt(p, st, s);
        if st[41] == 1 { return; }
        s = nd[s * 8 + 7];
    }
    t := nd[i * 8 + 2];
    if t > 0 {
        cexpr(p, st, t);
        cmove(p, st, t, nd[t * 8 + 4]);    // ncc: own_move_expr(tail, tail->line)
    }
    cdrops(p, st, vsave);                  // v0.19 auto-drops close the
    mut s2 := nd[i * 8 + 1];               // scope, THEN nothing may leak
    mut lst2 := 0;                         // out of it — the scan reports
    while s2 > 0 {                         // at the LAST statement's line
        lst2 = s2;                         // (ncc: b->st[n-1]->line, the
        s2 = nd[s2 * 8 + 7];               // `{` line for an empty block)
    }
    mut ln9 := nd[i * 8 + 4];
    if lst2 > 0 { ln9 = nd[lst2 * 8 + 4]; }
    if st[43] == 1 { cheld(p, st, ln9); }  // v0.25: the function's end
    cleak(p, st, vsave, ln9, 1);
    st[43] = st[43] - 1;
    st[40] = vsave;
}

// One method: like a function, but self leads the name table (the
// impl type, immutable — ncc's vars_add("self", ty_named(type), 0))
// and methods hold no capabilities (v0.14).
#[caps(syscall)]
fn cmeth(p: *u8, st: *i64, mi: i64) {
    ma := st[53] as *i64;
    al := st[35] as *i64;
    st[40] = 0;
    st[42] = 0;                            // CUR_FN_CAPS: none
    st[43] = 0;
    st[55] = 0;                            // LOOP/MATCH depth (ncc resets
    st[56] = 0;                            // them per method too)
    crt2 := mrty(st, mi);                  // CUR_RET = the method's
    st[45] = crt2.pt;
    st[46] = crt2.us;
    st[47] = crt2.s;
    st[48] = crt2.l;
    selfty := T{ pt: 0, us: 0, s: ma[mi * 8], l: ma[mi * 8 + 1] };
    vadd(st, st[44] + 24, 4, 0, selfty);   // self, interned span
    mut q := 0;
    while q < ma[mi * 8 + 4] {
        r := ma[mi * 8 + 5] + q * 6;
        pt4 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        vadd(st, al[r], al[r + 1], 0, pt4);
        q = q + 1;
    }
    nvr6 := crt2.l == 5 && eq5(p, crt2.s, 110, 101, 118, 101, 114);
    if crt2.l > 0 && !nvr6 {               // v0.22, the method twin
        if bguar(p, st, ma[mi * 8 + 6]) == 0 {
            put(" not every path through method '");
            put_span(p, ma[mi * 8], ma[mi * 8 + 1]);
            put(".");
            put_span(p, ma[mi * 8 + 2], ma[mi * 8 + 3]);
            put("' returns a ");
            ty_put(p, st, crt2);
            put(" — add a tail expression or a return\n");
            st[41] = 1;
            return;
        }
    }
    cblock(p, st, ma[mi * 8 + 6]);
}

// One function: a fresh name table seeded with the params (params
// are immutable — ncc adds them with is_mut 0), then the body.
#[caps(syscall)]
fn cfn(p: *u8, st: *i64, fi: i64) {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    st[40] = 0;
    st[42] = ft[fi * 8 + 3];               // CUR_FN_CAPS, ncc's reset
    st[43] = 0;                            // BLOCK_DEPTH, per function
    st[55] = 0;                            // LOOP_DEPTH and MATCH_DEPTH
    st[56] = 0;                            // reset per function (ncc)
    crt := frty(st, fi);                   // CUR_RET at st[45..48]
    st[45] = crt.pt;
    st[46] = crt.us;
    st[47] = crt.s;
    st[48] = crt.l;
    mut q := 0;
    while q < ft[fi * 8 + 2] {             // params: span + declared type
        r := ft[fi * 8 + 5] + q * 6;
        pt2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        vadd(st, al[r], al[r + 1], 0, pt2);
        if tyown(p, st, pt2) {             // v0.17: this fn is the owner
            vh := st[39] as *i64;          // now — HELD, no obligation
            vh[(st[40] - 1) * 10 + 8] = 3;
        }
        q = q + 1;
    }
    nvr5 := crt.l == 5 && eq5(p, crt.s, 110, 101, 118, 101, 114);
    if crt.l > 0 && !nvr5 {                // v0.22: every path must
        if bguar(p, st, ft[fi * 8 + 4]) == 0 {   // return (FILE-level)
            put(" not every path through '");
            put_span(p, ft[fi * 8], ft[fi * 8 + 1]);
            put("' returns a ");
            ty_put(p, st, crt);
            put(" — add a tail expression or a return\n");
            st[41] = 1;
            return;
        }
    }
    cblock(p, st, ft[fi * 8 + 4]);
}

// The declaration battery, in ncc's exact order: validate_drops runs
// FIRST (ncc's main calls it before gen_program), then gen_program's
// v0.17 containment preamble — struct fields, syscall params, enum
// variants, impl receivers. These messages are FILE-level: ncc prints
// them with no line number, and the harness's want-side normalization
// (strip the filename column) leaves a LEADING SPACE — so a FILE-level
// refusal prints " message" with that exact space, and both shapes
// ride one byte-exact contract (tests/bad/README.md).
fn cdecls(p: *u8, st: *i64) {
    sa := st[49] as *i64;
    al := st[35] as *i64;
    mut si := 0;
    while si < st[50] {                    // v0.19 destructor wiring
        if sa[si * 8 + 6] > 0 {
            ds := sa[si * 8 + 5];
            dl := sa[si * 8 + 6];
            fi := ffind(p, st, ds, dl);
            if fi < 0 {
                put(" #[drop(");
                put_span(p, ds, dl);
                put(")] on '");
                put_span(p, sa[si * 8], sa[si * 8 + 1]);
                put("': unknown function '");
                put_span(p, ds, dl);
                put("'\n");
                st[41] = 1;
                return;
            }
            ft := st[37] as *i64;
            pt0 := fpty(st, fi, 0);
            mut sok := 0;                  // exactly one by-value param
            if ft[fi * 8 + 2] == 1 && pt0.pt == 0 && pt0.l > 0 {
                if span_eq(p, pt0.s, pt0.l, sa[si * 8], sa[si * 8 + 1]) { sok = 1; }
            }
            if sok == 0 {
                put(" drop function '");
                put_span(p, ds, dl);
                put("' must take exactly one ");
                put_span(p, sa[si * 8], sa[si * 8 + 1]);
                put(" parameter\n");
                st[41] = 1;
                return;
            }
            rt := frty(st, fi);
            nvr := rt.l == 5 && eq5(p, rt.s, 110, 101, 118, 101, 114);
            if rt.l > 0 && !nvr {
                put(" drop function '");
                put_span(p, ds, dl);
                put("' must not return a value — the value ends there\n");
                st[41] = 1;
                return;
            }
        }
        si = si + 1;
    }
    mut si2 := 0;
    while si2 < st[50] {                   // own cannot nest in fields —
        mut q := 0;                        // except an OWN container's
        while q < sa[si2 * 8 + 2] {        // (v0.25)
            if typtrown(p, st, sfty(st, si2, q)) {   // ncc: validate_ty first
                eptrown(p, st, sfty(st, si2, q), sa[si2 * 8], sa[si2 * 8 + 1]);
                return;
            }
            if tyown(p, st, sfty(st, si2, q)) && sa[si2 * 8 + 4] != 1 {
                r := sa[si2 * 8 + 3] + q * 6;
                put(" own type in field '");
                put_span(p, sa[si2 * 8], sa[si2 * 8 + 1]);
                put(".");
                put_span(p, al[r], al[r + 1]);
                put("' — own values cannot nest in other types (v0.17)\n");
                st[41] = 1;
                return;
            }
            q = q + 1;
        }
        si2 = si2 + 1;
    }
    ft2 := st[37] as *i64;
    mut fi2 := 0;
    while fi2 < st[38] {                   // the kernel is not an owner
        if ft2[fi2 * 8 + 6] == 0 {
            if typtrown(p, st, frty(st, fi2)) {      // ncc: the return, then
                eptrown(p, st, frty(st, fi2), ft2[fi2 * 8], ft2[fi2 * 8 + 1]);
                return;                    // each parameter, validated
            }                              // before the own check
            mut q2 := 0;
            while q2 < ft2[fi2 * 8 + 2] {
                if typtrown(p, st, fpty(st, fi2, q2)) {
                    eptrown(p, st, fpty(st, fi2, q2), ft2[fi2 * 8], ft2[fi2 * 8 + 1]);
                    return;
                }
                if tyown(p, st, fpty(st, fi2, q2)) {
                    put(" own type in syscall '");
                    put_span(p, ft2[fi2 * 8], ft2[fi2 * 8 + 1]);
                    put("' — the kernel is not an owner (v0.17)\n");
                    st[41] = 1;
                    return;
                }
                q2 = q2 + 1;
            }
        }
        fi2 = fi2 + 1;
    }
    mut fi3 := 0;                          // then every fn's signature —
    while fi3 < st[38] {                   // its return, then its params
        if ft2[fi3 * 8 + 6] == 1 {         // (ncc: validate_ty per fn)
            if typtrown(p, st, frty(st, fi3)) {
                eptrown(p, st, frty(st, fi3), ft2[fi3 * 8], ft2[fi3 * 8 + 1]);
                return;
            }
            mut q3 := 0;
            while q3 < ft2[fi3 * 8 + 2] {
                if typtrown(p, st, fpty(st, fi3, q3)) {
                    eptrown(p, st, fpty(st, fi3, q3), ft2[fi3 * 8], ft2[fi3 * 8 + 1]);
                    return;
                }
                q3 = q3 + 1;
            }
        }
        fi3 = fi3 + 1;
    }
    ea := st[51] as *i64;
    mut ei := 0;
    while ei < st[52] {                    // nor an enum variant
        mut v := 0;
        while v < ea[ei * 4 + 2] {
            vb := ea[ei * 4 + 3] + v * 4;
            mut f2 := 0;
            while f2 < al[vb + 2] {
                r2 := al[vb + 3] + f2 * 6;
                t2 := T{ pt: al[r2 + 2], us: al[r2 + 3], s: al[r2 + 4], l: al[r2 + 5] };
                if typtrown(p, st, t2) {   // ncc: validate_ty first
                    eptrown(p, st, t2, ea[ei * 4], ea[ei * 4 + 1]);
                    return;
                }
                if tyown(p, st, t2) {
                    put(" own type in variant '");
                    put_span(p, ea[ei * 4], ea[ei * 4 + 1]);
                    put(".");
                    put_span(p, al[vb], al[vb + 1]);
                    put("' — own values cannot nest in other types (v0.17)\n");
                    st[41] = 1;
                    return;
                }
                f2 = f2 + 1;
            }
            v = v + 1;
        }
        ei = ei + 1;
    }
    ma := st[53] as *i64;
    mut mi := 0;
    while mi < st[54] {                    // impl receivers: known, and
        ts := ma[mi * 8];                  // never own (by-value self
        tl := ma[mi * 8 + 1];              // would move the receiver)
        si3 := sfind(p, st, ts, tl);
        if si3 < 0 && efind(p, st, ts, tl) < 0 {
            put(" impl for unknown type '");
            put_span(p, ts, tl);
            put("'\n");
            st[41] = 1;
            return;
        }
        if si3 >= 0 && sa[si3 * 8 + 4] == 1 {
            put(" impl for own type '");
            put_span(p, ts, tl);
            put("' — by-value self would move the receiver (v0.17)\n");
            st[41] = 1;
            return;
        }
        if typtrown(p, st, mrty(st, mi)) {         // ncc: the method's return,
            eptrown(p, st, mrty(st, mi), ma[mi * 8 + 2], ma[mi * 8 + 3]);
            return;                        // then its parameters
        }
        mut q6 := 0;
        while q6 < ma[mi * 8 + 4] {
            if typtrown(p, st, mpty(st, mi, q6)) {
                eptrown(p, st, mpty(st, mi, q6), ma[mi * 8 + 2], ma[mi * 8 + 3]);
                return;
            }
            q6 = q6 + 1;
        }
        mi = mi + 1;
    }
}

// The recorded param type / return type of one fn-table record.
fn fpty(st: *i64, fi: i64, q: i64) -> T {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    r := ft[fi * 8 + 5] + q * 6;
    T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] }
}

fn frty(st: *i64, fi: i64) -> T {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    r := ft[fi * 8 + 5] + ft[fi * 8 + 2] * 6;
    T{ pt: al[r], us: al[r + 1], s: al[r + 2], l: al[r + 3] }
}

// ncc's infer_type, transliterated: bottom-up, re-inferring on
// demand, i64 as the soft fallback (check.n's unresolved cases —
// struct fields, enum refs, method returns — fall back the same way
// until their tables land; the claimed rows never reach them).
#[caps(syscall)]
fn cinfer(p: *u8, st: *i64, i: i64) -> T {
    if i == 0 { return t_void(); }
    nd := st[33] as *i64;
    k := nd[i * 8];
    if k == 1 { return t_i64(st); }
    if k == 2 { return t_bool(st); }
    if k == 3 || k == 4 { return t_str(st); }
    if k == 5 {                            // path: a pageflags constant
        if is_pfc(p, nd[i * 8 + 5], nd[i * 8 + 6]) >= 0 {   // first (ncc's
            return t_pf(st);               // order), then the binding
        }
        v := vfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
        if v >= 0 { return vty(st, v); }
        fi0 := ffind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);   // v0.24: a fn
        if fi0 >= 0 {                      // named without a call is a
            ft0 := st[37] as *i64;         // value of its fn type
            if ft0[fi0 * 8 + 6] == 1 { return fn_value_ty(p, st, fi0); }
        }
        return t_i64(st);
    }
    if k == 6 {                            // call: the callee's return
        cal := nd[i * 8 + 1];
        if nd[cal * 8] == 5 {
            ab2 := is_argb(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if ab2 == 1 { return t_i64(st); }          // v0.23 builtins
            if ab2 == 2 { return t_str(st); }
            lv := vfind(p, st, nd[cal * 8 + 5], nd[cal * 8 + 6]);   // v0.24:
            if lv >= 0 {                   // through a fn value, the
                lfi := fnty_of(p, st, vty(st, lv));   // signature's return
                if lfi >= 0 { return fnty_ret(st, lfi); }
            }
            fi := ffind(p, st, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if fi >= 0 { return frty(st, fi); }
        }
        if nd[cal * 8] == 7 {              // method: the receiver's
            rt9 := cinfer(p, st, nd[cal * 8 + 1]);   // method's return
            if rt9.pt == 0 && rt9.l > 0 {
                mi2 := mfind(p, st, rt9.s, rt9.l, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                if mi2 >= 0 { return mrty(st, mi2); }
                ffi := field_fnty(p, st, rt9, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                if ffi >= 0 { return fnty_ret(st, ffi); }   // v0.24: a fn field
            }
        }
        return t_i64(st);
    }
    if k == 7 {                            // field: a variant reference
        b0 := nd[i * 8 + 1];               // first (Shape.Empty is a
        if nd[b0 * 8] == 5 {               // value of the enum, not a
            ei0 := efind(p, st, nd[b0 * 8 + 5], nd[b0 * 8 + 6]);
            if ei0 >= 0 {                  // field read), then str.ptr /
                return T{ pt: 0, us: 0, s: nd[b0 * 8 + 5], l: nd[b0 * 8 + 6] };
            }                              // str.len, then the struct
        }                                  // table
        bt := cinfer(p, st, nd[i * 8 + 1]);
        if span_is(p, bt, st[44] + 7, 3) {                 // base is str
            if nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 112, 116, 114) {
                return t_pu8(st);                          // .ptr
            }
            if nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 108, 101, 110) {
                return t_u64(st);                          // .len
            }
        }
        if bt.pt == 0 && bt.l > 0 {
            si := sfind(p, st, bt.s, bt.l);
            if si >= 0 {
                sa := st[49] as *i64;
                al := st[35] as *i64;
                mut q := 0;
                while q < sa[si * 8 + 2] {
                    r := sa[si * 8 + 3] + q * 6;
                    if span_eq(p, al[r], al[r + 1], nd[i * 8 + 5], nd[i * 8 + 6]) {
                        return sfty(st, si, q);
                    }
                    q = q + 1;
                }
            }
        }
        return t_i64(st);                  // enums/methods: later rungs
    }
    if k == 8 {                            // unary: '!' -> bool
        if nd[i * 8 + 3] == 60 { return t_bool(st); }
        return cinfer(p, st, nd[i * 8 + 1]);
    }
    if k == 9 {                            // binary: comparisons and
        c := nd[i * 8 + 3];                // logic -> bool, arithmetic
        if c == 54 || c == 55 || c == 56 || c == 57 || c == 58 || c == 59
            || c == 61 || c == 62 { return t_bool(st); }
        return cinfer(p, st, nd[i * 8 + 1]);   // left operand rules
    }
    if k == 10 {                           // cast: authoritative
        return T{ pt: nd[i * 8 + 2], us: nd[i * 8 + 3], s: nd[i * 8 + 5], l: nd[i * 8 + 6] };
    }
    if k == 11 || k == 12 {                // struct / enum literal: its
        return T{ pt: 0, us: 0, s: nd[i * 8 + 5], l: nd[i * 8 + 6] };   // name
    }
    if k == 13 {                           // index: element type
        bt := cinfer(p, st, nd[i * 8 + 1]);
        if bt.pt > 0 {
            return T{ pt: bt.pt - 1, us: 0, s: bt.s, l: bt.l };
        }
        if span_is(p, bt, st[44] + 7, 3) { return t_u8(st); }   // str
        return t_i64(st);
    }
    return t_i64(st);
}


// ================================================================== //
// THE EMITTERS (rung 1: the hello subset, held byte-exact to ncc's
// output). Emission runs only when the check phase ends clean, walks
// the same tables and trees, and re-infers types with cinfer — ncc
// interleaves checking and emission in one pass; gen.n runs them as
// two, over identical state. st[57] = ncc's IID (per-function interp
// counter); an interp node parks its id in slot 7 (exprs never chain).

fn eind(d: i64) {
    mut i := 0;
    while i < d { put("    "); i = i + 1; }
}

// A C string literal from a RAW N string body: decode N's escapes and
// re-encode as C's, byte for byte as ncc's emit_cstr does. N's named
// spellings are C's (\n \t \r \\ \") except the brace escapes, which
// decode to bare braces, and \' which decodes to a bare quote character
// C needs no escape for. A raw newline, tab or carriage return in the
// body is the same byte as its escape and is spelled the same way. Every
// other control or non-ASCII byte (\0 included) renders as three-digit
// octal — never \xNN, which C would run into a hex digit that follows.
fn ecstr(p: *u8, rs: i64, cnt: i64) {
    put("\"");
    mut i := rs;
    mut d := 0;
    while d < cnt {
        b := p[i] as i64;
        if b == 92 {
            e := p[i + 1] as i64;
            if e == 110 { put("\\n"); }
            if e == 116 { put("\\t"); }
            if e == 114 { put("\\r"); }
            if e == 48 { put("\\000"); }
            if e == 92 { put("\\\\"); }
            if e == 34 { put("\\\""); }
            if e == 39 { put("'"); }
            if e == 123 { put("\{"); }
            if e == 125 { put("\}"); }
            i = i + 2;
        }
        if b != 92 {
            if b == 10 { put("\\n"); }
            if b == 9 { put("\\t"); }
            if b == 13 { put("\\r"); }
            if b >= 32 && b <= 126 { put_span(p, i, 1); }
            if (b < 32 && b != 10 && b != 9 && b != 13) || b > 126 {
                put("\\{b / 64}{(b / 8) % 8}{b % 8}");
            }
            i = i + 1;
        }
        d = d + 1;
    }
    put("\"");
}

// ncc's base_ctype: the primitive map; user types pass through.
fn ebase(p: *u8, st: *i64, t: T) {
    l := t.l;
    s := t.s;
    if l == 2 && eq2(p, s, 105, 56) { put("nyx_i8"); return; }
    if l == 2 && eq2(p, s, 117, 56) { put("nyx_u8"); return; }
    if l == 3 && eq3(p, s, 105, 49, 54) { put("nyx_i16"); return; }
    if l == 3 && eq3(p, s, 117, 49, 54) { put("nyx_u16"); return; }
    if l == 3 && eq3(p, s, 105, 51, 50) { put("nyx_i32"); return; }
    if l == 3 && eq3(p, s, 117, 51, 50) { put("nyx_u32"); return; }
    if l == 3 && eq3(p, s, 105, 54, 52) { put("nyx_i64"); return; }
    if l == 3 && eq3(p, s, 117, 54, 52) { put("nyx_u64"); return; }
    if l == 5 && eq5(p, s, 105, 115, 105, 122, 101) { put("nyx_isize"); return; }
    if l == 5 && eq5(p, s, 117, 115, 105, 122, 101) { put("nyx_usize"); return; }
    if l == 4 && eq4(p, s, 97, 100, 100, 114) { put("nyx_addr"); return; }
    if l == 4 && eq4(p, s, 98, 111, 111, 108) { put("nyx_bool"); return; }
    if l == 3 && eq3(p, s, 115, 116, 114) { put("nyx_str"); return; }
    if l == 5 && eq5(p, s, 110, 101, 118, 101, 114) { put("void"); return; }
    if l == 4 && eq4(p, s, 118, 111, 105, 100) { put("void"); return; }
    if l == 9 && span_eq(p, s, l, st[44] + 28, 9) { put("nyx_i64"); return; }
    put_span(p, s, l);
}

fn ety(p: *u8, st: *i64, t: T) {
    if t.l == 0 { put("void"); return; }
    fi := fnty_of(p, st, t);               // v0.24: a fn type reads as its
    if fi >= 0 { put("__nyx_fn{fi}"); return; }   // typedef name
    ebase(p, st, t);
    mut k := 0;
    while k < t.pt { put("*"); k = k + 1; }
}

// The static-inline syscall wrappers (ncc's gen_extern_fns).
fn exfns(p: *u8, st: *i64) {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    mut i := 0;
    mut anyx := 0;
    while i < st[38] {
        if ft[i * 8 + 6] == 0 {
            anyx = 1;
            rt := frty(st, i);
            nvr := rt.l == 5 && eq5(p, rt.s, 110, 101, 118, 101, 114);
            put("static inline ");
            if nvr { put("void"); }
            if !nvr { ety(p, st, rt); }
            put(" ");
            put_span(p, ft[i * 8], ft[i * 8 + 1]);
            put("(");
            np := ft[i * 8 + 2];
            if np == 0 { put("void"); }
            mut q := 0;
            while q < np {
                if q > 0 { put(", "); }
                r := ft[i * 8 + 5] + q * 6;
                pt2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
                ety(p, st, pt2);
                put(" ");
                put_span(p, al[r], al[r + 1]);
                q = q + 1;
            }
            put(") \{\n");
            num := ft[i * 8 + 7];
            if nvr || rt.l == 0 { put("    (void)__nyx_syscall6({num}"); }
            if !nvr && rt.l > 0 {
                put("    return (");
                ety(p, st, rt);
                put(")__nyx_syscall6({num}");
            }
            mut k := 0;
            while k < 6 {
                if k < np {
                    r2 := ft[i * 8 + 5] + k * 6;
                    put(", (nyx_i64)");
                    put_span(p, al[r2], al[r2 + 1]);
                }
                if k >= np { put(", 0"); }
                k = k + 1;
            }
            put(");\n");
            if nvr { put("    for (;;) \{\}\n"); }
            put("\}\n");
        }
        i = i + 1;
    }
    if anyx == 1 { put("\n"); }
}

// One fn signature (ncc's gen_fn_sig).
fn efsig(p: *u8, st: *i64, fi: i64) {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    rt := frty(st, fi);
    nvr := rt.l == 5 && eq5(p, rt.s, 110, 101, 118, 101, 114);
    if rt.l == 0 || nvr { put("void"); }
    if rt.l > 0 && !nvr { ety(p, st, rt); }
    put(" ");
    put_span(p, ft[fi * 8], ft[fi * 8 + 1]);
    put("(");
    np := ft[fi * 8 + 2];
    ns0 := ft[fi * 8];                     // v0.23: main receives the SysV
    nl0 := ft[fi * 8 + 1];                 // frame (ncc's gen_fn_sig)
    mut ismain := 0;
    if nl0 == 4 && p[ns0] == 109 && p[ns0 + 1] == 97 && p[ns0 + 2] == 105 && p[ns0 + 3] == 110 {
        ismain = 1;
    }
    if np == 0 && ismain == 1 { put("nyx_i64 __argc, nyx_u8** __argv"); }
    if np == 0 && ismain == 0 { put("void"); }
    mut q := 0;
    while q < np {
        if q > 0 { put(", "); }
        r := ft[fi * 8 + 5] + q * 6;
        pt2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        ety(p, st, pt2);
        put(" ");
        put_span(p, al[r], al[r + 1]);
        q = q + 1;
    }
    put(")");
}

fn eprotos(p: *u8, st: *i64) {
    ft := st[37] as *i64;
    ma := st[53] as *i64;
    al := st[35] as *i64;
    mut i := 0;
    mut anyf := 0;
    while i < st[38] {
        if ft[i * 8 + 6] == 1 {
            anyf = 1;
            efsig(p, st, i);
            put(";\n");
        }
        i = i + 1;
    }
    mut mi := 0;
    while mi < st[54] {                    // method prototypes (static,
        emsig(p, st, mi);                  // self leads the params)
        put(";\n");
        mi = mi + 1;
    }
    if anyf == 1 || st[54] > 0 { put("\n"); }
}

// One method signature: static RET Type_m(Type self, params...).
fn emsig(p: *u8, st: *i64, mi: i64) {
    ma := st[53] as *i64;
    al := st[35] as *i64;
    rt := mrty(st, mi);
    nvr := rt.l == 5 && eq5(p, rt.s, 110, 101, 118, 101, 114);
    put("static ");
    if rt.l == 0 || nvr { put("void"); }
    if rt.l > 0 && !nvr { ety(p, st, rt); }
    put(" ");
    put_span(p, ma[mi * 8], ma[mi * 8 + 1]);
    put("_");
    put_span(p, ma[mi * 8 + 2], ma[mi * 8 + 3]);
    put("(");
    put_span(p, ma[mi * 8], ma[mi * 8 + 1]);
    put(" self");
    mut q := 0;
    while q < ma[mi * 8 + 4] {
        r := ma[mi * 8 + 5] + q * 6;
        pt2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        put(", ");
        ety(p, st, pt2);
        put(" ");
        put_span(p, al[r], al[r + 1]);
        q = q + 1;
    }
    put(")");
}

// One method definition: self seeded first, then the params, then the
// body (a returning tail behaves as in a function).
fn gmeth(p: *u8, st: *i64, mi: i64) {
    ma := st[53] as *i64;
    al := st[35] as *i64;
    st[40] = 0;
    st[57] = 0;                            // ncc: IID = 0 per method
    st[59] = 0;                            // ... and NDEFERS = 0
    crt := mrty(st, mi);
    st[45] = crt.pt;
    st[46] = crt.us;
    st[47] = crt.s;
    st[48] = crt.l;
    selfty := T{ pt: 0, us: 0, s: ma[mi * 8], l: ma[mi * 8 + 1] };
    vadd(st, st[44] + 24, 4, 0, selfty);   // self, the interned span
    mut q := 0;
    while q < ma[mi * 8 + 4] {
        r := ma[mi * 8 + 5] + q * 6;
        pt2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        vadd(st, al[r], al[r + 1], 0, pt2);
        q = q + 1;
    }
    emsig(p, st, mi);
    put(" ");
    gblock(p, st, ma[mi * 8 + 6], 0, 1);
    put("\n\n");
}

// A zero value for a type (ncc's emit_zero): aggregates and str get
// the C compound zero, everything else a plain 0. Dead stores only —
// the switches that follow are exhaustive.
fn ezero(p: *u8, st: *i64, t: T) {
    if t.pt == 0 && t.l > 0 {
        if span_is(p, t, st[44] + 7, 3) { put("\{0\}"); return; }
        if sfind(p, st, t.s, t.l) >= 0 { put("\{0\}"); return; }
        if efind(p, st, t.s, t.l) >= 0 { put("\{0\}"); return; }
    }
    put("0");
}

// Interpolation preludes (ncc's gen_preludes): hoisted buffer +
// nyx_str built segment by segment; children first, then the id.
fn gpre(p: *u8, st: *i64, i: i64, d: i64) {
    if i == 0 { return; }
    nd := st[33] as *i64;
    al := st[35] as *i64;
    k := nd[i * 8];
    if k == 4 {
        mut q0 := 0;
        while q0 < nd[i * 8 + 2] {
            hn := al[nd[i * 8 + 1] + q0 * 8 + 2];
            if hn > 0 { gpre(p, st, hn, d); }
            q0 = q0 + 1;
        }
        id := st[57];
        st[57] = st[57] + 1;
        nd[i * 8 + 7] = id;
        eind(d);
        put("char __b{id}[256];\n");
        eind(d);
        put("nyx_str __s{id} = __nyx_fmt_begin(__b{id}, 256);\n");
        mut q := 0;
        while q < nd[i * 8 + 2] {
            fr := nd[i * 8 + 1] + q * 8;
            hn2 := al[fr + 2];
            if hn2 > 0 {
                eind(d);
                ht := cinfer(p, st, hn2);
                fk := al[fr + 4];
                wd := al[fr + 5];
                zr := al[fr + 6];
                mut done := 0;
                if span_is(p, ht, st[44] + 7, 3) {
                    put("__nyx_fmt_str(&__s{id}, __b{id}, 256, ");
                    gexpr(p, st, hn2);
                    put(");\n");
                    done = 1;
                }
                if done == 0 && wd > 0 {   // v0.21 width/zero-pad,
                    mut ih := 0;           // decimal or hex
                    if fk > 0 { ih = 1; }
                    mut iu := 0;
                    if fk == 2 { iu = 1; }
                    put("__nyx_fmt_num(&__s{id}, __b{id}, 256, (nyx_i64)(");
                    gexpr(p, st, hn2);
                    put("), {ih}, {iu}, {wd}, {zr});\n");
                    done = 1;
                }
                if done == 0 && fk > 0 {   // v0.20 :x/:X — the bit
                    mut iu2 := 0;          // pattern crosses as u64
                    if fk == 2 { iu2 = 1; }
                    put("__nyx_fmt_hex(&__s{id}, __b{id}, 256, (nyx_u64)(");
                    gexpr(p, st, hn2);
                    put("), {iu2});\n");
                    done = 1;
                }
                if done == 0 {
                    put("__nyx_fmt_i64(&__s{id}, __b{id}, 256, (nyx_i64)(");
                    gexpr(p, st, hn2);
                    put("));\n");
                }
            }
            if hn2 == 0 && al[fr] > 0 {
                cnt := al[fr];
                eind(d);
                put("__nyx_fmt_str(&__s{id}, __b{id}, 256, (nyx_str)\{");
                ecstr(p, al[fr + 1], cnt);
                put(", {cnt}\});\n");
            }
            q = q + 1;
        }
        return;
    }
    if k == 6 {
        gpre(p, st, nd[i * 8 + 1], d);
        mut q2 := 0;
        while q2 < nd[i * 8 + 3] {
            gpre(p, st, al[nd[i * 8 + 2] + q2], d);
            q2 = q2 + 1;
        }
        return;
    }
    if k == 7 { gpre(p, st, nd[i * 8 + 1], d); return; }
    if k == 13 {
        gpre(p, st, nd[i * 8 + 1], d);
        gpre(p, st, nd[i * 8 + 2], d);
        return;
    }
    if k == 8 { gpre(p, st, nd[i * 8 + 1], d); return; }
    if k == 9 {
        gpre(p, st, nd[i * 8 + 1], d);
        gpre(p, st, nd[i * 8 + 2], d);
        return;
    }
    if k == 10 { gpre(p, st, nd[i * 8 + 1], d); return; }
}

// One expression (ncc's gen_expr, the rung-1 arms).
fn gexpr(p: *u8, st: *i64, i: i64) {
    nd := st[33] as *i64;
    al := st[35] as *i64;
    k := nd[i * 8];
    if k == 1 { v := nd[i * 8 + 1]; put("{v}"); return; }
    if k == 2 { v2 := nd[i * 8 + 1]; put("{v2}"); return; }
    if k == 3 {
        c := nd[i * 8 + 1];
        put("((nyx_str)\{");
        ecstr(p, nd[i * 8 + 2], c);
        put(", {c}\})");
        return;
    }
    if k == 4 { id := nd[i * 8 + 7]; put("__s{id}"); return; }
    if k == 5 {
        b := is_pfc(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        if b >= 0 { put("{b}"); return; }
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        return;
    }
    if k == 6 {
        cal := nd[i * 8 + 1];              // recv.m(a) -> Type_m(recv, a)
        if nd[cal * 8] == 7 {              // (static dispatch on the
            rt9 := cinfer(p, st, nd[cal * 8 + 1]);     // receiver's type)
            if rt9.pt == 0 && rt9.l > 0 {
                mi9 := mfind(p, st, rt9.s, rt9.l, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                if mi9 >= 0 {
                    put_span(p, rt9.s, rt9.l);
                    put("_");
                    put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                    put("(");
                    gexpr(p, st, nd[cal * 8 + 1]);
                    mut q9 := 0;
                    while q9 < nd[i * 8 + 3] {
                        put(", ");
                        gexpr(p, st, al[nd[i * 8 + 2] + q9]);
                        gmove(p, st, al[nd[i * 8 + 2] + q9]);
                        q9 = q9 + 1;
                    }
                    put(")");
                    return;
                }
            }
        }
        if nd[cal * 8] == 5 {              // v0.23 builtins lower to the
            ab3 := is_argb(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if ab3 == 1 {                  // runtime accessors (ncc's
                put("nyx_arg_count()");    // gen_expr order: before the
                return;                    // general call emission)
            }
            if ab3 == 2 {
                put("nyx_arg(");
                gexpr(p, st, al[nd[i * 8 + 2]]);
                put(")");
                return;
            }
        }
        gexpr(p, st, nd[i * 8 + 1]);
        put("(");
        mut q := 0;
        while q < nd[i * 8 + 3] {
            if q > 0 { put(", "); }
            gexpr(p, st, al[nd[i * 8 + 2] + q]);
            gmove(p, st, al[nd[i * 8 + 2] + q]);      // v0.17: passing
            q = q + 1;                                // consumes
        }
        put(")");
        return;
    }
    if k == 7 {
        b1 := nd[i * 8 + 1];               // Shape.Empty: a tag-only value
        if nd[b1 * 8] == 5 {               // (ncc's variant_ref arm first)
            ei := efind(p, st, nd[b1 * 8 + 5], nd[b1 * 8 + 6]);
            if ei >= 0 {
                vi := vfindx(p, st, ei, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("((");
                put_span(p, nd[b1 * 8 + 5], nd[b1 * 8 + 6]);
                put(")\{ .tag = {vi} \})");
                return;
            }
        }
        bt := cinfer(p, st, nd[i * 8 + 1]);
        isp := nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 112, 116, 114);
        if isp && span_is(p, bt, st[44] + 7, 3) {
            put("((nyx_u8*)");
            gexpr(p, st, nd[i * 8 + 1]);
            put(".ptr)");
            return;
        }
        gexpr(p, st, nd[i * 8 + 1]);
        put(".");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        return;
    }
    if k == 8 {
        op_put(nd[i * 8 + 3]);
        put("(");
        gexpr(p, st, nd[i * 8 + 1]);
        put(")");
        return;
    }
    if k == 9 {
        put("(");
        gexpr(p, st, nd[i * 8 + 1]);
        put(" ");
        op_put(nd[i * 8 + 3]);
        put(" ");
        gexpr(p, st, nd[i * 8 + 2]);
        put(")");
        return;
    }
    if k == 10 {
        put("(");
        ct := T{ pt: nd[i * 8 + 2], us: nd[i * 8 + 3], s: nd[i * 8 + 5], l: nd[i * 8 + 6] };
        ety(p, st, ct);
        put(")(");
        gexpr(p, st, nd[i * 8 + 1]);
        put(")");
        return;
    }
    if k == 11 {                           // C99 compound literal,
        put("((");                         // designated (ncc's E_SLIT)
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put(")\{");
        mut q4 := 0;
        while q4 < nd[i * 8 + 3] {
            if q4 > 0 { put(", "); }
            r4 := nd[i * 8 + 1] + q4 * 3;
            put(".");
            put_span(p, al[r4], al[r4 + 1]);
            put(" = ");
            gexpr(p, st, al[r4 + 2]);
            gmove(p, st, al[r4 + 2]);      // v0.25: an own field's source
            q4 = q4 + 1;                   // moves in (a plain path is untouched)
        }
        put("\})");
        return;
    }
    if k == 12 {                           // Shape.Circle{ r: 5 } (the
        ei2 := efind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);   // variant
        vi2 := vfindx(p, st, ei2, nd[i * 8 + 2], nd[i * 8 + 7]);
        put("((");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put(")\{ .tag = {vi2}");
        if nd[i * 8 + 3] > 0 {
            put(", .u = \{ .");
            put_span(p, nd[i * 8 + 2], nd[i * 8 + 7]);
            put(" = \{ ");
            mut q5 := 0;
            while q5 < nd[i * 8 + 3] {
                if q5 > 0 { put(", "); }
                r5 := nd[i * 8 + 1] + q5 * 3;
                put(".");
                put_span(p, al[r5], al[r5 + 1]);
                put(" = ");
                gexpr(p, st, al[r5 + 2]);
                q5 = q5 + 1;
            }
            put(" \} \}");
        }
        put(" \})");
        return;
    }
    if k == 13 {
        bt2 := cinfer(p, st, nd[i * 8 + 1]);
        if span_is(p, bt2, st[44] + 7, 3) {
            put("((nyx_u8)");
            gexpr(p, st, nd[i * 8 + 1]);
            put(".ptr[");
            gexpr(p, st, nd[i * 8 + 2]);
            put("])");
            return;
        }
        gexpr(p, st, nd[i * 8 + 1]);
        put("[");
        gexpr(p, st, nd[i * 8 + 2]);
        put("]");
        return;
    }
}

// The `?` lowering (ncc's gen_try): the operand lands in __tN once;
// on Err the function returns at once — the same value when operand
// and return enums are identical, otherwise the Err payload rewrapped
// through __eN — with defers and ownership cleanup before return; on Ok the
// statement binds or assigns the payload, or discards it (`e?;`).
// form: 1 = let, 2 = assign, 0 = expression statement.
fn gtry(p: *u8, st: *i64, i: i64, d: i64, form: i64) {
    nd := st[33] as *i64;
    al := st[35] as *i64;
    ea := st[51] as *i64;
    mut e := nd[i * 8 + 1];
    if form == 2 { e = nd[i * 8 + 2]; }
    ot := cinfer(p, st, e);
    oe := efind(p, st, ot.s, ot.l);
    re := efind(p, st, st[47], st[48]);
    same := span_eq(p, ea[oe * 4], ea[oe * 4 + 1], ea[re * 4], ea[re * 4 + 1]);
    erv := vfindx(p, st, oe, st[44] + 21, 3);
    erv2 := vfindx(p, st, re, st[44] + 21, 3);
    okv := vfindx(p, st, oe, st[44] + 19, 2);
    ovb := ea[oe * 4 + 3];
    rvb := ea[re * 4 + 3];
    okr := al[ovb + okv * 4 + 3];          // the Ok payload's field rec
    mut okty := t_void();
    if al[ovb + okv * 4 + 2] == 1 {
        okty = T{ pt: al[okr + 2], us: al[okr + 3], s: al[okr + 4], l: al[okr + 5] };
    }
    tid := st[57];
    st[57] = st[57] + 1;
    if form == 1 {                         // zero init: dead store — the
        eind(d);                           // Err branch always returns
        ety(p, st, okty);
        put(" __ok{tid} = ");
        ezero(p, st, okty);
        put(";\n");
    }
    eind(d);
    put("\{\n");
    gpre(p, st, e, d + 1);
    eind(d + 1);
    put_span(p, ea[oe * 4], ea[oe * 4 + 1]);
    put(" __t{tid} = ");
    gexpr(p, st, e);
    put(";\n");
    eind(d + 1);
    put("if (__t{tid}.tag == {erv}) \{\n");
    if same {
        gtry_cleanup(p, st, d + 2);
        eind(d + 2);
        put("return __t{tid};\n");
    }
    if !same {
        eind(d + 2);
        put_span(p, ea[re * 4], ea[re * 4 + 1]);
        put(" __e{tid} = \{0\};\n");
        eind(d + 2);
        put("__e{tid}.tag = {erv2};\n");
        if al[rvb + erv2 * 4 + 2] == 1 {   // the Err payload crosses by
            orr := al[ovb + erv * 4 + 3];  // field name on each side
            rrr := al[rvb + erv2 * 4 + 3];
            eind(d + 2);
            put("__e{tid}.u.Err.");
            put_span(p, al[rrr], al[rrr + 1]);
            put(" = __t{tid}.u.Err.");
            put_span(p, al[orr], al[orr + 1]);
            put(";\n");
        }
        gtry_cleanup(p, st, d + 2);
        eind(d + 2);
        put("return __e{tid};\n");
    }
    eind(d + 1);
    put("\}\n");
    if form == 1 {
        eind(d + 1);
        put("__ok{tid} = __t{tid}.u.Ok.");
        put_span(p, al[okr], al[okr + 1]);
        put(";\n");
    }
    if form == 2 {
        eind(d + 1);
        gexpr(p, st, nd[i * 8 + 1]);
        if nd[i * 8 + 3] == 0 { put(" = "); }
        if nd[i * 8 + 3] == 1 { put(" += "); }
        if nd[i * 8 + 3] == 2 { put(" -= "); }
        put("__t{tid}.u.Ok.");
        put_span(p, al[okr], al[okr + 1]);
        put(";\n");
    }
    eind(d);
    put("\}\n");
    if form == 1 {
        // Delay the source name until after Err cleanup so an outer
        // owner with that name remains visible to its destructor.
        eind(d);
        ety(p, st, okty);
        put(" ");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put(" = __ok{tid};\n");
        vadd(st, nd[i * 8 + 5], nd[i * 8 + 6], nd[i * 8 + 3], okty);
    }
}

// The emit walk's move point: state only, never a diagnostic — the
// check phase already proved every consume legal, so this simply
// mirrors own_move_expr's transfer (LIVE or HELD becomes MOVED).
fn gmove(p: *u8, st: *i64, i: i64) {
    if i == 0 { return; }
    nd := st[33] as *i64;
    if nd[i * 8] != 5 { return; }
    v := vfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
    if v < 0 { return; }
    va := st[39] as *i64;
    if va[v * 10 + 8] != 0 { va[v * 10 + 8] = 2; }
}

// The moves an expression makes INSIDE itself — a call's arguments, a
// struct literal's own-field sources — marked before the pending-drop
// judgement of a tail or a return value, in ncc's order: check_expr
// walks the whole expression first, then own_drops_pending decides the
// braced __ret form. gexpr marks the same moves again while emitting;
// gmove is idempotent, so that second pass changes nothing.
fn gpremark(p: *u8, st: *i64, i: i64) {
    if i == 0 { return; }
    nd := st[33] as *i64;
    al := st[35] as *i64;
    k := nd[i * 8];
    if k == 4 {                            // interpolation: every hole
        mut q0 := 0;
        while q0 < nd[i * 8 + 2] {
            gpremark(p, st, al[nd[i * 8 + 1] + q0 * 8 + 2]);
            q0 = q0 + 1;
        }
        return;
    }
    if k == 6 {                            // call: the callee (a method's
        gpremark(p, st, nd[i * 8 + 1]);    // receiver inside it), then
        mut q := 0;                        // every argument moves
        while q < nd[i * 8 + 3] {
            gpremark(p, st, al[nd[i * 8 + 2] + q]);
            gmove(p, st, al[nd[i * 8 + 2] + q]);
            q = q + 1;
        }
        return;
    }
    if k == 7 || k == 8 || k == 10 {
        gpremark(p, st, nd[i * 8 + 1]);
        return;
    }
    if k == 9 || k == 13 {
        gpremark(p, st, nd[i * 8 + 1]);
        gpremark(p, st, nd[i * 8 + 2]);
        return;
    }
    if k == 11 {                           // struct literal: an own field's
        mut q4 := 0;                       // source moves in
        while q4 < nd[i * 8 + 3] {
            r4 := nd[i * 8 + 1] + q4 * 3;
            gpremark(p, st, al[r4 + 2]);
            gmove(p, st, al[r4 + 2]);
            q4 = q4 + 1;
        }
        return;
    }
    if k == 12 {                           // variant literal: payload sources
        mut q5 := 0;
        while q5 < nd[i * 8 + 3] {
            r5 := nd[i * 8 + 1] + q5 * 3;
            gpremark(p, st, al[r5 + 2]);
            q5 = q5 + 1;
        }
    }
}

// v0.25: the value path a field drop names — `name.field.field`, a
// stack of spans in st[70], st[71] deep (the root binding first).
fn gpath(p: *u8, st: *i64) {
    ps := st[70] as *i64;
    mut k := 0;
    while k < st[71] {
        if k > 0 { put("."); }
        put_span(p, ps[k * 2], ps[k * 2 + 1]);
        k = k + 1;
    }
}

// v0.25: the field drops of the own container struct si at the path on
// the stack (ncc's own_field_drops_emit): REVERSE declaration order,
// each through its type's #[drop] — a field that is itself a container
// without one drops through ITS fields.
fn gfdrops(p: *u8, st: *i64, si: i64, d: i64) {
    sa := st[49] as *i64;
    al := st[35] as *i64;
    ps := st[70] as *i64;
    mut q := sa[si * 8 + 2] - 1;
    while q >= 0 {
        ft := sfty(st, si, q);
        if tyown(p, st, ft) {
            r := sa[si * 8 + 3] + q * 6;
            k := st[71];
            ps[k * 2] = al[r];
            ps[k * 2 + 1] = al[r + 1];
            st[71] = k + 1;
            fsi := sfind(p, st, ft.s, ft.l);
            if sa[fsi * 8 + 6] > 0 {
                eind(d);
                put_span(p, sa[fsi * 8 + 5], sa[fsi * 8 + 6]);
                put("(");
                gpath(p, st);
                put(");\n");
            }
            if sa[fsi * 8 + 6] == 0 { gfdrops(p, st, fsi, d); }
            st[71] = k;
        }
        q = q - 1;
    }
}

// v0.25 (ncc's own_held_drops_emit): every HELD own container ending
// its body here drops its own fields; its own destructor never re-runs
// (the sink rule). The check phase already refused a field that cannot
// drop. Function exits only — never an inner block's end.
fn gheld(p: *u8, st: *i64, d: i64) {
    va := st[39] as *i64;
    ps := st[70] as *i64;
    mut j := 0;
    while j < st[40] {
        if va[j * 10 + 8] == 3 {
            t := vty(st, j);
            if t.pt == 0 && t.l > 0 {
                si := sfind(p, st, t.s, t.l);
                if si >= 0 {
                    ps[0] = va[j * 10];
                    ps[1] = va[j * 10 + 1];
                    st[71] = 1;
                    gfdrops(p, st, si, d);
                    st[71] = 0;
                }
            }
        }
        j = j + 1;
    }
}

// v0.25 (ncc's own_held_pending): does a held container with an own
// field wait on its field drops at this function exit?
fn gheldpend(p: *u8, st: *i64) -> i64 {
    va := st[39] as *i64;
    sa := st[49] as *i64;
    mut j := 0;
    while j < st[40] {
        if va[j * 10 + 8] == 3 {
            t := vty(st, j);
            if t.pt == 0 && t.l > 0 {
                si := sfind(p, st, t.s, t.l);
                if si >= 0 {
                    mut q := 0;
                    while q < sa[si * 8 + 2] {
                        if tyown(p, st, sfty(st, si, q)) { return 1; }
                        q = q + 1;
                    }
                }
            }
        }
        j = j + 1;
    }
    return 0;
}

// Is any live binding waiting on an auto-drop? (ncc's
// own_drops_pending — decides whether an exit needs the braced form.)
// A function exit (from == 0) also counts a held container's field
// drops (v0.25).
fn gpend(p: *u8, st: *i64, from: i64) -> i64 {
    va := st[39] as *i64;
    mut j := from;
    while j < st[40] {
        if va[j * 10 + 8] == 1 {
            if hasdrop(p, st, vty(st, j)) { return 1; }
        }
        j = j + 1;
    }
    if from == 0 { return gheldpend(p, st); }
    return 0;
}

// The auto-drop calls (ncc's own_drops_emit): every LIVE binding at
// index >= from whose type carries a #[drop] destructor gets the call
// emitted — reverse birth order, mirroring defer's LIFO — and becomes
// MOVED, so a later drain never drops it twice. v0.25: a live own
// container without a #[drop] of its own drops through its fields.
fn gdrops(p: *u8, st: *i64, from: i64, d: i64) {
    va := st[39] as *i64;
    sa := st[49] as *i64;
    ps := st[70] as *i64;
    mut j := st[40] - 1;
    while j >= from {
        if va[j * 10 + 8] == 1 {
            t := vty(st, j);
            if t.pt == 0 && t.l > 0 {
                si := sfind(p, st, t.s, t.l);
                if si >= 0 && sa[si * 8 + 4] == 1 && sa[si * 8 + 6] > 0 {
                    eind(d);
                    put_span(p, sa[si * 8 + 5], sa[si * 8 + 6]);
                    put("(");
                    put_span(p, va[j * 10], va[j * 10 + 1]);
                    put(");\n");
                    va[j * 10 + 8] = 2;
                }
                if si >= 0 && sa[si * 8 + 4] == 1 && sa[si * 8 + 6] == 0 && hasdrop(p, st, t) {
                    ps[0] = va[j * 10];
                    ps[1] = va[j * 10 + 1];
                    st[71] = 1;
                    gfdrops(p, st, si, d);
                    st[71] = 0;
                    va[j * 10 + 8] = 2;
                }
            }
        }
        j = j - 1;
    }
}

// ncc's gen_try_cleanup: preserve the post-operand state for Ok while
// emitting Err's normal return cleanup (the check pass proved no leak).
#[caps(syscall)]
fn gtry_cleanup(p: *u8, st: *i64, d: i64) {
    va := st[39] as *i64;
    states := arena_alloc((st[40] + 1) * 8) as *i64;
    mut j := 0;
    while j < st[40] { states[j] = va[j * 10 + 8]; j = j + 1; }
    gdefs(p, st, d);
    gdrops(p, st, 0, d);
    gheld(p, st, d);
    j = 0;
    while j < st[40] { va[j * 10 + 8] = states[j]; j = j + 1; }
}

// Deferred expressions, LIFO (ncc's gen_defers). The preludes run
// at EMISSION time, so an interpolation inside a defer numbers its
// temporaries at every exit it is emitted at — exactly ncc's
// interleaving.
fn gdefs(p: *u8, st: *i64, d: i64) {
    da := st[58] as *i64;
    mut i := st[59] - 1;
    while i >= 0 {
        gpre(p, st, da[i], d);
        eind(d);
        gexpr(p, st, da[i]);
        put(";\n");
        i = i - 1;
    }
}

// One statement (ncc's gen_stmt, the rung-1 arms).
#[caps(syscall)]
fn gstmt(p: *u8, st: *i64, i: i64, d: i64) {
    nd := st[33] as *i64;
    k := nd[i * 8];
    if k == 20 && nd[i * 8 + 2] == 1 { gtry(p, st, i, d, 1); return; }
    if k == 21 && nd[i * 8 + 5] == 1 { gtry(p, st, i, d, 2); return; }
    if k == 23 && nd[i * 8 + 3] == 1 { gtry(p, st, i, d, 0); return; }
    if k == 20 {
        gpre(p, st, nd[i * 8 + 1], d);
        rt := cinfer(p, st, nd[i * 8 + 1]);
        eind(d);
        ety(p, st, rt);
        put(" ");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put(" = ");
        gexpr(p, st, nd[i * 8 + 1]);
        put(";\n");
        gmove(p, st, nd[i * 8 + 1]);       // the init consumes its source
        vadd(st, nd[i * 8 + 5], nd[i * 8 + 6], nd[i * 8 + 3], rt);
        if tyown(p, st, rt) {              // birth: LIVE until consumed
            va6 := st[39] as *i64;         // or auto-dropped
            va6[(st[40] - 1) * 10 + 8] = 1;
        }
        return;
    }
    if k == 21 {
        gpre(p, st, nd[i * 8 + 2], d);
        eind(d);
        gexpr(p, st, nd[i * 8 + 1]);
        if nd[i * 8 + 3] == 0 { put(" = "); }
        if nd[i * 8 + 3] == 1 { put(" += "); }
        if nd[i * 8 + 3] == 2 { put(" -= "); }
        gexpr(p, st, nd[i * 8 + 2]);
        put(";\n");
        gmove(p, st, nd[i * 8 + 2]);       // the assignment consumes
        return;
    }
    if k == 28 {                           // defer: register only — the
        da := st[58] as *i64;              // expression emits at exits
        da[st[59]] = nd[i * 8 + 1];
        st[59] = st[59] + 1;
        return;
    }
    if k == 22 {
        gpremark(p, st, nd[i * 8 + 1]);    // the moves inside the value first
        gmove(p, st, nd[i * 8 + 1]);       // (ncc: check_expr), then
        pnd := gpend(p, st, 0);            // returning consumes — a
                                           // returned own must not drop
        if (st[59] > 0 || pnd == 1) && nd[i * 8 + 1] > 0 {
            eind(d);                       // braced: the value computes
            put("\{\n");                   // BEFORE the defers run, and
            gpre(p, st, nd[i * 8 + 1], d + 1);  // the drops run after
            eind(d + 1);                   // the defers (v0.19 keeps
            rt8 := cinfer(p, st, nd[i * 8 + 1]);   // defer's timing)
            ety(p, st, rt8);
            put(" __ret = ");
            gexpr(p, st, nd[i * 8 + 1]);
            put(";\n");
            gdefs(p, st, d + 1);
            gdrops(p, st, 0, d + 1);
            gheld(p, st, d + 1);           // v0.25: a held container's fields
            eind(d + 1);
            put("return __ret;\n");
            eind(d);
            put("\}\n");
            return;
        }
        if st[59] > 0 || pnd == 1 {        // void return with defers
            gdefs(p, st, d);               // and/or pending drops
            gdrops(p, st, 0, d);
            gheld(p, st, d);               // v0.25
            eind(d);
            put("return;\n");
            return;
        }
        gpre(p, st, nd[i * 8 + 1], d);
        eind(d);
        if nd[i * 8 + 1] > 0 {
            put("return ");
            gexpr(p, st, nd[i * 8 + 1]);
            put(";\n");
        }
        if nd[i * 8 + 1] == 0 { put("return;\n"); }
        return;
    }
    if k == 23 {
        gpre(p, st, nd[i * 8 + 1], d);
        eind(d);
        gexpr(p, st, nd[i * 8 + 1]);
        put(";\n");
        return;
    }
    if k == 26 { eind(d); put("break;\n"); return; }
    if k == 27 { eind(d); put("continue;\n"); return; }
    if k == 24 {
        gpre(p, st, nd[i * 8 + 1], d);
        eind(d);
        put("while (");
        gexpr(p, st, nd[i * 8 + 1]);
        put(") ");
        gblock(p, st, nd[i * 8 + 2], d, 0);
        put("\n");
        return;
    }
    if k == 25 {                           // if / else — the emit walk
        gpre(p, st, nd[i * 8 + 1], d);     // replays the checker's v0.18
        n0 := st[40];                      // branch-aware states (each
        sb := arena_alloc((n0 * 2 + 1) * 8) as *i64;   // arm from pre-if;
        va7 := st[39] as *i64;             // a returning arm never
        mut j := 0;                        // reaches the merge)
        while j < n0 {
            sb[j] = va7[j * 10 + 8];
            j = j + 1;
        }
        eind(d);
        put("if (");
        gexpr(p, st, nd[i * 8 + 1]);
        put(") ");
        gblock(p, st, nd[i * 8 + 2], d, 0);
        mut j2 := 0;
        while j2 < n0 {
            sb[n0 + j2] = va7[j2 * 10 + 8];
            va7[j2 * 10 + 8] = sb[j2];
            j2 = j2 + 1;
        }
        els := nd[i * 8 + 3];
        mut er := 0;
        if els > 0 && nd[els * 8] == 40 {
            put(" else ");
            gblock(p, st, els, d, 0);
            er = brret(st, els);
        }
        if els > 0 && nd[els * 8] == 25 {  // else-if: ncc's parser wraps
            put(" else \{\n");             // the chained if in a BLOCK,
            gstmt(p, st, els, d + 1);      // so the emitter synthesizes
            eind(d);                       // those braces
            put("\}");
        }
        tr := brret(st, nd[i * 8 + 2]);
        mut j3 := 0;
        while j3 < n0 {                    // the merge, states only: a
            tv := sb[n0 + j3];             // returning arm's exit never
            if tr == 1 && er == 1 { va7[j3 * 10 + 8] = tv; }   // flows on
            if tr == 0 && er == 1 { va7[j3 * 10 + 8] = tv; }
            j3 = j3 + 1;
        }
        put("\n");
        return;
    }
    if k == 30 {                           // counted for: both bounds
        fid := st[57];                     // hoisted, evaluated once
        st[57] = st[57] + 1;               // (ncc takes the id FIRST —
        eind(d);                           // preludes inside the bounds
        put("\{\n");                       // number after it)
        gpre(p, st, nd[i * 8 + 1], d + 1);
        gpre(p, st, nd[i * 8 + 2], d + 1);
        eind(d + 1);
        put("nyx_i64 __fs{fid} = ");
        gexpr(p, st, nd[i * 8 + 1]);
        put(";\n");
        eind(d + 1);
        put("nyx_i64 __fe{fid} = ");
        gexpr(p, st, nd[i * 8 + 2]);
        put(";\n");
        eind(d + 1);
        put("for (nyx_i64 ");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put(" = __fs{fid}; ");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put(" < __fe{fid}; ");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put("++) ");
        vsave2 := st[40];
        vadd(st, nd[i * 8 + 5], nd[i * 8 + 6], 0, t_i64(st));
        gblock(p, st, nd[i * 8 + 3], d + 1, 0);
        st[40] = vsave2;
        put("\n");
        eind(d);
        put("\}\n");
        return;
    }
    if k == 29 {                           // match: subject once into a
        al := st[35] as *i64;              // temp, switch on the tag,
        ea := st[51] as *i64;              // binds become typed locals
        mid := st[57];
        st[57] = st[57] + 1;
        sty := cinfer(p, st, nd[i * 8 + 1]);
        ei := efind(p, st, sty.s, sty.l);
        hd := nd[i * 8 + 2];
        na := nd[i * 8 + 3];
        armb := al[hd + 6];
        vbase := ea[ei * 4 + 3];
        mt := al[hd];
        if mt == 0 {                       // the statement form
            eind(d);
            put("\{\n");
            gpre(p, st, nd[i * 8 + 1], d + 1);
            eind(d + 1);
            put_span(p, ea[ei * 4], ea[ei * 4 + 1]);
            put(" __m{mid} = ");
            gexpr(p, st, nd[i * 8 + 1]);
            put(";\n");
            eind(d + 1);
            put("switch (__m{mid}.tag) \{\n");
            mut a := 0;
            while a < na {
                vi := vfindx(p, st, ei, al[armb + a * 6], al[armb + a * 6 + 1]);
                eind(d + 1);
                put("case {vi}: \{\n");
                vsave := st[40];
                fst := al[vbase + vi * 4 + 3];
                bst := al[armb + a * 6 + 3];
                mut b := 0;
                while b < al[armb + a * 6 + 2] {
                    r := fst + b * 6;
                    bt := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
                    eind(d + 2);
                    ety(p, st, bt);
                    put(" ");
                    put_span(p, al[bst + b * 2], al[bst + b * 2 + 1]);
                    put(" = __m{mid}.u.");
                    put_span(p, al[armb + a * 6], al[armb + a * 6 + 1]);
                    put(".");
                    put_span(p, al[r], al[r + 1]);
                    put(";\n");
                    vadd(st, al[bst + b * 2], al[bst + b * 2 + 1], 0, bt);
                    b = b + 1;
                }
                eind(d + 2);
                gblock(p, st, al[armb + a * 6 + 4], d + 2, 0);
                put("\n");
                eind(d + 2);
                put("break;\n");
                eind(d + 1);
                put("\}\n");
                st[40] = vsave;
                a = a + 1;
            }
            eind(d + 1);
            put("\}\n");
            eind(d);
            put("\}\n");
            return;
        }
        vs0 := st[40];                     // the expression forms: infer
        vi0 := vfindx(p, st, ei, al[armb], al[armb + 1]);   // res from
        mseed(p, st, ei, vi0, al[armb + 3], al[armb + 2]);  // arm 0 with
        mut res := cinfer(p, st, al[armb + 4]);             // its binds
        st[40] = vs0;
        mut rty := res;
        if mt == 3 { rty = T{ pt: st[45], us: st[46], s: st[47], l: st[48] }; }
        if mt == 1 {                       // x := match: the zero-init
            eind(d);                       // dead store (the Err... the
            ety(p, st, res);               // switch is exhaustive)
            put(" ");
            put_span(p, al[hd + 3], al[hd + 4]);
            put(" = ");
            ezero(p, st, res);
            put(";\n");
        }
        eind(d);
        put("\{\n");
        gpre(p, st, nd[i * 8 + 1], d + 1);
        eind(d + 1);
        put_span(p, ea[ei * 4], ea[ei * 4 + 1]);
        put(" __m{mid} = ");
        gexpr(p, st, nd[i * 8 + 1]);
        put(";\n");
        eind(d + 1);
        ety(p, st, rty);
        put(" __mres{mid} = ");
        ezero(p, st, rty);
        put(";\n");
        eind(d + 1);
        put("switch (__m{mid}.tag) \{\n");
        mut a2 := 0;
        while a2 < na {
            vi2 := vfindx(p, st, ei, al[armb + a2 * 6], al[armb + a2 * 6 + 1]);
            eind(d + 1);
            put("case {vi2}: \{\n");
            vsave3 := st[40];
            fst2 := al[vbase + vi2 * 4 + 3];
            bst2 := al[armb + a2 * 6 + 3];
            mut b2 := 0;
            while b2 < al[armb + a2 * 6 + 2] {
                r2 := fst2 + b2 * 6;
                bt2 := T{ pt: al[r2 + 2], us: al[r2 + 3], s: al[r2 + 4], l: al[r2 + 5] };
                eind(d + 2);
                ety(p, st, bt2);
                put(" ");
                put_span(p, al[bst2 + b2 * 2], al[bst2 + b2 * 2 + 1]);
                put(" = __m{mid}.u.");
                put_span(p, al[armb + a2 * 6], al[armb + a2 * 6 + 1]);
                put(".");
                put_span(p, al[r2], al[r2 + 1]);
                put(";\n");
                vadd(st, al[bst2 + b2 * 2], al[bst2 + b2 * 2 + 1], 0, bt2);
                b2 = b2 + 1;
            }
            gpre(p, st, al[armb + a2 * 6 + 4], d + 2);
            eind(d + 2);
            put("__mres{mid} = ");
            gexpr(p, st, al[armb + a2 * 6 + 4]);
            put(";\n");
            eind(d + 2);
            put("break;\n");
            eind(d + 1);
            put("\}\n");
            st[40] = vsave3;
            a2 = a2 + 1;
        }
        eind(d + 1);
        put("\}\n");
        if mt == 1 {
            eind(d + 1);
            put_span(p, al[hd + 3], al[hd + 4]);
            put(" = __mres{mid};\n");
        }
        if mt == 2 {                       // lhs = match (S_ASSIGN's shape)
            eind(d + 1);
            gexpr(p, st, al[hd + 1]);
            if al[hd + 2] == 1 { put(" = "); }
            if al[hd + 2] == 2 { put(" += "); }
            if al[hd + 2] == 3 { put(" -= "); }
            put("__mres{mid};\n");
        }
        if mt == 3 {                       // return match: the value is
            eind(d + 1);                   // computed before any defers
            put("return __mres{mid};\n");  // (none registered yet —
        }                                  // defer emission is rung 4)
        eind(d);
        put("\}\n");
        if mt == 1 {
            vadd(st, al[hd + 3], al[hd + 4], al[hd + 5], res);
        }
        return;
    }
}

// One block (ncc's gen_block, the rung-1 shape: no defers/drops yet).
fn gblock(p: *u8, st: *i64, b: i64, d: i64, ftail: i64) {
    nd := st[33] as *i64;
    vsave := st[40];
    put("\{\n");
    if st[60] == 1 {
        st[60] = 0;
        put("    __nyx_args_set(__argc, __argv);\n");
    }
    mut s := nd[b * 8 + 1];
    while s > 0 {
        gstmt(p, st, s, d + 1);
        s = nd[s * 8 + 7];
    }
    t := nd[b * 8 + 2];
    mut tailret := 0;                      // v0.25: a returning tail drained
    if t > 0 {                             // the held drops
        rt := T{ pt: st[45], us: st[46], s: st[47], l: st[48] };
        nvr := rt.l == 5 && eq5(p, rt.s, 110, 101, 118, 101, 114);
        mut rets := 0;
        if ftail == 1 && rt.l > 0 && !nvr { rets = 1; }
        gpremark(p, st, t);                // ncc: check_expr(tail) — the
        gmove(p, st, t);                   // moves inside it, then the
        pnd2 := gpend(p, st, 0);           // tail consumes, at line 0 —
        if rets == 1 && (st[59] > 0 || pnd2 == 1) {   // BEFORE pending is judged
            gpre(p, st, t, d + 1);         // tail value, then defers,
            eind(d + 1);                   // then drops, then return
            tt := cinfer(p, st, t);        // (the block's own braces
            ety(p, st, tt);                // serve)
            put(" __ret = ");
            gexpr(p, st, t);
            put(";\n");
            gdefs(p, st, d + 1);
            gdrops(p, st, 0, d + 1);
            gheld(p, st, d + 1);           // v0.25
            tailret = 1;
            eind(d + 1);
            put("return __ret;\n");
        }
        if rets == 1 && st[59] == 0 && pnd2 == 0 {
            gpre(p, st, t, d + 1);
            eind(d + 1);
            put("return ");
            gexpr(p, st, t);
            put(";\n");
        }
        if rets == 0 {
            gpre(p, st, t, d + 1);
            eind(d + 1);
            gexpr(p, st, t);
            put(";\n");
            if ftail == 1 && st[59] > 0 { gdefs(p, st, d + 1); }
        }
    }
    if t == 0 && ftail == 1 && st[59] > 0 {
        rt2 := T{ pt: st[45], us: st[46], s: st[47], l: st[48] };
        nvr2 := rt2.l == 5 && eq5(p, rt2.s, 110, 101, 118, 101, 114);
        if rt2.l == 0 || nvr2 { gdefs(p, st, d + 1); }   // void fall-off
    }
    mut fr0 := vsave;                      // v0.19 auto-drops close the
    if ftail == 1 { fr0 = 0; }             // scope: the whole frame at a
    gdrops(p, st, fr0, d + 1);             // function end, this block's
    if ftail == 1 && tailret == 0 {        // own births otherwise; v0.25:
        gheld(p, st, d + 1);               // a held container's fields
    }                                      // (unless the tail returned)
    eind(d);
    put("\}");
    st[40] = vsave;
}

// One function definition: seed the params, then signature + body.
fn gfn(p: *u8, st: *i64, fi: i64) {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    st[40] = 0;
    st[57] = 0;                            // ncc: IID = 0 per function
    st[59] = 0;                            // ... and NDEFERS = 0
    crt := frty(st, fi);
    st[45] = crt.pt;
    st[46] = crt.us;
    st[47] = crt.s;
    st[48] = crt.l;
    mut q := 0;
    while q < ft[fi * 8 + 2] {
        r := ft[fi * 8 + 5] + q * 6;
        pt2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        vadd(st, al[r], al[r + 1], 0, pt2);
        if tyown(p, st, pt2) {             // the emit walk replays the
            vh := st[39] as *i64;          // ownership states: params
            vh[(st[40] - 1) * 10 + 8] = 3; // arrive HELD
        }
        q = q + 1;
    }
    ns1 := ft[fi * 8];
    nl1 := ft[fi * 8 + 1];
    st[60] = 0;
    if nl1 == 4 && ft[fi * 8 + 2] == 0 && p[ns1] == 109 && p[ns1 + 1] == 97 && p[ns1 + 2] == 105 && p[ns1 + 3] == 110 {
        st[60] = 1;                        // v0.23: main's first act is the
    }                                      // args stash (ncc's STASH_ARGS)
    efsig(p, st, fi);
    put(" ");
    gblock(p, st, ft[fi * 8 + 4], 0, 1);
    put("\n\n");
}

// One struct's layout (ncc: a C-layout typedef, fields in order).
fn estruct(p: *u8, st: *i64, i: i64) {
    sa := st[49] as *i64;
    al := st[35] as *i64;
    put("typedef struct \{\n");
    mut q := 0;
    while q < sa[i * 8 + 2] {
        r := sa[i * 8 + 3] + q * 6;
        t := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        put("    ");
        fi := fnty_of(p, st, t);
        if fi >= 0 {                       // v0.24: a fn field, as a
            efndecl(p, st, fi, al[r], al[r + 1]);   // declarator
            put(";\n");
            q = q + 1;
            continue;
        }
        ety(p, st, t);
        put(" ");
        put_span(p, al[r], al[r + 1]);
        put(";\n");
        q = q + 1;
    }
    put("\} ");
    put_span(p, sa[i * 8], sa[i * 8 + 1]);
    put(";\n\n");
}

// One enum's layout (ncc: a tagged union — int tag + a union of payload
// structs; an empty union is not valid C, so payload-less enums get
// the tag alone. The tag comment names every variant's number).
fn eenum(p: *u8, st: *i64, i: i64) {
    ea := st[51] as *i64;
    al := st[35] as *i64;
    nv := ea[i * 4 + 2];
    vb := ea[i * 4 + 3];
    mut hasp := 0;
    mut v := 0;
    while v < nv {
        if al[vb + v * 4 + 2] > 0 { hasp = 1; }
        v = v + 1;
    }
    put("typedef struct \{\n    int tag;    /*");
    mut v2 := 0;
    while v2 < nv {
        put(" {v2}=");
        put_span(p, al[vb + v2 * 4], al[vb + v2 * 4 + 1]);
        v2 = v2 + 1;
    }
    put(" */\n");
    if hasp == 1 {
        put("    union \{\n");
        mut v3 := 0;
        while v3 < nv {
            if al[vb + v3 * 4 + 2] > 0 {
                put("        struct \{ ");
                mut q := 0;
                while q < al[vb + v3 * 4 + 2] {
                    r := al[vb + v3 * 4 + 3] + q * 6;
                    t := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
                    ety(p, st, t);
                    put(" ");
                    put_span(p, al[r], al[r + 1]);
                    put("; ");
                    q = q + 1;
                }
                put("\} ");
                put_span(p, al[vb + v3 * 4], al[vb + v3 * 4 + 1]);
                put(";\n");
            }
            v3 = v3 + 1;
        }
        put("    \} u;\n");
    }
    put("\} ");
    put_span(p, ea[i * 4], ea[i * 4 + 1]);
    put(";\n\n");
}

// Type layouts in declaration order (v0.24, ncc's merged walk): a struct
// may hold an enum by value when the enum is declared first, as C
// requires. Both tables are in source order and a record's name span
// starts where it was declared, so the spans order the merge.
fn elayouts(p: *u8, st: *i64) {
    sa := st[49] as *i64;
    ea := st[51] as *i64;
    mut si := 0;
    mut ei := 0;
    while si < st[50] || ei < st[52] {
        if ei >= st[52] || (si < st[50] && sa[si * 8] < ea[ei * 4]) {
            estruct(p, st, si);
            si = si + 1;
        } else {
            eenum(p, st, ei);
            ei = ei + 1;
        }
    }
}

// The program (ncc's gen_program emission half: layouts, wrappers,
// prototypes, then the function bodies; methods are rung-3).
fn egen(p: *u8, st: *i64, path: str) {
    put("/* Generated by ncc from ");     // ncc names its argv input
    put(path);                             // verbatim -- so does ngen
    put(" */\n#include \"nyxrt.h\"\n\n");
    elayouts(p, st);
    mut ti := 0;                           // v0.24: the fn-type typedefs —
    while ti < st[69] {                    // the signatures the parse
        put("typedef ");                   // declared, after the layouts
        efndecl(p, st, ti, ti, 0);         // they may mention, before
        put(";\n");                        // anything that names them
        ti = ti + 1;
    }
    if st[69] > 0 { put("\n"); }
    exfns(p, st);
    eprotos(p, st);
    mut mi := 0;
    while mi < st[54] {                    // method bodies first (ncc's
        gmeth(p, st, mi);                  // gen_program order)
        mi = mi + 1;
    }
    ft := st[37] as *i64;
    mut i := 0;
    while i < st[38] {
        if ft[i * 8 + 6] == 1 { gfn(p, st, i); }
        i = i + 1;
    }
}

#[caps(syscall)]
fn main() -> i64 {
    mut path := "/tmp/n_gen_target.n";     // the harness convention is
    if arg_count() > 1 { path = arg(1); }  // the FALLBACK; `ngen file.n`
                                           // names a target (v0.23 argv)
    fd := sys_open(path.ptr as *u8, 0, 0);
    if fd < 0 {
        if arg_count() > 1 {
            put("ngen: cannot open {path}\n");
            return 1;
        }
        put("(no check target - skipped)\n");
        return 0;
    }
    // All drivers accept up to 256 KiB of source. Check/gen reserve a
    // further 256 KiB in this allocation for their synthesized type names.
    memory := sys_sbrk(524288);
    if memory <= 0 {
        sys_close(fd);
        put("ngen: cannot allocate input buffer\n");
        return 1;
    }
    buf := memory as *u8;
    limit := 262144;
    mut total := 0;
    mut reading := true;
    while reading {
        mut count := limit - total;
        if count > 16384 { count = 16384; }
        mut target := (buf as addr + total as addr) as *u8;
        // At the exact limit, probe EOF using one byte INSIDE the buffer.
        // An extra byte may overwrite buf[0] only on the rejected path.
        if count == 0 { target = buf; count = 1; }
        r := sys_read(fd, target, count as isize);
        if r < 0 {
            sys_close(fd);
            put("ngen: cannot read {path}\n");
            return 1;
        }
        if r == 0 { reading = false; }
        else {
            if total == limit {
                sys_close(fd);
                put("ngen: input exceeds {limit} bytes: {path}\n");
                return 1;
            }
            total = total + r;
        }
    }
    sys_close(fd);
    if total < 1 { return 0; }
    inb := "i64boolstru8u64voidOkErrselfpageflags";   // the intern tail
    mut z2 := 0;                           // (synthesized type names, the
    while z2 < 37 {                        // result variants, self, and
        buf[total + z2] = inb.ptr[z2];     // pageflags) — AFTER the
        z2 = z2 + 1;                       // source, same buffer (+19 Ok
    }                                      // +21 Err +24 self +28 pf/9)
    st := arena_alloc(1024) as *i64;          // 128 slots (v0.24 uses 64..69)
    ps := arena_alloc(1024) as *i64;          // the params arena
    st[33] = arena_alloc(4194304);            // nodes: 64K x 8 words (check.n
                                           // alone parses to ~22K nodes)
    st[34] = 1;                            // node 0 is nil
    st[35] = arena_alloc(1048576);            // the flat list arena
    st[36] = 0;
    st[37] = arena_alloc(16384);              // fn table: 256 records
    st[38] = 0;
    st[39] = arena_alloc(32768);              // vars: 10-word records
    st[40] = 0;
    st[41] = 0;                            // the error flag
    st[42] = 0;                            // CUR_FN_CAPS
    st[43] = 0;                            // block depth
    st[44] = total;                        // the intern base
    st[49] = arena_alloc(8192);               // the struct table
    st[58] = arena_alloc(256);                // the defer registry (16 max,
    st[59] = 0;                            // ncc's FN_DEFERS/NDEFERS)
    st[50] = 0;
    st[51] = arena_alloc(8192);               // the enum table
    st[52] = 0;
    st[53] = arena_alloc(8192);               // the method table
    st[54] = 0;
    st[64] = arena_alloc(18432);              // fn-type table: 32 x 72 words
    st[65] = 0;                            // (v0.24), its count, the
    st[66] = arena_alloc(2304);               // per-depth parse scratch, the
    st[67] = 0;                            // nesting depth, the tail
    st[68] = total + 37;                   // cursor (after the intern
    st[69] = 0;                            // tail) and the declared count
    st[70] = arena_alloc(1024);               // v0.25: the field-drop path
    st[71] = 0;                            // stack (span pairs) and depth
    nil0 := st[33] as *i64;                // node 0: an explicit nil
    mut z := 0;
    while z < 8 { nil0[z] = 0; z = z + 1; }
    st[0] = 0;
    st[1] = 1;
    st[2] = -1;
    st[3] = 0;
    st[4] = 0;
    st[32] = 0;
    adv(buf, total, st);                   // prime NEXT
    adv(buf, total, st);                   // ... and CUR
    pitems(buf, total, st, ps);            // ONE pass: tables + trees
    if st[41] == 1 { return 1; }           // a parse-time refusal (cname)
    st[69] = st[65];                       // the signatures declarations
                                           // named: ncc's typedef set
    cdecls(buf, st);                       // ncc: validate_drops + the
    if st[41] == 1 { return 1; }           // containment preamble
    mut m2 := 0;                           // METHOD bodies first — ncc's
    while m2 < st[54] {                    // gen_program checks methods
        cmeth(buf, st, m2);                // before functions
        if st[41] == 1 { return 1; }
        m2 = m2 + 1;
    }
    ft := st[37] as *i64;
    mut i := 0;                            // then fns in declaration
    while i < st[38] {                     // order; first error stops
        if ft[i * 8 + 6] == 1 {
            cfn(buf, st, i);
            if st[41] == 1 { return 1; }
        }
        i = i + 1;
    }
    egen(buf, st, path);                   // checked: EMIT (ncc's order)
    0
}
