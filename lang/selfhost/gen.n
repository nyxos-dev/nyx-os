        if st[41] == 1 { return; }         // consumes its source (ncc's
        if tyown(p, st, rt2) && nd[i * 8 + 3] == 1 {  // order: move first,
            ln6 := nd[i * 8 + 4];                     // then the refusal)
            put("{ln6}: own bindings are immutable — ownership transfers by move (v0.17)\n");
            st[41] = 1;
            return;
