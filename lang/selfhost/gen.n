// gen.n — ncc's code generator, rewritten in N. The FOURTH and final
// module of the self-host ladder (lex -> parse -> check -> gen; see
// ../docs/selfhost.md, "the gen.n verdict"). It accretes check.n
// whole — generation assumes checked input, exactly as ncc's single
// pass does — and adds the emitters. The differential is the
// strongest the ladder has had: gen.n's C output against ncc's, byte
// for byte, with ZERO normalization (both compilers read the same
// fixed path, so even the provenance comment matches).
//
// THE CHAIN ACCRETES, AND THE TREE MATERIALIZES: this file carries
// parse.n's code forward, but transformed — the parser no longer
// prints a postorder dump as it goes; every parse function RETURNS A
// NODE INDEX into a parallel-array AST. Checking needs the program
// as data, so the print-as-you-parse trick retires exactly here (the
// toy's history said it would). The five category passes collapse
// back to ONE pass: check.n's output is errors, not ordered dumps,
// so there is no dump order to buy — declarations land in tables the
// way ncc's own single pass builds them.
//
// THE CONTRACT IS DIFFERENTIAL, against the NEGATIVE CORPUS
// (tests/bad/ + MANIFEST.txt): for every claimed file, check.n must
// print ncc's exact first error — location AND wording — then stop
// (ncc dies on its first error; the flag st[41] mirrors that). One
// normalization, documented in tests/bad/README.md: check.n reads a
// fixed target path and cannot know the original basename, so it
// prints `line: message` and the harness strips the filename column
// from the manifest side (cut -d: -f2-). A clean program prints
// NOTHING — the harness also claims positive targets whose output
// must be empty.
//
// The CLAIMED LEDGER (which manifest rows and which positive
// silences this checker is held to) lives in ../selfhost/README.md
// and in the verification suite's stage [8c] — one canonical list,
// grown rung by rung, never duplicated here. Rung 2's checks:
// the capability gate (XFNS-only, ncc's xfn_caps — fn-to-fn calls
// never gate; checked between existence and arity), the C-keyword
// name refusal (parse-time, at the function's name — ncc's pexp
// timing), and the defer depth judgment (first thing in the defer
// case, before its expression resolves — ncc's S_DEFER order;
// BLOCK_DEPTH rides st[43], 1 = the function's own block).
//
// Parse coverage, stated honestly: extern blocks and functions are
// parsed for real (name/arity tables + full body trees); struct,
// enum and impl items are brace-SKIPPED (their rows arrive with the
// decl-table rung); `match` is not parsed yet (its binds need scope
// seeding — a later rung). The checker resolves paths against a
// scoped name table (params seeded immutable, blocks save/restore,
// innermost shadows — ncc's VARS discipline), enforces `mut` on
// assignment roots (field writes mutate the root binding), and holds
// calls to the merged extern+fn table (ncc's fn_lookup order) for
// existence and arity. Everything else recurses generically; types,
// caps, methods, enums and pageflags consts are later rungs.
//
// THE TREE: one arena, 8 words per node —
//   [0] kind  [1] a  [2] b  [3] c  [4] line  [5] span-start
//   [6] span-len  [7] next (statement chaining)
// kinds: expressions 1 int(a=val) 2 bool 3 str(a=count)
//   4 interp(a=list,b=holes) 5 path(span) 6 call(a=callee,b=list,
//   c=nargs) 7 field(a=base,span) 8 un(a,c=op) 9 bin(a,b,c=op)
//   10 cast(a) 11 slit(a=list,c=n,span) 12 elit(a=list,c=n,span)
//   13 index(a,b); statements 20 let(a=rhs,c=mut,span) 21 assign
//   (a=lhs,b=rhs,c=aop) 22 ret(a) 23 expr(a,c=try) 24 while(a,b)
//   25 if(a,b,c=else) 26 break 27 continue 28 defer(a) 30 for
//   (a=lo,b=hi,c=body,span); 40 block(a=first,b=tail,c=count).
// Node 0 is nil. Child lists (call args, interp holes, literal
// values, fn params as span pairs) live in a flat list arena.
//
// State lives in one sbrk'd word block:
//   st[0..32]  the lexer + token window (parse.n's block, unchanged)
//   st[33] node arena   st[34] node count   st[35] list arena
//   st[36] list count   st[37] fn table (externs + fns, 8 words:
//     span, np, caps, body, param-list start, kind 0=extern 1=fn)
//   st[38] fn count     st[39] vars (10 words: span, mut, T,
//     pmask, own_state 0 none/1 live/2 moved/3 held, spare)
//   st[40] var count    st[41] the error flag (first error wins)
//   st[55] LOOP_DEPTH   st[56] MATCH_DEPTH (the v0.18 move gates)
//
// The target path is argv[1], or /tmp/n_gen_target.n for the harness
// copies each source there before a run.

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_exit(code: i64) -> never                       = 0
    fn sys_open(path: *u8, flags: i64, mode: i64) -> i64   = 3
    fn sys_read(fd: i64, buf: *u8, len: isize) -> i64      = 4
    fn sys_close(fd: i64) -> i64                           = 5
    fn sys_sbrk(incr: i64) -> i64                          = 7
}

#[caps(syscall)]
fn arena_alloc(bytes: i64) -> i64 {
    memory := sys_sbrk(bytes);
    if memory <= 0 {
        // Do not allocate while reporting allocation failure.
        error := "ngen: out of memory\n";
        write(2, error.ptr as #[user] *u8, error.len as isize);
        sys_exit(1);
    }
    return memory;
}

#[caps(syscall)]
fn put_bytes(p: *u8, len: i64) {
    mut sent := 0;
    while sent < len {
        left := len - sent;
        n := write(1, (p as addr + sent as addr) as #[user] *u8, left as isize);
        if n <= 0 || n > left {
            // Best-effort diagnostic; exit must not depend on stderr working.
            error := "ngen: output write failed\n";
            write(2, error.ptr as #[user] *u8, error.len as isize);
            sys_exit(1);
        }
        sent = sent + n;
    }
}

#[caps(syscall)]
fn put(s: str) {
    put_bytes(s.ptr as *u8, s.len as i64);
}

// Write buf[s .. s+l) — the span echo, from lex.n's dump.
#[caps(syscall)]
fn put_span(p: *u8, s: i64, l: i64) {
    put_bytes((p as addr + s as addr) as *u8, l);
}

fn is_idc(b: i64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_dg(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn is_hx(b: i64) -> bool {
    return is_dg(b) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

fn hxv(d: i64) -> i64 {
    if is_dg(d) { return d - 48; }
    if d >= 97 { return d - 87; }          // a-f
    return d - 55;                         // A-F
}

fn eq2(p: *u8, s: i64, a: i64, b: i64) -> bool {
    return p[s] as i64 == a && p[s + 1] as i64 == b;
}

fn eq3(p: *u8, s: i64, a: i64, b: i64, c: i64) -> bool {
    return eq2(p, s, a, b) && p[s + 2] as i64 == c;
}

fn eq4(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64) -> bool {
    return eq3(p, s, a, b, c) && p[s + 3] as i64 == d;
}

fn eq5(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> bool {
    return eq4(p, s, a, b, c, d) && p[s + 4] as i64 == e;
}

fn eq6(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> bool {
    return eq5(p, s, a, b, c, d, e) && p[s + 5] as i64 == f;
}

// v0.23: the program-argument builtins. 1 for 'arg_count', 2 for 'arg',
// 0 otherwise — ncc resolves these BEFORE the fn-table lookup.
fn is_argb(p: *u8, s: i64, l: i64) -> i64 {
    if l == 3 && eq3(p, s, 97, 114, 103) { return 2; }     // arg
    if l != 9 { return 0; }
    if !eq5(p, s, 97, 114, 103, 95, 99) { return 0; }      // arg_c
    if !eq4(p, s + 5, 111, 117, 110, 116) { return 0; }    // ount
    return 1;
}

fn eq7(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> bool {
    return eq6(p, s, a, b, c, d, e, f) && p[s + 6] as i64 == g;
}

fn eq8(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> bool {
    return eq7(p, s, a, b, c, d, e, f, g) && p[s + 7] as i64 == h;
}

// ncc's keyword table (the lex.n copy, unchanged).
fn kwlook(p: *u8, s: i64, n: i64) -> i64 {
    if n == 2 {
        if eq2(p, s, 102, 110) { return 10; }             // fn
        if eq2(p, s, 97, 115) { return 18; }              // as
        if eq2(p, s, 105, 102) { return 13; }             // if
        if eq2(p, s, 105, 110) { return 29; }             // in
    }
    if n == 3 {
        if eq3(p, s, 109, 117, 116) { return 11; }        // mut
        if eq3(p, s, 114, 97, 119) { return 19; }         // raw
        if eq3(p, s, 102, 111, 114) { return 28; }        // for
        if eq3(p, s, 111, 119, 110) { return 36; }        // own
    }
    if n == 4 {
        if eq4(p, s, 101, 108, 115, 101) { return 14; }   // else
        if eq4(p, s, 116, 114, 117, 101) { return 20; }   // true
        if eq4(p, s, 101, 110, 117, 109) { return 24; }   // enum
        if eq4(p, s, 105, 109, 112, 108) { return 27; }   // impl
    }
    if n == 5 {
        if eq5(p, s, 119, 104, 105, 108, 101) { return 15; }   // while
        if eq5(p, s, 98, 114, 101, 97, 107) { return 16; }     // break
        if eq5(p, s, 102, 97, 108, 115, 101) { return 21; }    // false
        if eq5(p, s, 100, 101, 102, 101, 114) { return 23; }   // defer
        if eq5(p, s, 109, 97, 116, 99, 104) { return 25; }     // match
    }
    if n == 6 {
        if eq6(p, s, 101, 120, 116, 101, 114, 110) { return 8; }    // extern
        if eq6(p, s, 115, 116, 114, 117, 99, 116) { return 22; }    // struct
        if eq6(p, s, 114, 101, 116, 117, 114, 110) { return 12; }   // return
    }
    if n == 7 {
        if eq7(p, s, 115, 121, 115, 99, 97, 108, 108) { return 9; } // syscall
    }
    if n == 8 {
        if eq8(p, s, 99, 111, 110, 116, 105, 110, 117, 101) { return 17; }  // continue
    }
    return 7;                              // T_IDENT
}

// The lex.n scanner pair, unchanged: scan_string + next_kind.
fn scan_string(p: *u8, n: i64, st: *i64, cont: i64) -> i64 {
    st[5] = st[1];
    s0 := st[0];                           // raw body start — the
    mut cnt := 0;                          // emitters re-walk it
    mut going := true;
    while going {
        if st[0] >= n { return -1; }       // unterminated string
        b := p[st[0]] as i64;
        if b == 34 {                       // the closing quote
            st[0] = st[0] + 1;
            st[6] = cnt;
            st[7] = s0;
            if cont == 1 { return 5; }
            return 2;
        }
        if b == 123 {                      // a hole opens: push and hand
            st[0] = st[0] + 1;             // the stream to the expression
            if st[2] + 1 >= 16 { return -1; }   // interpolation too deep
            st[2] = st[2] + 1;
            st[8 + st[2]] = st[3];
            st[6] = cnt;
            st[7] = s0;
            if cont == 1 { return 4; }
            return 3;
        }
        if b == 92 {                       // an escape: validate + skip,
            st[0] = st[0] + 1;             // one processed byte
            if st[0] >= n { return -1; }
            e := p[st[0]] as i64;
            st[0] = st[0] + 1;
            ok := e == 110 || e == 116 || e == 114 || e == 48 || e == 92
               || e == 34 || e == 39 || e == 123 || e == 125;
            if !ok { return -1; }          // bad escape
            cnt = cnt + 1;
            continue;
        }
        if b == 10 { st[1] = st[1] + 1; }
        cnt = cnt + 1;
        st[0] = st[0] + 1;
    }
    0
}

fn next_kind(p: *u8, n: i64, st: *i64) -> i64 {
    if st[4] == 1 {                        // '}' closed a hole: resume
        st[4] = 0;
        return scan_string(p, n, st, 1);
    }
    mut b := 0;
    mut scanning := true;
    while scanning {                       // whitespace + comments
        if st[0] >= n { st[5] = st[1]; return 0; }   // T_EOF
        b = p[st[0]] as i64;
        if b == 32 || b == 9 || b == 13 { st[0] = st[0] + 1; continue; }
        if b == 10 { st[0] = st[0] + 1; st[1] = st[1] + 1; continue; }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
            while st[0] < n && p[st[0]] as i64 != 10 { st[0] = st[0] + 1; }
            continue;
        }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
            mut d := 1;
            st[0] = st[0] + 2;
            while st[0] < n && d > 0 {
                c := p[st[0]] as i64;
                if c == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
                    d = d + 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 42 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
                    d = d - 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 10 { st[1] = st[1] + 1; }
                st[0] = st[0] + 1;
            }
            continue;
        }
        scanning = false;
    }
    st[5] = st[1];
    if is_idc(b) {
        s := st[0];
        while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
            st[0] = st[0] + 1;
        }
        st[6] = s;
        st[7] = st[0] - s;
        return kwlook(p, s, st[0] - s);
    }
    if is_dg(b) {
        mut v := 0;
        if b == 48 && st[0] + 1 < n && p[st[0] + 1] as i64 == 120 {
            st[0] = st[0] + 2;
            while st[0] < n && (is_hx(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
                d := p[st[0]] as i64;
                if d != 95 { v = v * 16 + hxv(d); }
                st[0] = st[0] + 1;
            }
            st[6] = v;
            return 1;
        }
        while st[0] < n && (is_dg(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
            d := p[st[0]] as i64;
            if d != 95 { v = v * 10 + (d - 48); }
            st[0] = st[0] + 1;
        }
        st[6] = v;
        return 1;                          // T_INT
    }
    if b == 34 {
        st[0] = st[0] + 1;
        return scan_string(p, n, st, 0);
    }
    st[0] = st[0] + 1;
    mut b2 := 0;
    if st[0] < n { b2 = p[st[0]] as i64; }
    if b == 40 { return 37; }              // (
    if b == 41 { return 38; }              // )
    if b == 44 { return 41; }              // ,
    if b == 59 { return 42; }              // ;
    if b == 46 {
        if b2 == 46 { st[0] = st[0] + 1; return 30; }
        return 68;
    }
    if b == 91 { return 34; }              // [
    if b == 93 { return 35; }              // ]
    if b == 63 { return 69; }              // ?
    if b == 94 { return 65; }              // ^
    if b == 37 { return 51; }              // %
    if b == 42 { return 49; }              // *
    if b == 47 { return 50; }              // /
    if b == 123 {
        st[3] = st[3] + 1;
        return 39;
    }
    if b == 125 {
        if st[2] >= 0 && st[3] == st[8 + st[2]] {
            st[2] = st[2] - 1;
            st[4] = 1;
            return 6;
        }
        st[3] = st[3] - 1;
        return 40;
    }
    if b == 58 {
        if b2 == 61 { st[0] = st[0] + 1; return 44; }
        return 43;
    }
    if b == 45 {
        if b2 == 62 { st[0] = st[0] + 1; return 45; }
        if b2 == 61 { st[0] = st[0] + 1; return 53; }
        return 48;
    }
    if b == 43 {
        if b2 == 61 { st[0] = st[0] + 1; return 52; }
        return 47;
    }
    if b == 61 {
        if b2 == 61 { st[0] = st[0] + 1; return 54; }
        if b2 == 62 { st[0] = st[0] + 1; return 26; }
        return 46;
    }
    if b == 33 {
        if b2 == 61 { st[0] = st[0] + 1; return 55; }
        return 60;
    }
    if b == 60 {
        if b2 == 61 { st[0] = st[0] + 1; return 57; }
        if b2 == 60 { st[0] = st[0] + 1; return 66; }
        return 56;
    }
    if b == 62 {
        if b2 == 61 { st[0] = st[0] + 1; return 59; }
        if b2 == 62 { st[0] = st[0] + 1; return 67; }
        return 58;
    }
    if b == 38 {
        if b2 == 38 { st[0] = st[0] + 1; return 61; }
        return 63;
    }
    if b == 124 {
        if b2 == 124 { st[0] = st[0] + 1; return 62; }
        return 64;
    }
    if b == 35 {
        if st[0] + 6 <= n && eq6(p, st[0], 91, 117, 115, 101, 114, 93) {
            st[0] = st[0] + 6;
            return 31;                     // #[user]
        }
        if st[0] + 15 <= n && eq8(p, st[0], 91, 99, 97, 112, 115, 40, 115, 121)
            && eq7(p, st[0] + 8, 115, 99, 97, 108, 108, 41, 93) {
            st[0] = st[0] + 15;
            return 32;                     // #[caps(syscall)]
        }
        if st[0] + 6 <= n && eq6(p, st[0], 91, 100, 114, 111, 112, 40) {
            st[0] = st[0] + 6;
            s2 := st[0];
            mut got := false;
            while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
                st[0] = st[0] + 1;
                got = true;
            }
            if !got { return -1; }
            if st[0] + 2 > n { return -1; }
            if !(p[st[0]] as i64 == 41 && p[st[0] + 1] as i64 == 93) { return -1; }
            st[6] = s2;
            st[7] = st[0] - s2;
            st[0] = st[0] + 2;
            return 33;
        }
        return -1;                         // unknown attribute
    }
    return -1;                             // unexpected character
}

// ---------------------------------------------------------------- //
// The token window (parse.n's, unchanged): CUR at st[24..27], NEXT
// at st[28..31]; adv() shifts and lexes.

fn adv(p: *u8, n: i64, st: *i64) {
    st[24] = st[28]; st[25] = st[29]; st[26] = st[30]; st[27] = st[31];
    k := next_kind(p, n, st);
    st[28] = k; st[29] = st[5]; st[30] = st[6]; st[31] = st[7];
}

fn ck(st: *i64, k: i64) -> bool {
    return st[24] == k;
}

fn ck2(st: *i64, k: i64) -> bool {
    return st[28] == k;
}

fn acc(p: *u8, n: i64, st: *i64, k: i64) -> bool {
    if st[24] == k { adv(p, n, st); return true; }
    return false;
}

// An unsupported or unexpected construct. Claimed targets are valid
// sources inside the stated coverage, so this line appearing in a
// run means the PARSER is wrong — the differential catches it.
fn perr(st: *i64) {
    if st[41] == 1 { return; }             // a real error already spoke —
    l := st[25];                           // the unwind stays silent
    put("PARSE-ERR {l}\n");
}

// ---------------------------------------------------------------- //
// The tree and the tables.

// Allocate one node; returns its index. The next-link slot starts 0.
fn nnew(st: *i64, k: i64, a: i64, b: i64, c: i64, ln: i64, ss: i64, sl: i64) -> i64 {
    nd := st[33] as *i64;
    i := st[34];
    st[34] = i + 1;
    nd[i * 8] = k;
    nd[i * 8 + 1] = a;
    nd[i * 8 + 2] = b;
    nd[i * 8 + 3] = c;
    nd[i * 8 + 4] = ln;
    nd[i * 8 + 5] = ss;
    nd[i * 8 + 6] = sl;
    nd[i * 8 + 7] = 0;
    return i;
}

// Append one word to the flat list arena; returns its index.
fn ladd(st: *i64, v: i64) -> i64 {
    al := st[35] as *i64;
    i := st[36];
    al[i] = v;
    st[36] = i + 1;
    return i;
}

// Byte-compare two source spans (names are equal iff same bytes).
fn span_eq(p: *u8, s1: i64, l1: i64, s2: i64, l2: i64) -> bool {
    if l1 != l2 { return false; }
    mut i := 0;
    while i < l1 {
        if p[s1 + i] as i64 != p[s2 + i] as i64 { return false; }
        i = i + 1;
    }
    return true;
}

// ncc's C_KEYWORDS table: N identifiers lower into the generated C
// verbatim, so a name that is a C keyword would break the C build
// downstream — ncc rejects it at the declaration site instead, and
// check.n mirrors the judgment (kwlook's length-gated shape; N's own
// keywords never reach an identifier slot on either side).
fn is_ckw(p: *u8, s: i64, n: i64) -> bool {
    if n == 2 {
        if eq2(p, s, 100, 111) { return true; }                 // do
    }
    if n == 3 {
        if eq3(p, s, 105, 110, 116) { return true; }            // int
    }
    if n == 4 {
        if eq4(p, s, 97, 117, 116, 111) { return true; }        // auto
        if eq4(p, s, 99, 97, 115, 101) { return true; }         // case
        if eq4(p, s, 99, 104, 97, 114) { return true; }         // char
        if eq4(p, s, 103, 111, 116, 111) { return true; }       // goto
        if eq4(p, s, 108, 111, 110, 103) { return true; }       // long
        if eq4(p, s, 118, 111, 105, 100) { return true; }       // void
    }
    if n == 5 {
        if eq5(p, s, 99, 111, 110, 115, 116) { return true; }   // const
        if eq5(p, s, 102, 108, 111, 97, 116) { return true; }   // float
        if eq5(p, s, 115, 104, 111, 114, 116) { return true; }  // short
        if eq5(p, s, 117, 110, 105, 111, 110) { return true; }  // union
    }
    if n == 6 {
        if eq6(p, s, 100, 111, 117, 98, 108, 101) { return true; }   // double
        if eq6(p, s, 105, 110, 108, 105, 110, 101) { return true; }  // inline
        if eq6(p, s, 115, 105, 103, 110, 101, 100) { return true; }  // signed
        if eq6(p, s, 115, 105, 122, 101, 111, 102) { return true; }  // sizeof
        if eq6(p, s, 115, 116, 97, 116, 105, 99) { return true; }    // static
        if eq6(p, s, 115, 119, 105, 116, 99, 104) { return true; }   // switch
    }
    if n == 7 {
        if eq7(p, s, 100, 101, 102, 97, 117, 108, 116) { return true; }   // default
        if eq7(p, s, 116, 121, 112, 101, 100, 101, 102) { return true; }  // typedef
    }
    if n == 8 {
        if eq8(p, s, 114, 101, 103, 105, 115, 116, 101, 114) { return true; }  // register
        if eq8(p, s, 114, 101, 115, 116, 114, 105, 99, 116) { return true; }   // restrict
        if eq8(p, s, 117, 110, 115, 105, 103, 110, 101, 100) { return true; }  // unsigned
        if eq8(p, s, 118, 111, 108, 97, 116, 105, 108, 101) { return true; }   // volatile
    }
    return false;
}

// The C-keyword refusal, ncc's wording. ncc checks EVERY declaration
// site (its pexp does it for free); check.n mirrors the function-name
// site — the one the corpus exercises — and the other sites arrive as
// rows demand them. Fires at parse time, like ncc's.
#[caps(syscall)]
fn cname_fn(p: *u8, st: *i64, ss: i64, sl: i64, ln: i64) -> bool {
    if is_ckw(p, ss, sl) {
        put("{ln}: function name '");
        put_span(p, ss, sl);
        put("' is a C keyword — generated code uses names verbatim, pick another name\n");
        st[41] = 1;
        return true;
    }
    return false;
}

// One record in the merged extern+fn table (declaration order — the
// order ncc's fn_lookup searches: XFNS first, then FNS; our targets
// declare externs first, so one table preserves it).
fn fadd(st: *i64, ss: i64, sl: i64, np: i64, caps: i64, body: i64, pst: i64, knd: i64, num: i64) {
    ft := st[37] as *i64;
    i := st[38];
    ft[i * 8] = ss;
    ft[i * 8 + 1] = sl;
    ft[i * 8 + 2] = np;
    ft[i * 8 + 3] = caps;
    ft[i * 8 + 4] = body;
    ft[i * 8 + 5] = pst;
    ft[i * 8 + 6] = knd;
    ft[i * 8 + 7] = num;                   // extern: the syscall number
    st[38] = i + 1;
}

fn ffind(p: *u8, st: *i64, ss: i64, sl: i64) -> i64 {
    ft := st[37] as *i64;
    mut i := 0;
    while i < st[38] {
        if span_eq(p, ft[i * 8], ft[i * 8 + 1], ss, sl) { return i; }
        i = i + 1;
    }
    return -1;
}

// The struct table (ncc's STRUCTS/struct_lookup): 8-word records —
// name span, field count, field-record start (6-word span+T records
// in the flat list arena, the same shape params use), the own flag
// (ncc's is_own, v0.17) and the #[drop(...)] attribute span (0,0 =
// none — validated at rung 10c), one spare.
fn sadd(st: *i64, ss: i64, sl: i64, nf: i64, fst: i64, ow: i64, ds: i64, dl: i64) {
    sa := st[49] as *i64;
    i := st[50];
    sa[i * 8] = ss;
    sa[i * 8 + 1] = sl;
    sa[i * 8 + 2] = nf;
    sa[i * 8 + 3] = fst;
    sa[i * 8 + 4] = ow;
    sa[i * 8 + 5] = ds;
    sa[i * 8 + 6] = dl;
    sa[i * 8 + 7] = 0;
    st[50] = i + 1;
}

fn sfind(p: *u8, st: *i64, ss: i64, sl: i64) -> i64 {
    sa := st[49] as *i64;
    mut i := 0;
    while i < st[50] {
        if span_eq(p, sa[i * 8], sa[i * 8 + 1], ss, sl) { return i; }
        i = i + 1;
    }
    return -1;
}

// Field q of struct record si, as (span, T) out of the list arena.
fn sfty(st: *i64, si: i64, q: i64) -> T {
    sa := st[49] as *i64;
    al := st[35] as *i64;
    r := sa[si * 8 + 3] + q * 6;
    T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] }
}

// Is t a value of an `own struct` type? (ncc's ty_is_own, v0.17)
fn tyown(p: *u8, st: *i64, t: T) -> bool {
    if t.l == 0 || t.pt != 0 { return false; }
    si := sfind(p, st, t.s, t.l);
    if si < 0 { return false; }
    sa := st[49] as *i64;
    return sa[si * 8 + 4] == 1;
}

// Is t a POINTER to an `own struct` type? (ncc's validate_ty, v0.17:
// no aliasing an owner — refused in every signature and field; the
// v0.26 door is a local born from a cast, which no table records.)
fn typtrown(p: *u8, st: *i64, t: T) -> bool {
    if t.l == 0 || t.pt == 0 { return false; }
    si := sfind(p, st, t.s, t.l);
    if si < 0 { return false; }
    sa := st[49] as *i64;
    return sa[si * 8 + 4] == 1;
}

// The refusal itself, at file level — ncc's `%s: pointers to own type
// '%s' are not allowed (in %s)`, the place being the item's name.
fn eptrown(p: *u8, st: *i64, t: T, ns: i64, nl: i64) {
    put(" pointers to own type '");
    put_span(p, t.s, t.l);
    put("' are not allowed (in ");
    put_span(p, ns, nl);
    put(")\n");
    st[41] = 1;
}

// The enum table (ncc's ENUMS/enum_lookup): 4-word records — name
// span, variant count, variant-record start. Variant records (also
// 4-word: span, payload count, payload-field start) and their
// payload fields (6-word span+T) live in the flat list arena.
fn eadd(st: *i64, ss: i64, sl: i64, nv: i64, vst: i64) {
    ea := st[51] as *i64;
    i := st[52];
    ea[i * 4] = ss;
    ea[i * 4 + 1] = sl;
    ea[i * 4 + 2] = nv;
    ea[i * 4 + 3] = vst;
    st[52] = i + 1;
}

fn efind(p: *u8, st: *i64, ss: i64, sl: i64) -> i64 {
    ea := st[51] as *i64;
    mut i := 0;
    while i < st[52] {
        if span_eq(p, ea[i * 4], ea[i * 4 + 1], ss, sl) { return i; }
        i = i + 1;
    }
    return -1;
}

// ncc's variant_index: the variant's position within enum ei, or -1.
fn vfindx(p: *u8, st: *i64, ei: i64, vs: i64, vl: i64) -> i64 {
    ea := st[51] as *i64;
    al := st[35] as *i64;
    vbase := ea[ei * 4 + 3];
    mut i := 0;
    while i < ea[ei * 4 + 2] {
        if span_eq(p, al[vbase + i * 4], al[vbase + i * 4 + 1], vs, vl) { return i; }
        i = i + 1;
    }
    return -1;
}

// The method table (ncc's METHODS/method_lookup): 8-word records —
// impl-type span, method-name span, np, param-record start (6-word
// span+T records + a 4-word return type after them, the fn table's
// exact shape), body. self is EXCLUDED from the params, like ncc.
fn madd(st: *i64, ts: i64, tl: i64, ns: i64, nl: i64, np: i64, pst: i64, body: i64) {
    ma := st[53] as *i64;
    i := st[54];
    ma[i * 8] = ts;
    ma[i * 8 + 1] = tl;
    ma[i * 8 + 2] = ns;
    ma[i * 8 + 3] = nl;
    ma[i * 8 + 4] = np;
    ma[i * 8 + 5] = pst;
    ma[i * 8 + 6] = body;
    ma[i * 8 + 7] = 0;
    st[54] = i + 1;
}

fn mfind(p: *u8, st: *i64, ts: i64, tl: i64, ns: i64, nl: i64) -> i64 {
    ma := st[53] as *i64;
    mut i := 0;
    while i < st[54] {
        if span_eq(p, ma[i * 8], ma[i * 8 + 1], ts, tl)
            && span_eq(p, ma[i * 8 + 2], ma[i * 8 + 3], ns, nl) { return i; }
        i = i + 1;
    }
    return -1;
}

fn mpty(st: *i64, mi: i64, q: i64) -> T {
    ma := st[53] as *i64;
    al := st[35] as *i64;
    r := ma[mi * 8 + 5] + q * 6;
    T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] }
}

fn mrty(st: *i64, mi: i64) -> T {
    ma := st[53] as *i64;
    al := st[35] as *i64;
    r := ma[mi * 8 + 5] + ma[mi * 8 + 4] * 6;
    T{ pt: al[r], us: al[r + 1], s: al[r + 2], l: al[r + 3] }
}

// ncc's enum_is_result: exactly the variants Ok and Err, each with
// at most one payload field.
fn eresult(p: *u8, st: *i64, ei: i64) -> bool {
    ea := st[51] as *i64;
    al := st[35] as *i64;
    if ea[ei * 4 + 2] != 2 { return false; }
    oki := vfindx(p, st, ei, st[44] + 19, 2);
    eri := vfindx(p, st, ei, st[44] + 21, 3);
    if oki < 0 || eri < 0 { return false; }
    vb := ea[ei * 4 + 3];
    return al[vb + oki * 4 + 2] <= 1 && al[vb + eri * 4 + 2] <= 1;
}

// Seed one arm's binds, positionally typed from the variant's
// payload fields — ncc's vars_add(bind, field ty, 0) loop.
fn mseed(p: *u8, st: *i64, ei: i64, vi: i64, bst: i64, nb: i64) {
    al := st[35] as *i64;
    ea := st[51] as *i64;
    vbase := ea[ei * 4 + 3];
    fst := al[vbase + vi * 4 + 3];
    mut b2 := 0;
    while b2 < nb {
        r := fst + b2 * 6;
        ft2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        vadd(st, al[bst + b2 * 2], al[bst + b2 * 2 + 1], 0, ft2);
        b2 = b2 + 1;
    }
}

// The scoped name table: ncc's VARS discipline — vars_add appends,
// vars_find scans backward (innermost shadows), blocks record the
// count on entry and truncate on exit.
fn vadd(st: *i64, ss: i64, sl: i64, m: i64, t: T) {
    va := st[39] as *i64;
    i := st[40];
    va[i * 10] = ss;
    va[i * 10 + 1] = sl;
    va[i * 10 + 2] = m;
    va[i * 10 + 3] = t.pt;
    va[i * 10 + 4] = t.us;
    va[i * 10 + 5] = t.s;
    va[i * 10 + 6] = t.l;
    va[i * 10 + 7] = -1;                   // pmask: -1 = unknown flags
    va[i * 10 + 8] = 0;                    // own_state: ncc's OWN_NONE —
    va[i * 10 + 9] = 0;                    // births/params set it; spare
    st[40] = i + 1;
}

fn vty(st: *i64, v: i64) -> T {
    va := st[39] as *i64;
    T{ pt: va[v * 10 + 3], us: va[v * 10 + 4], s: va[v * 10 + 5], l: va[v * 10 + 6] }
}

fn vfind(p: *u8, st: *i64, ss: i64, sl: i64) -> i64 {
    va := st[39] as *i64;
    mut i := st[40] - 1;
    while i >= 0 {
        if span_eq(p, va[i * 10], va[i * 10 + 1], ss, sl) { return i; }
        i = i - 1;
    }
    return -1;
}

// v0.17 move point (ncc's own_move_expr): expression i is consumed
// as a VALUE (bound, passed, returned, assigned, or a block tail).
// v0.25: the PLACE a refused field move names — a binding, or a field
// chain rooted in one, spelled as written (`o.p`, `__self.env`);
// anything else (a call's result, a computed index) stays "an own
// value". root = 1 prints only the binding the chain hangs from: the
// value to consume as a whole (ncc: expr_place). v0.26: a chain may
// hang from a POINTEE instead — `p[0]`, a name indexed by a literal or
// a name (kind 13 over kind 5 and kind 1 or 5) — spelled as written
// too, and the fix is then a take, not a consume (mpointee).
fn mpathok(st: *i64, b: i64) -> bool {
    nd := st[33] as *i64;
    if nd[b * 8] == 5 { return true; }
    if nd[b * 8] == 7 { return mpathok(st, nd[b * 8 + 1]); }
    if nd[b * 8] == 13 {
        a := nd[b * 8 + 1];
        x := nd[b * 8 + 2];
        if nd[a * 8] != 5 { return false; }
        if nd[x * 8] == 1 { return true; }
        return nd[x * 8] == 5;
    }
    return false;
}
fn mpointee(st: *i64, b: i64) -> bool {
    nd := st[33] as *i64;
    if nd[b * 8] == 7 { return mpointee(st, nd[b * 8 + 1]); }
    if nd[b * 8] == 13 { return mpathok(st, b); }
    return false;
}
fn mpath(p: *u8, st: *i64, b: i64, root: i64) {
    nd := st[33] as *i64;
    if nd[b * 8] == 7 {
        mpath(p, st, nd[b * 8 + 1], root);
        if root == 1 { return; }
        put(".");
    }
    if nd[b * 8] == 13 {
        a := nd[b * 8 + 1];
        x := nd[b * 8 + 2];
        put_span(p, nd[a * 8 + 5], nd[a * 8 + 6]);
        put("[");
        if nd[x * 8] == 1 { v := nd[x * 8 + 1]; put("{v}"); }
        if nd[x * 8] == 5 { put_span(p, nd[x * 8 + 5], nd[x * 8 + 6]); }
        put("]");
        return;
    }
    put_span(p, nd[b * 8 + 5], nd[b * 8 + 6]);
}
fn mplace(p: *u8, st: *i64, b: i64, root: i64) {
    if mpathok(st, b) { mpath(p, st, b, root); }
    if !mpathok(st, b) { put("an own value"); }
}

// A bare path naming an own binding transfers ownership here — the
// binding becomes MOVED. Field reads are NOT moves: `f.fd` peeks,
// `f` transfers. The v0.18 gates refuse moves where the statement
// may run zero or many times — loop bodies AND while conditions
// (the condition re-evaluates every iteration) — and inside match
// arms (consume conditionally with if/else instead).
fn cmove(p: *u8, st: *i64, i: i64, ln: i64) {
    if st[41] == 1 { return; }
    if i == 0 { return; }
    nd := st[33] as *i64;
    if nd[i * 8] == 7 {                    // v0.25: a field never moves out
        ft := cinfer(p, st, i);            // alone — the container is
        if tyown(p, st, ft) {              // consumed as a whole
            b := nd[i * 8 + 1];
            put("{ln}: cannot move field '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            if mpointee(st, b) {           // v0.26: a cell behind a pointer —
                put("' out of the pointee '");   // taken whole, then consumed
                mplace(p, st, b, 0);
                put("' — take it as a whole first, e := ");
                mplace(p, st, b, 1);
                put(" (v0.26)\n");
            }
            if !mpointee(st, b) {
                put("' out of own value '");
                mplace(p, st, b, 0);
                put("' — consume '");
                mplace(p, st, b, 1);
                put("' as a whole (v0.25)\n");
            }
            st[41] = 1;
        }
        return;
    }
    if nd[i * 8] != 5 { return; }
    v := vfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
    if v < 0 { return; }
    va := st[39] as *i64;
    o := va[v * 10 + 8];
    if o == 0 { return; }
    if o == 2 {
        put("{ln}: use of '");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put("' after move\n");
        st[41] = 1;
        return;
    }
    if st[55] > 0 {
        put("{ln}: own value '");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put("' cannot move inside a loop — the move could run zero or many times (v0.18)\n");
        st[41] = 1;
        return;
    }
    if st[56] > 0 {
        put("{ln}: own value '");
        put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        put("' cannot move inside a match arm — consume it with if/else instead (v0.18)\n");
        st[41] = 1;
        return;
    }
    va[v * 10 + 8] = 2;
}

// Does this block's LAST statement `return`? (ncc's block_returns.)
// A returning if-arm never reaches the merge point below, so it is
// exempt from the branch-agreement rule — the return's own path was
// already policed there.
fn brret(st: *i64, b: i64) -> i64 {
    nd := st[33] as *i64;
    if b == 0 { return 0; }
    if nd[b * 8 + 3] == 0 { return 0; }
    mut s := nd[b * 8 + 1];
    mut lst := 0;
    while s > 0 {
        lst = s;
        s = nd[s * 8 + 7];
    }
    if nd[lst * 8] == 22 { return 1; }
    return 0;
}

// v0.22 missing-return analysis (ncc's block_guarantees): does this
// block GUARANTEE a value on every path? A path is covered by a tail
// expression, a `return` (or a `return match`), an `if` whose BOTH
// arms guarantee, an exhaustive match STATEMENT whose every arm
// guarantees, or a call to a `never` function (the path diverges).
// Loops never guarantee: a while may run zero times, and `while true`
// is not special-cased.
fn sguar(p: *u8, st: *i64, i: i64) -> i64 {
    nd := st[33] as *i64;
    al := st[35] as *i64;
    k := nd[i * 8];
    if k == 22 { return 1; }
    if k == 29 {
        hd := nd[i * 8 + 2];
        if al[hd] == 3 { return 1; }       // return match
        if al[hd] == 0 && nd[i * 8 + 3] > 0 {
            armb := al[hd + 6];            // an exhaustive match whose
            mut all := 1;                  // every arm guarantees
            mut a := 0;
            while a < nd[i * 8 + 3] {
                if bguar(p, st, al[armb + a * 6 + 4]) == 0 { all = 0; }
                a = a + 1;
            }
            if all == 1 { return 1; }
        }
    }
    if k == 25 {
        els := nd[i * 8 + 3];
        if els > 0 && bguar(p, st, nd[i * 8 + 2]) == 1 {
            if nd[els * 8] == 40 && bguar(p, st, els) == 1 { return 1; }
            if nd[els * 8] == 25 && sguar(p, st, els) == 1 { return 1; }
        }
    }
    if k == 23 && nd[i * 8 + 3] == 0 {     // a call to a never fn:
        e := nd[i * 8 + 1];                // the path diverges
        if nd[e * 8] == 6 {
            cal := nd[e * 8 + 1];
            if nd[cal * 8] == 5 {
                fi := ffind(p, st, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                if fi >= 0 {
                    rt := frty(st, fi);
                    if rt.l == 5 && eq5(p, rt.s, 110, 101, 118, 101, 114) { return 1; }
                }
            }
        }
    }
    return 0;
}

fn bguar(p: *u8, st: *i64, b: i64) -> i64 {
    nd := st[33] as *i64;
    if b == 0 { return 0; }
    if nd[b * 8 + 2] > 0 { return 1; }     // a tail expression
    mut s := nd[b * 8 + 1];
    while s > 0 {
        if sguar(p, st, s) == 1 { return 1; }
        s = nd[s * 8 + 7];
    }
    return 0;
}

// v0.25: can a value of type t end on its own (ncc's own_has_drop)?
// Through its #[drop], or — for an own container without one — through
// its own fields' drops, every one of which must exist.
fn hasdrop(p: *u8, st: *i64, t: T) -> bool {
    if t.pt != 0 || t.l == 0 { return false; }
    si := sfind(p, st, t.s, t.l);
    if si < 0 { return false; }
    sa := st[49] as *i64;
    if sa[si * 8 + 4] != 1 { return false; }
    if sa[si * 8 + 6] > 0 { return true; }
    mut any := 0;
    mut q := 0;
    while q < sa[si * 8 + 2] {
        ft := sfty(st, si, q);
        if tyown(p, st, ft) {
            if !hasdrop(p, st, ft) { return false; }
            any = 1;
        }
        q = q + 1;
    }
    return any == 1;
}

// v0.25 (ncc's own_held_drops_emit, the judgment half): a HELD own
// container ending its body here drops its own fields — so a field
// whose type cannot drop makes this exit an error; the container
// should have been moved on. Run at function exits only.
fn cheld(p: *u8, st: *i64, ln: i64) {
    if st[41] == 1 { return; }
    va := st[39] as *i64;
    sa := st[49] as *i64;
    al := st[35] as *i64;
    mut j := 0;
    while j < st[40] {
        if va[j * 10 + 8] == 3 {
            t := vty(st, j);
            if t.pt == 0 && t.l > 0 {
                si := sfind(p, st, t.s, t.l);
                if si >= 0 {
                    mut q := 0;
                    while q < sa[si * 8 + 2] {
                        ft := sfty(st, si, q);
                        if tyown(p, st, ft) && !hasdrop(p, st, ft) {
                            r := sa[si * 8 + 3] + q * 6;
                            put("{ln}: held own value '");
                            put_span(p, va[j * 10], va[j * 10 + 1]);
                            put("' ends here with field '");
                            put_span(p, al[r], al[r + 1]);
                            put("' unconsumed — '");
                            put_span(p, ft.s, ft.l);
                            put("' has no #[drop] destructor; move '");
                            put_span(p, va[j * 10], va[j * 10 + 1]);
                            put("' on instead (v0.25)\n");
                            st[41] = 1;
                            return;
                        }
                        q = q + 1;
                    }
                }
            }
        }
        j = j + 1;
    }
}

// v0.19 auto-drops (ncc's own_drops_emit): at scope ends and returns,
// every LIVE binding at index >= from whose TYPE carries a #[drop]
// destructor drops (reverse birth order) — it becomes MOVED, so the
// leak scan that follows only reports values with no destructor.
// Held params never auto-drop: a callee owns its parameters manually.
// v0.25: a live own container without a #[drop] of its own drops
// through its fields when every own field can drop (hasdrop).
fn cdrops(p: *u8, st: *i64, from: i64) {
    if st[41] == 1 { return; }
    va := st[39] as *i64;
    mut j := st[40] - 1;
    while j >= from {
        if va[j * 10 + 8] == 1 {
            t := vty(st, j);
            if hasdrop(p, st, t) {
                va[j * 10 + 8] = 2;
            }
        }
        j = j - 1;
    }
}

// The leak scan (ncc's own_leak_scan): any own binding at index >=
// from still LIVE here leaks — report the first (ascending, ncc's
// loop order). w: 0 = "this return"; 1 = a scope end, whose wording
// splits on BLOCK_DEPTH — the function's own block or an inner one.
fn cleak(p: *u8, st: *i64, from: i64, ln: i64, w: i64) {
    if st[41] == 1 { return; }
    va := st[39] as *i64;
    mut j := from;
    while j < st[40] {
        if va[j * 10 + 8] == 1 {
            put("{ln}: unconsumed own value '");
            put_span(p, va[j * 10], va[j * 10 + 1]);
            put("' at ");
            if w == 0 { put("this return"); }
            if w == 1 && st[43] == 1 { put("the end of the function"); }
            if w == 1 && st[43] != 1 { put("the end of this block"); }
            put(" — return it, pass it on, or give the type a #[drop] destructor\n");
            st[41] = 1;
            return;
        }
        j = j + 1;
    }
}

// ---------------------------------------------------------------- //
// Types. ncc's Ty={name,ptrs,is_user} is exactly the parser's T
// (pt, us, name-span); sl == 0 marks "no type" (void), ncc's NULL
// name. SYNTHESIZED types (an int literal is "i64" with no source
// span to point at) use the INTERN TRICK: the six fixed names are
// appended after the source text in the same buffer — the lexer
// never sees them (its length excludes the tail) and span_eq stays
// uniform. st[44] = the intern base; offsets are fixed:
//   +0 i64(3)  +3 bool(4)  +7 str(3)  +10 u8(2)  +12 u64(3)
//   +15 void(4)

fn t_i64(st: *i64) -> T  { return T{ pt: 0, us: 0, s: st[44], l: 3 }; }
fn t_bool(st: *i64) -> T { return T{ pt: 0, us: 0, s: st[44] + 3, l: 4 }; }
fn t_str(st: *i64) -> T  { return T{ pt: 0, us: 0, s: st[44] + 7, l: 3 }; }
fn t_pu8(st: *i64) -> T  { return T{ pt: 1, us: 0, s: st[44] + 10, l: 2 }; }
fn t_u8(st: *i64) -> T   { return T{ pt: 0, us: 0, s: st[44] + 10, l: 2 }; }
fn t_u64(st: *i64) -> T  { return T{ pt: 0, us: 0, s: st[44] + 12, l: 3 }; }
fn t_void() -> T         { return T{ pt: 0, us: 0, s: 0, l: 0 }; }
fn t_pf(st: *i64) -> T   { return T{ pt: 0, us: 0, s: st[44] + 28, l: 9 }; }

// ncc's PF_CONSTS: the four predeclared page-permission constants.
// Returns the bit value, or -1 when the span is not one of them.
fn is_pfc(p: *u8, s: i64, l: i64) -> i64 {
    if l < 9 { return -1; }
    if !eq5(p, s, 80, 82, 79, 84, 95) { return -1; }       // PROT_
    if l == 9 {
        if eq4(p, s + 5, 78, 79, 78, 69) { return 0; }     // NONE
        if eq4(p, s + 5, 82, 69, 65, 68) { return 1; }     // READ
        if eq4(p, s + 5, 69, 88, 69, 67) { return 4; }     // EXEC
    }
    if l == 10 {
        if eq5(p, s + 5, 87, 82, 73, 84, 69) { return 2; } // WRITE
    }
    return -1;
}

// ncc's pf_mask over nodes: the statically-known bit set of a
// pageflags expression — constants, bindings (their tracked pmask),
// and '|' compositions; -1 = unknown (a parameter's flags were
// W^X-proven at its call sites and are opaque here).
fn cpfmask(p: *u8, st: *i64, i: i64) -> i64 {
    nd := st[33] as *i64;
    if nd[i * 8] == 5 {
        b := is_pfc(p, nd[i * 8 + 5], nd[i * 8 + 6]);
        if b >= 0 { return b; }
        v := vfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
        if v >= 0 {
            va := st[39] as *i64;
            return va[v * 10 + 7];
        }
        return -1;
    }
    if nd[i * 8] == 9 && nd[i * 8 + 3] == 64 {   // '|'
        l2 := cpfmask(p, st, nd[i * 8 + 1]);
        r2 := cpfmask(p, st, nd[i * 8 + 2]);
        if l2 < 0 || r2 < 0 { return -1; }
        return l2 | r2;
    }
    return -1;
}

// Render a binary operator's source text from its token kind — the
// diagnostics quote the operator verbatim.
#[caps(syscall)]
fn op_put(c: i64) {
    if c == 47 { put("+"); }
    if c == 48 { put("-"); }
    if c == 60 { put("!"); }               // unary-only: the emitter
                                           // renders it too (E_UN)
    if c == 49 { put("*"); }
    if c == 50 { put("/"); }
    if c == 51 { put("%"); }
    if c == 54 { put("=="); }
    if c == 55 { put("!="); }
    if c == 56 { put("<"); }
    if c == 57 { put("<="); }
    if c == 58 { put(">"); }
    if c == 59 { put(">="); }
    if c == 61 { put("&&"); }
    if c == 62 { put("||"); }
    if c == 63 { put("&"); }
    if c == 64 { put("|"); }
    if c == 65 { put("^"); }
    if c == 66 { put("<<"); }
    if c == 67 { put(">>"); }
}

fn span_is(p: *u8, t: T, ss: i64, sl: i64) -> bool {
    return t.pt == 0 && span_eq(p, t.s, t.l, ss, sl);
}

// ncc's ty_is_int: the twelve integer names (bool counts — C
// semantics), value types only.
fn is_int_ty(p: *u8, t: T) -> bool {
    if t.pt != 0 || t.l == 0 { return false; }
    s := t.s;
    if t.l == 2 {
        if eq2(p, s, 105, 56) { return true; }             // i8
        if eq2(p, s, 117, 56) { return true; }             // u8
    }
    if t.l == 3 {
        if eq3(p, s, 105, 49, 54) { return true; }         // i16
        if eq3(p, s, 117, 49, 54) { return true; }         // u16
        if eq3(p, s, 105, 51, 50) { return true; }         // i32
        if eq3(p, s, 117, 51, 50) { return true; }         // u32
        if eq3(p, s, 105, 54, 52) { return true; }         // i64
        if eq3(p, s, 117, 54, 52) { return true; }         // u64
    }
    if t.l == 4 {
        if eq4(p, s, 98, 111, 111, 108) { return true; }   // bool
        if eq4(p, s, 97, 100, 100, 114) { return true; }   // addr
    }
    if t.l == 5 {
        if eq5(p, s, 105, 115, 105, 122, 101) { return true; }   // isize
        if eq5(p, s, 117, 115, 105, 122, 101) { return true; }   // usize
    }
    return false;
}

// ncc's ty_compat, transliterated: the #[user] boundary first (so
// the byte-pointer wildcards cannot smuggle across), then exact
// name+depth, then integer inter-conversion, then the *u8/*void
// byte-pointer escape at equal depth.
fn tcompat(p: *u8, a: T, b: T) -> bool {
    if (a.pt > 0 || b.pt > 0) && a.us != b.us { return false; }
    if a.l > 0 && b.l > 0 && a.pt == b.pt && span_eq(p, a.s, a.l, b.s, b.l) { return true; }
    if is_int_ty(p, a) && is_int_ty(p, b) { return true; }
    if a.pt > 0 && b.pt > 0 && a.pt == b.pt {
        if eq2(p, a.s, 117, 56) && a.l == 2 { return true; }     // u8
        if eq2(p, b.s, 117, 56) && b.l == 2 { return true; }
        if a.l == 4 && eq4(p, a.s, 118, 111, 105, 100) { return true; }   // void
        if b.l == 4 && eq4(p, b.s, 118, 111, 105, 100) { return true; }
    }
    return false;
}

// ncc's ty_str, as prints: "#[user] " prefix, one '*' per level,
// the name ("void" when absent).
#[caps(syscall)]
fn ty_put(p: *u8, st: *i64, t: T) {
    if t.us == 1 { put("#[user] "); }
    mut q := 0;
    while q < t.pt { put("*"); q = q + 1; }
    if t.l > 0 { put_span(p, t.s, t.l); }
    if t.l == 0 { put_span(p, st[44] + 15, 4); }   // void
}

// A parsed type, by value: ptrs, is_user, and the name's span.
struct T { pt: i64, us: i64, s: i64, l: i64 }

// ncc's parse_type: [#[user]] [raw] *... name. Rung 1 checks no
// types; the tokens still have to be consumed correctly.
fn pty(p: *u8, n: i64, st: *i64) -> T {
    tln := st[25];                         // ncc's parse_type stamps both
    mut us := 0;                           // refusals at the type's FIRST
    if acc(p, n, st, 31) { us = 1; }       // token (#[user], v0.12)
    mut rw := 0;
    if ck(st, 19) { adv(p, n, st); rw = 1; }   // raw (lowers identically)
    if us == 1 && rw == 1 {
        put("{tln}: #[user] and raw are mutually exclusive — raw is the explicit opt-out\n");
        st[41] = 1;
        return T{ pt: 0, us: 0, s: 0, l: 0 };
    }
    mut pt := 0;
    mut going := true;
    while going {
        going = false;
        if ck(st, 49) { adv(p, n, st); pt = pt + 1; going = true; }
    }
    if ck(st, 10) {                        // fn(A, B) -> R (v0.24)
        adv(p, n, st);
        if pt > 0 || us == 1 || rw == 1 {
            put("{tln}: a function type is a value of its own — no pointer, raw or #[user] on it (v0.24)\n");
            st[41] = 1;
            return T{ pt: 0, us: 0, s: 0, l: 0 };
        }
        return pfnty(p, n, st);
    }
    if !ck(st, 7) { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    s := st[26];
    l := st[27];
    adv(p, n, st);
    if us == 1 && pt == 0 {                // a checked pointer needs the
        put("{tln}: #[user] applies only to pointer types (got ");
        put_span(p, s, l);                 // pointer (ncc prints the bare
        put(")\n");                        // type name here)
        st[41] = 1;
        return T{ pt: 0, us: 0, s: 0, l: 0 };
    }
    T{ pt: pt, us: us, s: s, l: l }
}

// ---- function types (v0.24) ------------------------------------- //
// check.n's representation, accreted: a fn type's NAME is its N
// spelling, "fn(A, B) -> R", written to the buffer tail on first
// sight, so it is an ordinary T (ptrs 0, the name's span) and span_eq
// gives structural identity. The generator adds the one thing ncc's
// codegen needs — the signature's INDEX: interned in source order
// during the one parse pass (nested inner-first, ncc's recursive
// parse_type), it names the typedef `__nyx_fnN`. The table lives in
// st[64] (count st[65]; 72-word entries: np, has_ret, ret T, up to 16
// param T's, the spelling's span at 70..71), the per-depth parse
// scratch in st[66]/st[67], the tail cursor in st[68]; st[69] counts
// the signatures the PARSE declared — exactly the typedefs ncc emits
// (a fn value's signature interned later has none).

fn tail_ascii(p: *u8, st: *i64, b: i64) {
    c := st[68];
    if c < 524287 {
        p[c] = b as u8;
        st[68] = c + 1;
    }
}

fn tail_copy(p: *u8, st: *i64, s: i64, l: i64) {
    mut k := 0;
    while k < l {
        tail_ascii(p, st, p[s + k] as i64);
        k = k + 1;
    }
}

// One type in ncc's ty_str spelling: "#[user] ", one '*' per level,
// the name.
fn tail_ty(p: *u8, st: *i64, pt: i64, us: i64, s: i64, l: i64) {
    if us == 1 {
        tail_ascii(p, st, 35);             // #[user]<space>
        tail_ascii(p, st, 91);
        tail_ascii(p, st, 117);
        tail_ascii(p, st, 115);
        tail_ascii(p, st, 101);
        tail_ascii(p, st, 114);
        tail_ascii(p, st, 93);
        tail_ascii(p, st, 32);
    }
    mut k := 0;
    while k < pt { tail_ascii(p, st, 42); k = k + 1; }
    tail_copy(p, st, s, l);
}

// The interned index of the signature in scratch slot sc, added on
// first sight: the spelling is written to the tail, then looked up —
// a repeat rolls the tail back and returns the existing entry.
#[caps(syscall)]
fn fnty_intern(p: *u8, st: *i64, sc: *i64) -> i64 {
    sp0 := st[68];
    tail_ascii(p, st, 102);                // fn(
    tail_ascii(p, st, 110);
    tail_ascii(p, st, 40);
    mut q := 0;
    while q < sc[0] {
        if q > 0 { tail_ascii(p, st, 44); tail_ascii(p, st, 32); }
        tail_ty(p, st, sc[6 + q * 4], sc[7 + q * 4], sc[8 + q * 4], sc[9 + q * 4]);
        q = q + 1;
    }
    tail_ascii(p, st, 41);                 // )
    if sc[1] == 1 {
        tail_ascii(p, st, 32);             // <space>-><space>
        tail_ascii(p, st, 45);
        tail_ascii(p, st, 62);
        tail_ascii(p, st, 32);
        tail_ty(p, st, sc[2], sc[3], sc[4], sc[5]);
    }
    plen := st[68] - sp0;
    cnt := st[65];
    mut i := 0;
    while i < cnt {
        e := (st[64] as addr + (i * 576) as addr) as *i64;
        if span_eq(p, e[70], e[71], sp0, plen) {
            st[68] = sp0;
            return i;
        }
        i = i + 1;
    }
    if cnt >= 32 {
        put(" too many distinct function types\n");
        st[41] = 1;
        return 0;
    }
    e2 := (st[64] as addr + (cnt * 576) as addr) as *i64;
    mut k := 0;
    while k < 70 { e2[k] = sc[k]; k = k + 1; }
    e2[70] = sp0;
    e2[71] = plen;
    st[65] = cnt + 1;
    cnt
}

// The fn type a T names, or -1 (ncc's fnty_of).
fn fnty_of(p: *u8, st: *i64, t: T) -> i64 {
    if t.pt != 0 || t.l == 0 { return -1; }
    mut i := 0;
    while i < st[65] {
        e := (st[64] as addr + (i * 576) as addr) as *i64;
        if span_eq(p, e[70], e[71], t.s, t.l) { return i; }
        i = i + 1;
    }
    return -1;
}

fn fnty_t(st: *i64, fi: i64) -> T {
    e := (st[64] as addr + (fi * 576) as addr) as *i64;
    T{ pt: 0, us: 0, s: e[70], l: e[71] }
}

// The signature's return type (void when it has none).
fn fnty_ret(st: *i64, fi: i64) -> T {
    e := (st[64] as addr + (fi * 576) as addr) as *i64;
    if e[1] == 0 { return t_void(); }
    T{ pt: e[2], us: e[3], s: e[4], l: e[5] }
}

fn fnty_pty(st: *i64, fi: i64, q: i64) -> T {
    e := (st[64] as addr + (fi * 576) as addr) as *i64;
    T{ pt: e[6 + q * 4], us: e[7 + q * 4], s: e[8 + q * 4], l: e[9 + q * 4] }
}

// fn(A, B) -> R in type position, CUR at '(' (the `fn` is consumed):
// the parameter types land in a per-depth scratch slot (one may be a
// fn type itself, interned first — ncc's recursive parse_type), then
// the signature is interned.
fn pfnty(p: *u8, n: i64, st: *i64) -> T {
    if !ck(st, 37) { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    adv(p, n, st);
    d := st[67];
    if d >= 4 { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    st[67] = d + 1;
    sc := (st[66] as addr + (d * 576) as addr) as *i64;
    mut np := 0;
    mut more := !ck(st, 38);
    while more {
        more = false;
        t := pty(p, n, st);
        if np < 16 {
            sc[6 + np * 4] = t.pt;
            sc[7 + np * 4] = t.us;
            sc[8 + np * 4] = t.s;
            sc[9 + np * 4] = t.l;
        }
        np = np + 1;
        if acc(p, n, st, 41) { more = true; }
    }
    if !ck(st, 38) { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    adv(p, n, st);
    sc[0] = np;
    sc[1] = 0;
    sc[2] = 0;
    sc[3] = 0;
    sc[4] = 0;
    sc[5] = 0;
    if acc(p, n, st, 45) {                 // -> R
        r := pty(p, n, st);
        sc[1] = 1;
        sc[2] = r.pt;
        sc[3] = r.us;
        sc[4] = r.s;
        sc[5] = r.l;
    }
    st[67] = d;
    idx := fnty_intern(p, st, sc);
    fnty_t(st, idx)
}

// ncc's fn_value_ty: the fn type of user function fi — its signature,
// interned on first sight (a value's type may be one no declaration
// names; the S_LET rule then refuses to bind it).
fn fn_value_ty(p: *u8, st: *i64, fi: i64) -> T {
    ft := st[37] as *i64;
    sc := (st[66] as addr + (st[67] * 576) as addr) as *i64;
    np := ft[fi * 8 + 2];
    sc[0] = np;
    sc[1] = 0;
    sc[2] = 0;
    sc[3] = 0;
    sc[4] = 0;
    sc[5] = 0;
    rt := frty(st, fi);
    if rt.l > 0 {
        sc[1] = 1;
        sc[2] = rt.pt;
        sc[3] = rt.us;
        sc[4] = rt.s;
        sc[5] = rt.l;
    }
    mut q := 0;
    while q < np && q < 16 {
        pq := fpty(st, fi, q);
        sc[6 + q * 4] = pq.pt;
        sc[7 + q * 4] = pq.us;
        sc[8 + q * 4] = pq.s;
        sc[9 + q * 4] = pq.l;
        q = q + 1;
    }
    idx := fnty_intern(p, st, sc);
    fnty_t(st, idx)
}

// ncc's field_fnty: the fn type of struct field (fs, fl) on a value of
// type rt, or -1.
fn field_fnty(p: *u8, st: *i64, rt: T, fs: i64, fl: i64) -> i64 {
    if rt.pt != 0 || rt.l == 0 { return -1; }
    si := sfind(p, st, rt.s, rt.l);
    if si < 0 { return -1; }
    sa := st[49] as *i64;
    al := st[35] as *i64;
    mut q := 0;
    while q < sa[si * 8 + 2] {
        r := sa[si * 8 + 3] + q * 6;
        if span_eq(p, al[r], al[r + 1], fs, fl) { return fnty_of(p, st, sfty(st, si, q)); }
        q = q + 1;
    }
    return -1;
}

// ncc's check_fn_value_call: a call through a fn value — call node i,
// the value's signature fi, named (ws, wl) in the messages — checked
// against the signature exactly like a direct call.
#[caps(syscall)]
fn cfnvcall(p: *u8, st: *i64, i: i64, fi: i64, ws: i64, wl: i64) {
    nd := st[33] as *i64;
    al := st[35] as *i64;
    ln := nd[i * 8 + 4];
    na := nd[i * 8 + 3];
    e := (st[64] as addr + (fi * 576) as addr) as *i64;
    np := e[0];
    if na != np {
        put("{ln}: '");
        put_span(p, ws, wl);
        put("' takes {np} argument(s), got {na}\n");
        st[41] = 1;
        return;
    }
    mut q := 0;
    while q < na {
        cexpr(p, st, al[nd[i * 8 + 2] + q]);
        if st[41] == 1 { return; }
        at := cinfer(p, st, al[nd[i * 8 + 2] + q]);
        pt2 := fnty_pty(st, fi, q);
        if !tcompat(p, at, pt2) {
            qq := q + 1;
            put("{ln}: argument {qq} to '");
            put_span(p, ws, wl);
            put("': expected ");
            ty_put(p, st, pt2);
            put(", got ");
            ty_put(p, st, at);
            put("\n");
            st[41] = 1;
            return;
        }
        cmove(p, st, al[nd[i * 8 + 2] + q], ln);
        if st[41] == 1 { return; }
        q = q + 1;
    }
}

// ncc's emit_fn_declarator: `R (*name)(A, B)`. A struct field of fn
// type spells it out (its layout precedes the typedefs, which may
// mention the structs); the typedef lines spell it around __nyx_fnN
// (nl 0: ns is the index). A nested fn type reads as its typedef.
fn efndecl(p: *u8, st: *i64, fi: i64, ns: i64, nl: i64) {
    e := (st[64] as addr + (fi * 576) as addr) as *i64;
    rt := fnty_ret(st, fi);
    nvr := rt.l == 5 && eq5(p, rt.s, 110, 101, 118, 101, 114);
    if rt.l == 0 || nvr { put("void"); }
    if rt.l > 0 && !nvr { ety(p, st, rt); }
    put(" (*");
    if nl == 0 { put("__nyx_fn{ns}"); }
    if nl > 0 { put_span(p, ns, nl); }
    put(")(");
    np := e[0];
    if np == 0 { put("void"); }
    mut q := 0;
    while q < np {
        if q > 0 { put(", "); }
        pq := fnty_pty(st, fi, q);
        ety(p, st, pq);
        q = q + 1;
    }
    put(")");
}

// ---- the expression ladder: parse and BUILD, node indexes up ---- //

fn pexpr(p: *u8, n: i64, st: *i64) -> i64 {
    return por(p, n, st);
}

// Interpolation: hole expressions become a child list; the text
// fragments and format specs are consumed but not kept (checking
// needs the holes, not the text).
#[caps(syscall)]
fn pinterp(p: *u8, n: i64, st: *i64) -> i64 {
    hx := arena_alloc(2048) as *i64;          // frag scratch: 8-word records
    mut nh := 0;                           // (count, raw start, node,
    ln := st[25];                          // has-spec, fmtk 0 dec/1 x/2 X,
    hx[0] = st[26];                        // width, zero, spare) — node 0
    hx[1] = st[27];                        // = a text fragment. The HEAD
    hx[2] = 0;                             // text is the first fragment.
    hx[3] = 0;
    hx[4] = 0;
    hx[5] = 0;
    hx[6] = 0;
    hx[7] = 0;
    nh = 1;
    adv(p, n, st);                         // past the HEAD text
    mut going := true;
    while going {
        mut w2 := 0;
        while w2 < 8 { hx[nh * 8 + w2] = 0; w2 = w2 + 1; }
        hx[nh * 8 + 2] = pexpr(p, n, st);  // the hole, as a node
        if acc(p, n, st, 43) {             // ':' format spec — validated
            if !ck(st, 7) { perr(st); return 0; }   // AT PARSE TIME, ncc's
            fss := st[26];                 // exact grammar walk:
            fsl := st[27];                 // [wN|zN][x|X] | x | X
            adv(p, n, st);
            mut fi := 0;
            mut bad := 0;
            mut wd := 0;
            mut zr := 0;
            c0 := p[fss] as i64;
            if c0 == 119 || c0 == 122 {    // w / z
                fi = 1;
                if c0 == 122 { zr = 1; }
                while fi < fsl && is_dg(p[fss + fi] as i64) {
                    wd = wd * 10 + (p[fss + fi] as i64 - 48);
                    fi = fi + 1;
                }
                if fi == 1 || wd <= 0 || wd > 128 { bad = 1; }
            }
            mut fk := 0;
            if fi < fsl && p[fss + fi] as i64 == 120 { fi = fi + 1; fk = 1; }
            if fk == 0 && fi < fsl && p[fss + fi] as i64 == 88 { fi = fi + 1; fk = 2; }
            if fi != fsl || bad == 1 {
                put("{ln}: unknown format spec ':");
                put_span(p, fss, fsl);
                put("' — the format specs are :x, :X (hex), :wN (width), :zN (zero-pad), and wN/zN composed with a trailing x or X\n");
                st[41] = 1;
                return 0;
            }
            hx[nh * 8 + 3] = 1;            // a valid spec always demands
            hx[nh * 8 + 4] = fk;           // an integer hole downstream;
            hx[nh * 8 + 5] = wd;           // the parsed values ride to
            hx[nh * 8 + 6] = zr;           // the emitter
        }
        nh = nh + 1;
        if !ck(st, 6) { perr(st); return 0; }    // T_INTERP_R
        adv(p, n, st);
        if ck(st, 4) {                     // MID: a text fragment
            mut w3 := 0;
            while w3 < 8 { hx[nh * 8 + w3] = 0; w3 = w3 + 1; }
            hx[nh * 8] = st[26];
            hx[nh * 8 + 1] = st[27];
            nh = nh + 1;
            adv(p, n, st);
            continue;
        }
        if ck(st, 5) {                     // TAIL: the last text fragment
            mut w4 := 0;
            while w4 < 8 { hx[nh * 8 + w4] = 0; w4 = w4 + 1; }
            hx[nh * 8] = st[26];
            hx[nh * 8 + 1] = st[27];
            nh = nh + 1;
            adv(p, n, st);
            going = false;
            continue;
        }
        perr(st);
        return 0;
    }
    ast := st[36];
    mut q := 0;
    while q < nh * 8 { ladd(st, hx[q]); q = q + 1; }
    return nnew(st, 4, ast, nh, 0, ln, 0, 0);
}

#[caps(syscall)]
fn pprimary(p: *u8, n: i64, st: *i64) -> i64 {
    if ck(st, 1) {                         // int
        v := st[26];
        ln := st[25];
        adv(p, n, st);
        return nnew(st, 1, v, 0, 0, ln, 0, 0);
    }
    if ck(st, 20) || ck(st, 21) {          // true / false
        mut v := 0;
        if ck(st, 20) { v = 1; }
        ln := st[25];
        adv(p, n, st);
        return nnew(st, 2, v, 0, 0, ln, 0, 0);
    }
    if ck(st, 2) {                         // plain string: count + the
        c := st[26];                       // raw start (emission re-walks
        rw := st[27];                      // the body, decoding escapes)
        ln := st[25];
        adv(p, n, st);
        return nnew(st, 3, c, rw, 0, ln, 0, 0);
    }
    if ck(st, 3) {                         // interpolation HEAD
        return pinterp(p, n, st);
    }
    if ck(st, 37) {                        // '(': parens re-enable slits
        adv(p, n, st);
        save := st[32];
        st[32] = 0;
        h := pexpr(p, n, st);
        st[32] = save;
        if !ck(st, 38) { perr(st); return 0; }
        adv(p, n, st);
        return h;
    }
    if ck(st, 7) {                         // a name, or Name{ ... }
        ns := st[26];
        nl := st[27];
        ln := st[25];
        adv(p, n, st);
        if ck(st, 39) && st[32] == 0 {     // struct literal: field
            adv(p, n, st);                 // names AND values (3-word
            vx := arena_alloc(768) as *i64;   // records: span + value)
            mut na := 0;
            mut more := !ck(st, 40);
            while more {
                more = false;
                if ck(st, 40) { continue; }    // trailing comma
                if !ck(st, 7) { perr(st); return 0; }
                vx[na * 3] = st[26];
                vx[na * 3 + 1] = st[27];
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return 0; }
                adv(p, n, st);
                vx[na * 3 + 2] = pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 40) { perr(st); return 0; }
            adv(p, n, st);
            ast := st[36];
            mut q := 0;
            while q < na * 3 { ladd(st, vx[q]); q = q + 1; }
            return nnew(st, 11, ast, 0, na, ln, ns, nl);
        }
        return nnew(st, 5, 0, 0, 0, ln, ns, nl);
    }
    perr(st);
    return 0;
}

// Postfix: same lookahead dance as parse.n — a variant literal needs
// the path by NAME, so `Name . Name {` is peeled before the primary.
#[caps(syscall)]
fn ppostfix(p: *u8, n: i64, st: *i64) -> i64 {
    if ck(st, 7) && ck2(st, 68) {
        ns := st[26];
        nl := st[27];
        ln := st[25];
        adv(p, n, st);                     // the name
        dl := st[25];                      // the '.' line (ncc: dline)
        adv(p, n, st);                     // '.'
        if !ck(st, 7) { perr(st); return 0; }
        fs := st[26];
        fl := st[27];
        adv(p, n, st);                     // the field name
        if ck(st, 39) && st[32] == 0 {     // Enum.Variant{ ... }: field
            adv(p, n, st);                 // names AND values, like slit
            vx := arena_alloc(768) as *i64;
            mut na := 0;
            mut more := !ck(st, 40);
            while more {
                more = false;
                if ck(st, 40) { continue; }
                if !ck(st, 7) { perr(st); return 0; }
                vx[na * 3] = st[26];
                vx[na * 3 + 1] = st[27];
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return 0; }
                adv(p, n, st);
                vx[na * 3 + 2] = pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 40) { perr(st); return 0; }
            adv(p, n, st);
            ast := st[36];
            mut q := 0;
            while q < na * 3 { ladd(st, vx[q]); q = q + 1; }
            el := nnew(st, 12, ast, fs, na, ln, ns, nl);
            nd2 := st[33] as *i64;         // the variant span: b = start,
            nd2[el * 8 + 7] = fl;          // x = length (exprs never
            return ppostfix_tail(p, n, st, el);   // chain, so x is free)
        }
        base := nnew(st, 5, 0, 0, 0, ln, ns, nl);
        h := pfield_or_call(p, n, st, base, fs, fl, dl);
        return ppostfix_tail(p, n, st, h);
    }
    h2 := pprimary(p, n, st);
    return ppostfix_tail(p, n, st, h2);
}

// The postfix loop AFTER the head expression is built.
#[caps(syscall)]
fn ppostfix_tail(p: *u8, n: i64, st: *i64, h0: i64) -> i64 {
    mut h := h0;
    mut going := true;
    while going {
        going = false;
        if ck(st, 68) {                    // '.' field or method
            dl := st[25];                  // the '.' line (ncc: dline)
            adv(p, n, st);
            if !ck(st, 7) { perr(st); return 0; }
            fs := st[26];
            fl := st[27];
            adv(p, n, st);
            h = pfield_or_call(p, n, st, h, fs, fl, dl);
            going = true;
            continue;
        }
        if ck(st, 37) {                    // '(': a call on the head
            ln := st[25];
            adv(p, n, st);
            ax := arena_alloc(512) as *i64;   // arg scratch (nested calls
            mut na := 0;                   // interleave the list arena)
            mut more := !ck(st, 38);
            while more {
                more = false;
                ax[na] = pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 38) { perr(st); return 0; }
            adv(p, n, st);
            ast := st[36];
            mut q := 0;
            while q < na { ladd(st, ax[q]); q = q + 1; }
            h = nnew(st, 6, h, ast, na, ln, 0, 0);
            going = true;
            continue;
        }
        if ck(st, 34) {                    // '[' index ']'
            iln := st[25];                 // the judgments print here
            adv(p, n, st);
            ix := pexpr(p, n, st);
            if !ck(st, 35) { perr(st); return 0; }
            adv(p, n, st);
            h = nnew(st, 13, h, ix, 0, iln, 0, 0);
            going = true;
            continue;
        }
    }
    return h;
}

// After base + '.' + name: a call makes the field node the callee
// (ncc's method-call shape); a plain read is just the field node.
#[caps(syscall)]
fn pfield_or_call(p: *u8, n: i64, st: *i64, base: i64, fs: i64, fl: i64, dl: i64) -> i64 {
    if ck(st, 37) {                        // method call
        ln := st[25];
        fld := nnew(st, 7, base, 0, 0, ln, fs, fl);
        adv(p, n, st);
        ax := arena_alloc(512) as *i64;
        mut na := 0;
        mut more := !ck(st, 38);
        while more {
            more = false;
            ax[na] = pexpr(p, n, st);
            na = na + 1;
            if acc(p, n, st, 41) { more = true; }
        }
        if !ck(st, 38) { perr(st); return 0; }
        adv(p, n, st);
        ast := st[36];
        mut q := 0;
        while q < na { ladd(st, ax[q]); q = q + 1; }
        return nnew(st, 6, fld, ast, na, ln, 0, 0);
    }
    return nnew(st, 7, base, 0, 0, dl, fs, fl);   // a field read carries its '.' line
}

fn punary(p: *u8, n: i64, st: *i64) -> i64 {
    if ck(st, 48) {                        // unary '-'
        ln := st[25];
        adv(p, n, st);
        h := punary(p, n, st);
        return nnew(st, 8, h, 0, 48, ln, 0, 0);
    }
    if ck(st, 60) {                        // '!'
        ln := st[25];
        adv(p, n, st);
        h2 := punary(p, n, st);
        return nnew(st, 8, h2, 0, 60, ln, 0, 0);
    }
    return ppostfix(p, n, st);
}

fn pcast(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := punary(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 18) {                    // 'as' TYPE — the node carries
            ln := st[25];                  // the whole T: b=ptrs, c=user,
            adv(p, n, st);                 // span=name (casts are the
            t := pty(p, n, st);            // authoritative type source)
            h = nnew(st, 10, h, t.pt, t.us, ln, t.s, t.l);
            going = true;
        }
    }
    return h;
}

fn pmul(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pcast(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 49) { ln := st[25]; adv(p, n, st); r := pcast(p, n, st); h = nnew(st, 9, h, r, 49, ln, 0, 0); going = true; continue; }
        if ck(st, 50) { ln := st[25]; adv(p, n, st); r := pcast(p, n, st); h = nnew(st, 9, h, r, 50, ln, 0, 0); going = true; continue; }
        if ck(st, 51) { ln := st[25]; adv(p, n, st); r := pcast(p, n, st); h = nnew(st, 9, h, r, 51, ln, 0, 0); going = true; }
    }
    return h;
}

fn padd2(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pmul(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 47) { ln := st[25]; adv(p, n, st); r := pmul(p, n, st); h = nnew(st, 9, h, r, 47, ln, 0, 0); going = true; continue; }
        if ck(st, 48) { ln := st[25]; adv(p, n, st); r := pmul(p, n, st); h = nnew(st, 9, h, r, 48, ln, 0, 0); going = true; }
    }
    return h;
}

fn pshift(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := padd2(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 66) { ln := st[25]; adv(p, n, st); r := padd2(p, n, st); h = nnew(st, 9, h, r, 66, ln, 0, 0); going = true; continue; }
        if ck(st, 67) { ln := st[25]; adv(p, n, st); r := padd2(p, n, st); h = nnew(st, 9, h, r, 67, ln, 0, 0); going = true; }
    }
    return h;
}

fn pband(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pshift(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 63) { ln := st[25]; adv(p, n, st); r := pshift(p, n, st); h = nnew(st, 9, h, r, 63, ln, 0, 0); going = true; }
    }
    return h;
}

fn pbxor(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pband(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 65) { ln := st[25]; adv(p, n, st); r := pband(p, n, st); h = nnew(st, 9, h, r, 65, ln, 0, 0); going = true; }
    }
    return h;
}

fn pbor(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pbxor(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 64) { ln := st[25]; adv(p, n, st); r := pbxor(p, n, st); h = nnew(st, 9, h, r, 64, ln, 0, 0); going = true; }
    }
    return h;
}

fn pcmp(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pbor(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 54) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 54, ln, 0, 0); going = true; continue; }
        if ck(st, 55) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 55, ln, 0, 0); going = true; continue; }
        if ck(st, 56) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 56, ln, 0, 0); going = true; continue; }
        if ck(st, 57) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 57, ln, 0, 0); going = true; continue; }
        if ck(st, 58) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 58, ln, 0, 0); going = true; continue; }
        if ck(st, 59) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 59, ln, 0, 0); going = true; }
    }
    return h;
}

fn pand(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pcmp(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 61) { ln := st[25]; adv(p, n, st); r := pcmp(p, n, st); h = nnew(st, 9, h, r, 61, ln, 0, 0); going = true; }
    }
    return h;
}

fn por(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pand(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 62) { ln := st[25]; adv(p, n, st); r := pand(p, n, st); h = nnew(st, 9, h, r, 62, ln, 0, 0); going = true; }
    }
    return h;
}

// ---- statements + blocks --------------------------------------- //

// match <subject> { arms }, `match` already consumed — parse.n's
// pmatch accreted back, transformed to nodes. exprarms: 1 = the
// value forms (arm bodies are expressions), 0 = the statement form
// (arm bodies are blocks). The K_MATCH node: a = subject, b = the
// list-arena HEADER (8 words: mtarget, lhs node, aop, let-name span,
// is_mut, arm-record start, bind-area start — patched after the
// binds land), c = narms. Arm records are 6 words: variant span,
// bind count, bind start (2-word spans), body/value node, line.
#[caps(syscall)]
fn pmatch(p: *u8, n: i64, st: *i64, exprarms: i64, mt: i64, mln: i64, ns2: i64, nl2: i64, aop: i64, im: i64, lhs: i64) -> i64 {
    st[32] = 1;
    subj := pexpr(p, n, st);
    st[32] = 0;
    if !ck(st, 39) { perr(st); return 0; }
    adv(p, n, st);
    bs := arena_alloc(2048) as *i64;          // bind-span scratch
    ar := arena_alloc(1024) as *i64;          // arm scratch: 16 x 6
    mut na := 0;
    mut btop := 0;
    mut more := !ck(st, 40);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return 0; }
        vs := st[26];
        vl := st[27];
        aln := st[25];
        adv(p, n, st);
        mut nb := 0;
        bst := btop;
        if acc(p, n, st, 37) {             // (binds)
            mut inner := true;
            while inner {
                inner = false;
                if !ck(st, 7) { perr(st); return 0; }
                bs[btop * 2] = st[26];
                bs[btop * 2 + 1] = st[27];
                btop = btop + 1;
                adv(p, n, st);
                nb = nb + 1;
                if acc(p, n, st, 41) { inner = true; }
            }
            if !ck(st, 38) { perr(st); return 0; }
            adv(p, n, st);
        }
        if !ck(st, 26) { perr(st); return 0; }   // '=>'
        adv(p, n, st);
        mut bd := 0;
        if exprarms == 1 { bd = pexpr(p, n, st); }
        if exprarms == 0 { bd = pblock(p, n, st); }
        ar[na * 6] = vs;
        ar[na * 6 + 1] = vl;
        ar[na * 6 + 2] = nb;
        ar[na * 6 + 3] = bst;              // scratch index, made absolute
        ar[na * 6 + 4] = bd;               // when routed into the arena
        ar[na * 6 + 5] = aln;
        na = na + 1;
        if acc(p, n, st, 41) {
            if !ck(st, 40) { more = true; }
        }
    }
    if !ck(st, 40) { perr(st); return 0; }
    adv(p, n, st);
    hst := st[36];                         // the header
    ladd(st, mt);
    ladd(st, lhs);
    ladd(st, aop);
    ladd(st, ns2);
    ladd(st, nl2);
    ladd(st, im);
    ladd(st, 0);                           // arm start (patched below)
    ladd(st, 0);
    bbase := st[36];                       // all binds, then arm records
    mut q := 0;
    while q < btop * 2 { ladd(st, bs[q]); q = q + 1; }
    abase := st[36];
    mut q2 := 0;
    while q2 < na {
        ladd(st, ar[q2 * 6]);
        ladd(st, ar[q2 * 6 + 1]);
        ladd(st, ar[q2 * 6 + 2]);
        ladd(st, bbase + ar[q2 * 6 + 3] * 2);
        ladd(st, ar[q2 * 6 + 4]);
        ladd(st, ar[q2 * 6 + 5]);
        q2 = q2 + 1;
    }
    al := st[35] as *i64;
    al[hst + 6] = abase;
    return nnew(st, 29, subj, hst, na, mln, 0, 0);
}

fn pif(p: *u8, n: i64, st: *i64) -> i64 {
    ln := st[25];
    adv(p, n, st);                         // 'if'
    st[32] = 1;
    c := pexpr(p, n, st);
    st[32] = 0;
    t := pblock(p, n, st);
    mut e := 0;
    if acc(p, n, st, 14) {                 // else, or else-if (the else
        mut inner := 0;                    // slot then holds an if node)
        if ck(st, 13) {
            inner = 1;
            e = pif(p, n, st);
        }
        if inner == 0 { e = pblock(p, n, st); }
    }
    return nnew(st, 25, c, t, e, ln, 0, 0);
}

// One block: statements chain through the next-link slot; the tail
// expression rides the block node. Each dispatcher branch fills sn,
// and the `sn == 0` guards keep one statement to one branch.
fn pblock(p: *u8, n: i64, st: *i64) -> i64 {
    if !ck(st, 39) { perr(st); return 0; }
    bln := st[25];
    adv(p, n, st);
    mut first := 0;
    mut last := 0;
    mut cnt := 0;
    mut tail := 0;
    mut istail := 0;
    mut going := true;
    while going {
        if ck(st, 40) { going = false; continue; }
        if ck(st, 0) { perr(st); return 0; }
        mut sn := 0;
        if ck(st, 11) || (ck(st, 7) && ck2(st, 44)) {   // [mut] name :=
            ln := st[25];
            mut im := 0;
            if acc(p, n, st, 11) { im = 1; }
            if !ck(st, 7) { perr(st); return 0; }
            is := st[26];
            il := st[27];
            adv(p, n, st);
            if !ck(st, 44) { perr(st); return 0; }
            adv(p, n, st);
            if ck(st, 25) {                // x := match subj { ... };
                adv(p, n, st);
                sn = pmatch(p, n, st, 1, 1, ln, is, il, 0, im, 0);
                if !ck(st, 42) { perr(st); return 0; }
                adv(p, n, st);
            }
            if sn == 0 {
                rhs := pexpr(p, n, st);
                mut tf := 0;               // x := e?; — the try flag
                if acc(p, n, st, 69) { tf = 1; }   // rides slot b
                if !ck(st, 42) { perr(st); return 0; }
                adv(p, n, st);
                sn = nnew(st, 20, rhs, tf, im, ln, is, il);
            }
        }
        if sn == 0 && ck(st, 12) {         // return [e] ;
            ln := st[25];
            adv(p, n, st);
            if ck(st, 25) {                // return match subj { ... };
                adv(p, n, st);
                sn = pmatch(p, n, st, 1, 3, ln, 0, 0, 0, 0, 0);
                if !ck(st, 42) { perr(st); return 0; }
                adv(p, n, st);
            }
            if sn == 0 {
                mut re := 0;
                mut bare := 0;
                if ck(st, 42) { adv(p, n, st); bare = 1; }
                if bare == 0 {
                    re = pexpr(p, n, st);
                    if !ck(st, 42) { perr(st); return 0; }
                    adv(p, n, st);
                }
                sn = nnew(st, 22, re, 0, 0, ln, 0, 0);
            }
        }
        if sn == 0 && ck(st, 16) {         // break ;
            ln := st[25];
            adv(p, n, st);
            if !ck(st, 42) { perr(st); return 0; }
            adv(p, n, st);
            sn = nnew(st, 26, 0, 0, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 17) {         // continue ;
            ln := st[25];
            adv(p, n, st);
            if !ck(st, 42) { perr(st); return 0; }
            adv(p, n, st);
            sn = nnew(st, 27, 0, 0, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 23) {         // defer e ;
            ln := st[25];
            adv(p, n, st);
            de := pexpr(p, n, st);
            if !ck(st, 42) { perr(st); return 0; }
            adv(p, n, st);
            sn = nnew(st, 28, de, 0, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 15) {         // while cond { }
            ln := st[25];
            adv(p, n, st);
            st[32] = 1;
            c := pexpr(p, n, st);
            st[32] = 0;
            b := pblock(p, n, st);
            sn = nnew(st, 24, c, b, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 13) {         // if
            sn = pif(p, n, st);
        }
        if sn == 0 && ck(st, 25) {         // match subj { arms } — the
            ln := st[25];                  // statement form
            adv(p, n, st);
            sn = pmatch(p, n, st, 0, 0, ln, 0, 0, 0, 0, 0);
        }
        if sn == 0 && ck(st, 28) {         // for name in a..b { }
            ln := st[25];
            adv(p, n, st);
            if !ck(st, 7) { perr(st); return 0; }
            fs2 := st[26];
            fl2 := st[27];
            adv(p, n, st);
            if !ck(st, 29) { perr(st); return 0; }   // 'in'
            adv(p, n, st);
            st[32] = 1;
            lo := pexpr(p, n, st);
            if !ck(st, 30) { perr(st); return 0; }   // '..'
            adv(p, n, st);
            hi := pexpr(p, n, st);
            st[32] = 0;
            b2 := pblock(p, n, st);
            sn = nnew(st, 30, lo, hi, b2, ln, fs2, fl2);
        }
        if sn == 0 {                       // expression, assignment, tail
            ln := st[25];
            h := pexpr(p, n, st);
            mut done := 0;
            if ck(st, 46) || ck(st, 52) || ck(st, 53) {
                mut op := 0;               // 0 '=', 1 '+=', 2 '-='
                if ck(st, 52) { op = 1; }
                if ck(st, 53) { op = 2; }
                adv(p, n, st);
                if ck(st, 25) {            // lhs = match subj { ... };
                    adv(p, n, st);
                    sn = pmatch(p, n, st, 1, 2, ln, 0, 0, op + 1, 0, h);
                    if !ck(st, 42) { perr(st); return 0; }
                    adv(p, n, st);
                    done = 1;
                }
                if done == 0 {
                    rhs2 := pexpr(p, n, st);
                    mut tf2 := 0;          // lhs = e?; — the try flag
                    if acc(p, n, st, 69) { tf2 = 1; }   // rides slot ss
                    if !ck(st, 42) { perr(st); return 0; }
                    adv(p, n, st);
                    sn = nnew(st, 21, h, rhs2, op, ln, tf2, 0);
                    done = 1;
                }
            }
            if done == 0 && acc(p, n, st, 69) {     // e? ;
                if !ck(st, 42) { perr(st); return 0; }
                adv(p, n, st);
                sn = nnew(st, 23, h, 0, 1, ln, 0, 0);
                done = 1;
            }
            if done == 0 && acc(p, n, st, 42) {     // e ; — ncc's news()
                sn = nnew(st, 23, h, 0, 0, st[25], 0, 0);   // runs AFTER
                done = 1;                  // the ';', so the stmt carries
            }                              // the NEXT token's line
            if done == 0 {                 // the block tail
                if !ck(st, 40) { perr(st); return 0; }
                adv(p, n, st);
                tail = h;
                istail = 1;
                going = false;
                continue;
            }
        }
        if sn == 0 { perr(st); return 0; }
        if first == 0 { first = sn; }
        if last > 0 {
            nd := st[33] as *i64;
            nd[last * 8 + 7] = sn;
        }
        last = sn;
        cnt = cnt + 1;
    }
    if istail == 0 { adv(p, n, st); }      // '}' (the tail path ate it)
    return nnew(st, 40, first, tail, cnt, bln, 0, 0);
}

// ---- items ------------------------------------------------------ //

// Params fill a caller-provided arena: name span + T, 6 words each.
// Returns the count. (parse.n's, unchanged.)
fn pparams(p: *u8, n: i64, st: *i64, ps: *i64) -> i64 {
    if !ck(st, 37) { perr(st); return 0; }
    adv(p, n, st);
    mut np := 0;
    mut more := !ck(st, 38);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return np; }
        ps[np * 6] = st[26];
        ps[np * 6 + 1] = st[27];
        adv(p, n, st);
        if !ck(st, 43) { perr(st); return np; }
        adv(p, n, st);
        t := pty(p, n, st);
        ps[np * 6 + 2] = t.pt;
        ps[np * 6 + 3] = t.us;
        ps[np * 6 + 4] = t.s;
        ps[np * 6 + 5] = t.l;
        np = np + 1;
        if acc(p, n, st, 41) { more = true; }
    }
    if !ck(st, 38) { perr(st); return np; }
    adv(p, n, st);
    return np;
}

// Skip one top-level item: advance to its opening '{', then count
// braces to the close. Safe: string-interpolation braces never
// tokenize as LB/RB. (parse.n's, unchanged.)
fn skip_item(p: *u8, n: i64, st: *i64) {
    mut going := true;
    while going {
        if ck(st, 0) { return; }
        if ck(st, 39) { going = false; continue; }
        adv(p, n, st);
    }
    adv(p, n, st);
    mut d := 1;
    while d > 0 {
        if ck(st, 0) { return; }
        if ck(st, 39) { d = d + 1; }
        if ck(st, 40) { d = d - 1; }
        adv(p, n, st);
    }
}

// struct Name { f: ty, ... } — parse.n's pstruct accreted back,
// transformed: fields land in the struct table instead of a D line.
// The own flag and the #[drop] span arrive from the item loop and
// land in the table: ownership is live (rung 10a), drop is 10c.
fn pstruct(p: *u8, n: i64, st: *i64, ow: i64, ds: i64, dl: i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    ns := st[26];
    nl := st[27];
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut nf := 0;
    mut more := !ck(st, 40);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return; }
        ps[nf * 6] = st[26];
        ps[nf * 6 + 1] = st[27];
        adv(p, n, st);
        if !ck(st, 43) { perr(st); return; }
        adv(p, n, st);
        t := pty(p, n, st);
        ps[nf * 6 + 2] = t.pt;
        ps[nf * 6 + 3] = t.us;
        ps[nf * 6 + 4] = t.s;
        ps[nf * 6 + 5] = t.l;
        nf = nf + 1;
        if acc(p, n, st, 41) {
            if !ck(st, 40) { more = true; }
        }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
    fst := st[36];
    mut q := 0;
    while q < nf {
        mut w := 0;
        while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
        q = q + 1;
    }
    sadd(st, ns, nl, nf, fst, ow, ds, dl);
}

// enum Name { V, W(f: ty, ...), ... } — parse.n's penum accreted
// back, transformed: variants and their payload fields land in the
// enum table instead of V/U lines.
#[caps(syscall)]
fn penum(p: *u8, n: i64, st: *i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    ns := st[26];
    nl := st[27];
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    vx := arena_alloc(1024) as *i64;          // variant scratch: 32 x 4
    mut nv := 0;
    mut more := !ck(st, 40);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return; }
        vs := st[26];
        vl := st[27];
        adv(p, n, st);
        mut nf := 0;
        if acc(p, n, st, 37) {             // optional named payload
            mut inner := true;
            while inner {
                inner = false;
                if !ck(st, 7) { perr(st); return; }
                ps[nf * 6] = st[26];
                ps[nf * 6 + 1] = st[27];
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return; }
                adv(p, n, st);
                t := pty(p, n, st);
                ps[nf * 6 + 2] = t.pt;
                ps[nf * 6 + 3] = t.us;
                ps[nf * 6 + 4] = t.s;
                ps[nf * 6 + 5] = t.l;
                nf = nf + 1;
                if acc(p, n, st, 41) { inner = true; }
            }
            if !ck(st, 38) { perr(st); return; }
            adv(p, n, st);
        }
        fst := st[36];                     // this variant's payload
        mut q := 0;                        // fields into the list arena
        while q < nf {
            mut w := 0;
            while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
            q = q + 1;
        }
        vx[nv * 4] = vs;
        vx[nv * 4 + 1] = vl;
        vx[nv * 4 + 2] = nf;
        vx[nv * 4 + 3] = fst;
        nv = nv + 1;
        if acc(p, n, st, 41) {
            if !ck(st, 40) { more = true; }
        }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
    vst := st[36];
    mut q2 := 0;
    while q2 < nv * 4 { ladd(st, vx[q2]); q2 = q2 + 1; }
    eadd(st, ns, nl, nv, vst);
}

// extern syscall { fn name(params) [-> ty] = NUM [;] ... } — each
// binding becomes a table record (no body).
fn pextern(p: *u8, n: i64, st: *i64, caps: i64, ps: *i64) {
    if !ck(st, 9) { perr(st); return; }    // 'syscall'
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut more := ck(st, 10);
    while more {
        more = false;
        adv(p, n, st);                     // 'fn'
        if !ck(st, 7) { perr(st); return; }
        xs := st[26];
        xl := st[27];
        adv(p, n, st);
        np := pparams(p, n, st, ps);
        mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
        if acc(p, n, st, 45) { rt = pty(p, n, st); }
        if !ck(st, 46) { perr(st); return; }
        adv(p, n, st);
        if !ck(st, 1) { perr(st); return; }
        xnum := st[26];                    // the syscall number (emitted
        adv(p, n, st);                     // in the wrapper bodies)
        if ck(st, 42) { adv(p, n, st); }   // optional ';'
        pst := st[36];
        mut q := 0;
        while q < np {                     // full 6-word param records
            mut w := 0;                    // (span + T), then 4 words of
            while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
            q = q + 1;                     // return type
        }
        ladd(st, rt.pt);
        ladd(st, rt.us);
        ladd(st, rt.s);
        ladd(st, rt.l);
        fadd(st, xs, xl, np, caps, 0, pst, 0, xnum);
        if ck(st, 10) { more = true; }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
}

// fn name(params) [-> ty] { body } — params copy into the list arena
// BEFORE the body parses (the body's own lists must not interleave),
// then the body tree and the table record.
fn pfn(p: *u8, n: i64, st: *i64, caps: i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    fs := st[26];
    fl := st[27];
    if cname_fn(p, st, fs, fl, st[25]) { return; }   // ncc dies at the
    adv(p, n, st);                                   // name — so do we
    np := pparams(p, n, st, ps);
    mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
    if acc(p, n, st, 45) { rt = pty(p, n, st); }
    pst := st[36];
    mut q := 0;
    while q < np {                         // full 6-word param records,
        mut w := 0;                        // then the return type — all
        while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
        q = q + 1;                         // BEFORE the body parses (its
    }                                      // lists must not interleave)
    ladd(st, rt.pt);
    ladd(st, rt.us);
    ladd(st, rt.s);
    ladd(st, rt.l);
    body := pblock(p, n, st);
    fadd(st, fs, fl, np, caps, body, pst, 1, 0);
}

// impl Name { fn m(self, p: ty...) [-> ty] { body } ... } — parse.n's
// pimpl accreted back, transformed: each method becomes a table
// record (self consumed here, excluded from the params, and seeded
// at check time — ncc's shape exactly).
fn pimpl(p: *u8, n: i64, st: *i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    ts := st[26];
    tl := st[27];
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut more := ck(st, 10);
    while more {
        more = false;
        adv(p, n, st);                     // 'fn'
        if !ck(st, 7) { perr(st); return; }
        ms := st[26];
        ml := st[27];
        adv(p, n, st);
        if !ck(st, 37) { perr(st); return; }
        adv(p, n, st);
        if !ck(st, 7) { perr(st); return; }    // 'self' leads (ncc
        adv(p, n, st);                     // validates the spelling)
        mut np := 0;
        mut inner := acc(p, n, st, 41);
        while inner {
            inner = false;
            if !ck(st, 7) { perr(st); return; }
            ps[np * 6] = st[26];
            ps[np * 6 + 1] = st[27];
            adv(p, n, st);
            if !ck(st, 43) { perr(st); return; }
            adv(p, n, st);
            t := pty(p, n, st);
            ps[np * 6 + 2] = t.pt;
            ps[np * 6 + 3] = t.us;
            ps[np * 6 + 4] = t.s;
            ps[np * 6 + 5] = t.l;
            np = np + 1;
            if acc(p, n, st, 41) { inner = true; }
        }
        if !ck(st, 38) { perr(st); return; }
        adv(p, n, st);
        mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
        if acc(p, n, st, 45) { rt = pty(p, n, st); }
        pst := st[36];
        mut q := 0;
        while q < np {
            mut w := 0;
            while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
            q = q + 1;
        }
        ladd(st, rt.pt);
        ladd(st, rt.us);
        ladd(st, rt.s);
        ladd(st, rt.l);
        body := pblock(p, n, st);
        madd(st, ts, tl, ms, ml, np, pst, body);
        if ck(st, 10) { more = true; }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
}

// ONE pass over the whole token stream — ncc's own shape. Externs,
// fns, structs, enums and impls all parse for real now.
fn pitems(p: *u8, n: i64, st: *i64, ps: *i64) {
    mut going := true;
    while going {
        if st[41] == 1 { going = false; continue; }   // a parse-time
        if ck(st, 0) { going = false; continue; }     // error already won
        mut caps := 0;                     // ncc's item order: caps,
        if acc(p, n, st, 32) { caps = 1; } // then fn/extern, then the
        if ck(st, 8) {                     // caps-on-anything-else
            adv(p, n, st);                 // refusal, then #[drop]/own
            pextern(p, n, st, caps, ps);
            continue;
        }
        if ck(st, 10) {
            adv(p, n, st);
            pfn(p, n, st, caps, ps);
            continue;
        }
        if caps == 1 {
            ln := st[25];
            put("{ln}: #[caps(syscall)] applies to a fn or an extern syscall block\n");
            st[41] = 1;
            going = false;
            continue;
        }
        mut ds := 0;
        mut dl := 0;
        mut hd := 0;
        if ck(st, 33) {                    // #[drop(fn)] — the lexer kept
            ds = st[26];                   // just the NAME's span; it
            dl = st[27];                   // goes to the struct table
            adv(p, n, st);
            hd = 1;
        }
        if hd == 1 && !ck(st, 36) {        // ncc's pexp(T_KW_OWN, ...):
            ln2 := st[25];                 // a destructor demands own
            put("{ln2}: expected 'own' after #[drop(...)] — only an own struct has a destructor\n");
            st[41] = 1;
            going = false;
            continue;
        }
        mut owi := 0;                      // 'own' — the table records it
        if acc(p, n, st, 36) { owi = 1; }
        if ck(st, 22) {                    // struct: a real parse
            adv(p, n, st);
            pstruct(p, n, st, owi, ds, dl, ps);
            continue;
        }
        if ck(st, 24) {                    // enum
            adv(p, n, st);
            penum(p, n, st, ps);
            continue;
        }
        if ck(st, 27) {                    // impl
            adv(p, n, st);
            pimpl(p, n, st, ps);
            continue;
        }
        perr(st);
        going = false;
    }
}

// ---- the checker ------------------------------------------------ //
// A walk over the tree with the live name table — ncc's discipline:
// the check runs statement by statement, names resolve at their
// textual position, the first error prints and the flag stops
// everything after it (ncc dies on its first error).

#[caps(syscall)]
fn cexpr(p: *u8, st: *i64, i: i64) {
    if st[41] == 1 { return; }
    if i == 0 { return; }
    nd := st[33] as *i64;
    al := st[35] as *i64;
    k := nd[i * 8];
    if k == 5 {                            // path: a predeclared
        if is_pfc(p, nd[i * 8 + 5], nd[i * 8 + 6]) >= 0 { return; }
        v := vfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);   // pageflags
        if v < 0 {                         // const passes; else resolve
            ln := nd[i * 8 + 4];
            fi0 := ffind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
            if fi0 >= 0 {                  // v0.24: a fn named without a
                ft0 := st[37] as *i64;     // call is a value of its fn
                if ft0[fi0 * 8 + 6] == 1 { return; }   // type; a syscall
                put("{ln}: syscall '");    // is not
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("' is not a value — only functions declared with fn are (v0.24)\n");
                st[41] = 1;
                return;
            }
            put("{ln}: undeclared variable '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("'\n");
            st[41] = 1;
        }
        if v >= 0 {                        // v0.17: no life after move
            va := st[39] as *i64;
            if va[v * 10 + 8] == 2 {
                ln2 := nd[i * 8 + 4];
                put("{ln2}: use of '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("' after move\n");
                st[41] = 1;
            }
        }
        return;
    }
    if k == 6 {                            // call
        cal := nd[i * 8 + 1];
        ln := nd[i * 8 + 4];
        na := nd[i * 8 + 3];
        if nd[cal * 8] == 5 {              // named callee: the fn table
            ab := is_argb(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if ab == 1 {                   // v0.23 builtin: not a fn, not
                if na != 0 {               // a syscall — checked before
                    put("{ln}: 'arg_count' takes 0 arguments, got {na}\n");
                    st[41] = 1;            // the table lookup (ncc's order)
                }
                return;
            }
            if ab == 2 {
                if na != 1 {
                    put("{ln}: 'arg' takes 1 argument, got {na}\n");
                    st[41] = 1;
                    return;
                }
                cexpr(p, st, al[nd[i * 8 + 2]]);
                if st[41] == 1 { return; }
                at9 := cinfer(p, st, al[nd[i * 8 + 2]]);
                if !tcompat(p, at9, t_i64(st)) {
                    put("{ln}: 'arg' index must be an integer, got ");
                    ty_put(p, st, at9);
                    put("\n");
                    st[41] = 1;
                }
                return;
            }
            lv := vfind(p, st, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if lv >= 0 {                   // v0.24: a local or parameter
                lt := vty(st, lv);         // of fn type, called through
                lfi := fnty_of(p, st, lt);
                if lfi < 0 {
                    put("{ln}: '");
                    put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                    put("' is not a function (it is ");
                    ty_put(p, st, lt);
                    put(")\n");
                    st[41] = 1;
                    return;
                }
                va0 := st[39] as *i64;
                if va0[lv * 10 + 8] == 2 {
                    put("{ln}: use of '");
                    put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                    put("' after move\n");
                    st[41] = 1;
                    return;
                }
                cfnvcall(p, st, i, lfi, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                return;
            }
            fi := ffind(p, st, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if fi < 0 {
                put("{ln}: unknown function '");
                put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                put("'\n");
                st[41] = 1;
                return;
            }
            ft := st[37] as *i64;
            if ft[fi * 8 + 6] == 0 && ft[fi * 8 + 3] == 1 && st[42] == 0 {
                put("{ln}: '");           // ncc's xfn_caps is XFNS-only:
                put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                put("' requires the syscall capability — mark the calling function #[caps(syscall)]\n");
                st[41] = 1;               // fn-to-fn calls never gate;
                return;                   // order: exists, caps, arity
            }
            np := ft[fi * 8 + 2];
            if na != np {
                put("{ln}: '");
                put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                put("' takes {np} argument(s), got {na}\n");
                st[41] = 1;
                return;
            }
            mut q := 0;
            while q < na {                 // per argument: resolve, then
                cexpr(p, st, al[nd[i * 8 + 2] + q]);   // type-check —
                if st[41] == 1 { return; } // ncc's per-arg order
                at := cinfer(p, st, al[nd[i * 8 + 2] + q]);
                pt2 := fpty(st, fi, q);
                if !tcompat(p, at, pt2) {
                    qq := q + 1;
                    put("{ln}: argument {qq} to '");
                    put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                    put("': expected ");
                    ty_put(p, st, pt2);
                    put(", got ");
                    ty_put(p, st, at);
                    put("\n");
                    st[41] = 1;
                    return;
                }
                cmove(p, st, al[nd[i * 8 + 2] + q], ln);   // v0.17
                if st[41] == 1 { return; }
                q = q + 1;
            }
            return;
        }
        if nd[cal * 8] == 7 {              // method call: recv resolves,
            cexpr(p, st, nd[cal * 8 + 1]); // then ncc's dispatch — the
            if st[41] == 1 { return; }     // lookup keys on the RECEIVER
            rt8 := cinfer(p, st, nd[cal * 8 + 1]);   // TYPE + the name
            mut mi := -1;
            if rt8.pt == 0 && rt8.l > 0 {
                mi = mfind(p, st, rt8.s, rt8.l, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            }
            if mi < 0 {
                ffi := field_fnty(p, st, rt8, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                if ffi >= 0 {              // v0.24: a fn field, called
                    cfnvcall(p, st, i, ffi, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                    return;                // through
                }
                put("{ln}: ");
                ty_put(p, st, rt8);
                put(" has no method '");
                put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                put("'\n");
                st[41] = 1;
                return;
            }
            ma := st[53] as *i64;
            mnp := ma[mi * 8 + 4];
            if na != mnp {
                put("{ln}: method '");
                put_span(p, ma[mi * 8], ma[mi * 8 + 1]);
                put(".");
                put_span(p, ma[mi * 8 + 2], ma[mi * 8 + 3]);
                put("' takes {mnp} argument(s), got {na}\n");
                st[41] = 1;
                return;
            }
            mut q3 := 0;
            while q3 < na {
                cexpr(p, st, al[nd[i * 8 + 2] + q3]);
                if st[41] == 1 { return; }
                at7 := cinfer(p, st, al[nd[i * 8 + 2] + q3]);
                pt3 := mpty(st, mi, q3);
                if !tcompat(p, at7, pt3) {
                    qq2 := q3 + 1;
                    put("{ln}: argument {qq2} to '");
                    put_span(p, ma[mi * 8], ma[mi * 8 + 1]);
                    put(".");
                    put_span(p, ma[mi * 8 + 2], ma[mi * 8 + 3]);
                    put("': expected ");
                    ty_put(p, st, pt3);
                    put(", got ");
                    ty_put(p, st, at7);
                    put("\n");
                    st[41] = 1;
                    return;
                }
                cmove(p, st, al[nd[i * 8 + 2] + q3], ln);  // v0.17
                if st[41] == 1 { return; }
                q3 = q3 + 1;
            }
            return;
        }
        cexpr(p, st, cal);                 // computed callee: recurse
        mut q2 := 0;
        while q2 < na {
            cexpr(p, st, al[nd[i * 8 + 2] + q2]);
            q2 = q2 + 1;
        }
        return;
    }
    if k == 7 {                            // field read: the variant-ref
        b1 := nd[i * 8 + 1];               // judgment FIRST (ncc's order
        ln2 := nd[i * 8 + 4];              // — the enum name must not
        if nd[b1 * 8] == 5 {               // resolve as a variable),
            ei1 := efind(p, st, nd[b1 * 8 + 5], nd[b1 * 8 + 6]);
            if ei1 >= 0 {                  // then base + the three arms
                vi0 := vfindx(p, st, ei1, nd[i * 8 + 5], nd[i * 8 + 6]);
                if vi0 < 0 {
                    put("{ln2}: enum '");
                    put_span(p, nd[b1 * 8 + 5], nd[b1 * 8 + 6]);
                    put("' has no variant '");
                    put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                    put("'\n");
                    st[41] = 1;
                    return;
                }
                ea0 := st[51] as *i64;
                if al[ea0[ei1 * 4 + 3] + vi0 * 4 + 2] != 0 {
                    put("{ln2}: variant '");
                    put_span(p, nd[b1 * 8 + 5], nd[b1 * 8 + 6]);
                    put(".");
                    put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                    put("' carries a payload — construct it with ");
                    put_span(p, nd[b1 * 8 + 5], nd[b1 * 8 + 6]);
                    put(".");
                    put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                    put("\{ ... \}\n");
                    st[41] = 1;
                    return;
                }
                return;
            }
        }
        cexpr(p, st, nd[i * 8 + 1]);
        if st[41] == 1 { return; }
        bt := cinfer(p, st, nd[i * 8 + 1]);
        if span_is(p, bt, st[44] + 7, 3) {
            isp := nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 112, 116, 114);
            isl := nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 108, 101, 110);
            if !isp && !isl {
                put("{ln2}: str has no field '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("' (only .ptr and .len)\n");
                st[41] = 1;
            }
            return;
        }
        if bt.pt == 0 && bt.l > 0 {
            si := sfind(p, st, bt.s, bt.l);
            if si >= 0 {
                sa := st[49] as *i64;
                mut ok := 0;
                mut q5 := 0;
                while q5 < sa[si * 8 + 2] {
                    r := sa[si * 8 + 3] + q5 * 6;
                    if span_eq(p, al[r], al[r + 1], nd[i * 8 + 5], nd[i * 8 + 6]) { ok = 1; }
                    q5 = q5 + 1;
                }
                if ok == 0 {
                    put("{ln2}: struct '");
                    put_span(p, bt.s, bt.l);
                    put("' has no field '");
                    put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                    put("'\n");
                    st[41] = 1;
                }
                return;
            }
        }
        put("{ln2}: ");
        ty_put(p, st, bt);
        put(" has no fields\n");
        st[41] = 1;
        return;
    }
    if k == 8 { cexpr(p, st, nd[i * 8 + 1]); return; }    // unary
    if k == 9 {                            // binary: operands resolve,
        cexpr(p, st, nd[i * 8 + 1]);       // then ncc's operand rules —
        cexpr(p, st, nd[i * 8 + 2]);       // pageflags, str, pointers,
        if st[41] == 1 { return; }         // integers, in that order
        lt := cinfer(p, st, nd[i * 8 + 1]);
        rt := cinfer(p, st, nd[i * 8 + 2]);
        c := nd[i * 8 + 3];
        ln8 := nd[i * 8 + 4];
        lpf := span_is(p, lt, st[44] + 28, 9);
        rpf := span_is(p, rt, st[44] + 28, 9);
        if lpf || rpf {                    // v0.13: '|' only, statically
            mut bd := 0;                   // known, and never W|X
            if !lpf || !rpf { bd = 1; }
            if c != 64 { bd = 1; }
            if bd == 1 {
                put("{ln8}: pageflags compose only with '|' between pageflags values (got ");
                ty_put(p, st, lt);
                put(" ");
                op_put(c);
                put(" ");
                ty_put(p, st, rt);
                put(")\n");
                st[41] = 1;
                return;
            }
            m := cpfmask(p, st, i);
            if m < 0 {
                put("{ln8}: compose pageflags from the PROT_* constants — a parameter's flags are opaque here (fixed at its call sites)\n");
                st[41] = 1;
                return;
            }
            if (m & 2) > 0 && (m & 4) > 0 {
                put("{ln8}: W^X violation: a mapping cannot be both writable and executable\n");
                st[41] = 1;
            }
            return;
        }
        lstr := span_is(p, lt, st[44] + 7, 3);
        rstr := span_is(p, rt, st[44] + 7, 3);
        if lstr || rstr {
            put("{ln8}: operator '");
            op_put(c);
            put("' cannot be applied to str values (build strings with interpolation)\n");
            st[41] = 1;
            return;
        }
        if lt.pt > 0 || rt.pt > 0 {        // pointers compare only
            iscmp := c == 54 || c == 55 || c == 56 || c == 57 || c == 58 || c == 59;
            mut okp := 0;
            if iscmp && lt.pt > 0 && rt.pt > 0 && tcompat(p, lt, rt) { okp = 1; }
            if okp == 0 {
                put("{ln8}: operator '");
                op_put(c);
                put("': pointers only support comparison against a compatible pointer (cast to addr for arithmetic)\n");
                st[41] = 1;
            }
            return;
        }
        if !is_int_ty(p, lt) || !is_int_ty(p, rt) {
            put("{ln8}: operator '");
            op_put(c);
            put("' expects integer operands (got ");
            ty_put(p, st, lt);
            put(" and ");
            ty_put(p, st, rt);
            put(")\n");
            st[41] = 1;
        }
        return;
    }
    if k == 10 {                           // cast: never INTO pageflags;
        cexpr(p, st, nd[i * 8 + 1]);       // pageflags cast OUT only to
        if st[41] == 1 { return; }         // an integer (for a syscall)
        ct := T{ pt: nd[i * 8 + 2], us: nd[i * 8 + 3], s: nd[i * 8 + 5], l: nd[i * 8 + 6] };
        if span_is(p, ct, st[44] + 28, 9) {
            ln9 := nd[i * 8 + 4];
            put("{ln9}: cannot cast into pageflags — build it from the PROT_* constants (the W^X proof needs static flag sets)\n");
            st[41] = 1;
            return;
        }
        sty2 := cinfer(p, st, nd[i * 8 + 1]);
        if span_is(p, sty2, st[44] + 28, 9) && !is_int_ty(p, ct) {
            ln10 := nd[i * 8 + 4];
            put("{ln10}: pageflags may only be cast to an integer type (for a syscall argument), got ");
            ty_put(p, st, ct);
            put("\n");
            st[41] = 1;
        }
        return;
    }
    if k == 13 {                           // index: base, then index,
        cexpr(p, st, nd[i * 8 + 1]);       // then ncc's two judgments —
        cexpr(p, st, nd[i * 8 + 2]);       // only pointers and str have
        if st[41] == 1 { return; }         // elements, and the index is
        bt := cinfer(p, st, nd[i * 8 + 1]);            // an integer
        if bt.pt == 0 && !span_is(p, bt, st[44] + 7, 3) {
            ln := nd[i * 8 + 4];
            put("{ln}: cannot index a ");
            ty_put(p, st, bt);
            put(" value (only pointers and str)\n");
            st[41] = 1;
            return;
        }
        it := cinfer(p, st, nd[i * 8 + 2]);
        if !is_int_ty(p, it) {
            ln2 := nd[i * 8 + 4];
            put("{ln2}: index must be an integer (got ");
            ty_put(p, st, it);
            put(")\n");
            st[41] = 1;
        }
        return;
    }
    if k == 4 {                            // interp: every hole resolves
        ln7 := nd[i * 8 + 4];              // and must interpolate (str or
        mut q3 := 0;                       // integer); a spec'd hole must
        while q3 < nd[i * 8 + 2] {         // be an integer — ncc's order
            hh := al[nd[i * 8 + 1] + q3 * 8 + 2];
            if hh == 0 { q3 = q3 + 1; continue; }   // a text fragment
            cexpr(p, st, hh);
            if st[41] == 1 { return; }
            ht := cinfer(p, st, hh);
            hstr := span_is(p, ht, st[44] + 7, 3);
            hint := is_int_ty(p, ht);
            if !hstr && !hint {
                put("{ln7}: cannot interpolate a ");
                ty_put(p, st, ht);
                put(" value (only str and integers)\n");
                st[41] = 1;
                return;
            }
            if al[nd[i * 8 + 1] + q3 * 8 + 3] == 1 && !hint {
                put("{ln7}: format specs apply to integers — a str interpolates as text\n");
                st[41] = 1;
                return;
            }
            q3 = q3 + 1;
        }
        return;
    }
    if k == 11 {                           // struct literal: ncc's order —
        ln3 := nd[i * 8 + 4];              // known struct, every declared
        na2 := nd[i * 8 + 3];              // field exactly once, no extra
        si2 := sfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);   // names, then
        if si2 < 0 {                       // per-value resolve + type
            put("{ln3}: unknown struct '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("'\n");
            st[41] = 1;
            return;
        }
        sa2 := st[49] as *i64;
        nf := sa2[si2 * 8 + 2];
        lst := nd[i * 8 + 1];
        mut q4 := 0;
        while q4 < nf {
            r2 := sa2[si2 * 8 + 3] + q4 * 6;
            mut seen := 0;
            mut j := 0;
            while j < na2 {
                if span_eq(p, al[lst + j * 3], al[lst + j * 3 + 1], al[r2], al[r2 + 1]) { seen = seen + 1; }
                j = j + 1;
            }
            if seen != 1 {
                put("{ln3}: literal for '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("' must initialize field '");
                put_span(p, al[r2], al[r2 + 1]);
                put("' exactly once\n");
                st[41] = 1;
                return;
            }
            q4 = q4 + 1;
        }
        if na2 != nf {
            put("{ln3}: literal for '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("' names a field it does not have\n");
            st[41] = 1;
            return;
        }
        mut j2 := 0;
        while j2 < na2 {
            vv := al[lst + j2 * 3 + 2];
            cexpr(p, st, vv);
            if st[41] == 1 { return; }
            at2 := cinfer(p, st, vv);
            mut dt := t_i64(st);
            mut q6 := 0;
            while q6 < nf {
                r3 := sa2[si2 * 8 + 3] + q6 * 6;
                if span_eq(p, al[r3], al[r3 + 1], al[lst + j2 * 3], al[lst + j2 * 3 + 1]) { dt = sfty(st, si2, q6); }
                q6 = q6 + 1;
            }
            if !tcompat(p, at2, dt) {
                put("{ln3}: field '");
                put_span(p, al[lst + j2 * 3], al[lst + j2 * 3 + 1]);
                put("' of '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("': expected ");
                ty_put(p, st, dt);
                put(", got ");
                ty_put(p, st, at2);
                put("\n");
                st[41] = 1;
                return;
            }
            if tyown(p, st, dt) {          // v0.25: construction moves the
                cmove(p, st, vv, ln3);     // field in
                if st[41] == 1 { return; }
            }
            j2 = j2 + 1;
        }
        return;
    }
    if k == 12 {                           // enum literal: ncc's order —
        ln6 := nd[i * 8 + 4];              // known enum, known variant,
        na6 := nd[i * 8 + 3];              // payload fields exactly once,
        ei2 := efind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
        if ei2 < 0 {                       // then per-value type
            put("{ln6}: unknown enum '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("'\n");
            st[41] = 1;
            return;
        }
        vi5 := vfindx(p, st, ei2, nd[i * 8 + 2], nd[i * 8 + 7]);
        if vi5 < 0 {
            put("{ln6}: enum '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("' has no variant '");
            put_span(p, nd[i * 8 + 2], nd[i * 8 + 7]);
            put("'\n");
            st[41] = 1;
            return;
        }
        ea3 := st[51] as *i64;
        vb := ea3[ei2 * 4 + 3];
        nf4 := al[vb + vi5 * 4 + 2];
        fs4 := al[vb + vi5 * 4 + 3];
        lst3 := nd[i * 8 + 1];
        mut q7 := 0;
        while q7 < nf4 {
            r4 := fs4 + q7 * 6;
            mut seen2 := 0;
            mut j3 := 0;
            while j3 < na6 {
                if span_eq(p, al[lst3 + j3 * 3], al[lst3 + j3 * 3 + 1], al[r4], al[r4 + 1]) { seen2 = seen2 + 1; }
                j3 = j3 + 1;
            }
            if seen2 != 1 {
                put("{ln6}: literal for '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put(".");
                put_span(p, nd[i * 8 + 2], nd[i * 8 + 7]);
                put("' must initialize field '");
                put_span(p, al[r4], al[r4 + 1]);
                put("' exactly once\n");
                st[41] = 1;
                return;
            }
            q7 = q7 + 1;
        }
        if na6 != nf4 {
            put("{ln6}: literal for '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put(".");
            put_span(p, nd[i * 8 + 2], nd[i * 8 + 7]);
            put("' names a field it does not have\n");
            st[41] = 1;
            return;
        }
        mut j4 := 0;
        while j4 < na6 {
            vv2 := al[lst3 + j4 * 3 + 2];
            cexpr(p, st, vv2);
            if st[41] == 1 { return; }
            at6 := cinfer(p, st, vv2);
            mut dt2 := t_i64(st);
            mut q8 := 0;
            while q8 < nf4 {
                r5 := fs4 + q8 * 6;
                if span_eq(p, al[r5], al[r5 + 1], al[lst3 + j4 * 3], al[lst3 + j4 * 3 + 1]) {
                    dt2 = T{ pt: al[r5 + 2], us: al[r5 + 3], s: al[r5 + 4], l: al[r5 + 5] };
                }
                q8 = q8 + 1;
            }
            if !tcompat(p, at6, dt2) {
                put("{ln6}: field '");
                put_span(p, al[lst3 + j4 * 3], al[lst3 + j4 * 3 + 1]);
                put("' of '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put(".");
                put_span(p, nd[i * 8 + 2], nd[i * 8 + 7]);
                put("': expected ");
                ty_put(p, st, dt2);
                put(", got ");
                ty_put(p, st, at6);
                put("\n");
                st[41] = 1;
                return;
            }
            j4 = j4 + 1;
        }
        return;
    }
}

// v0.10 `?` propagation — ncc's gen_try judgments, in ncc's order:
// the operand must be a result enum, the enclosing function must
// return one, different result enums must agree on the Err payload,
// and the binding forms need an Ok payload to bind (which then types
// the binding — the unwrap). form: 0 = `e?;`, 1 = `x := e?;`,
// 2 = `lhs = e?;` (which replays S_ASSIGN's checks on the payload).
#[caps(syscall)]
fn ctry(p: *u8, st: *i64, i: i64, form: i64) {
    nd := st[33] as *i64;
    al := st[35] as *i64;
    ea := st[51] as *i64;
    ln := nd[i * 8 + 4];
    mut opnd := nd[i * 8 + 1];
    if form == 2 { opnd = nd[i * 8 + 2]; }
    cexpr(p, st, opnd);
    if st[41] == 1 { return; }
    ot := cinfer(p, st, opnd);
    mut oe := -1;
    if ot.pt == 0 && ot.l > 0 { oe = efind(p, st, ot.s, ot.l); }
    mut ores := false;
    if oe >= 0 { ores = eresult(p, st, oe); }
    if !ores {
        put("{ln}: operand of '?' must be a result enum (exactly the variants Ok and Err), got ");
        ty_put(p, st, ot);
        put("\n");
        st[41] = 1;
        return;
    }
    rt7 := T{ pt: st[45], us: st[46], s: st[47], l: st[48] };
    mut re := -1;
    if rt7.pt == 0 && rt7.l > 0 { re = efind(p, st, rt7.s, rt7.l); }
    mut rres := false;
    if re >= 0 { rres = eresult(p, st, re); }
    if !rres {
        put("{ln}: '?' propagates by returning, so the function must return a result enum (it returns ");
        ty_put(p, st, rt7);
        put(")\n");
        st[41] = 1;
        return;
    }
    ovi := vfindx(p, st, oe, st[44] + 19, 2);    // Ok
    oei := vfindx(p, st, oe, st[44] + 21, 3);    // Err
    rei := vfindx(p, st, re, st[44] + 21, 3);
    same := span_eq(p, ea[oe * 4], ea[oe * 4 + 1], ea[re * 4], ea[re * 4 + 1]);
    if !same {                             // Err payloads must agree
        onf := al[ea[oe * 4 + 3] + oei * 4 + 2];
        rnf := al[ea[re * 4 + 3] + rei * 4 + 2];
        if onf != rnf {
            put("{ln}: cannot propagate: ");
            put_span(p, ea[oe * 4], ea[oe * 4 + 1]);
            put(".Err and ");
            put_span(p, ea[re * 4], ea[re * 4 + 1]);
            put(".Err disagree on carrying a payload\n");
            st[41] = 1;
            return;
        }
        if onf == 1 {
            or2 := al[ea[oe * 4 + 3] + oei * 4 + 3];
            rr2 := al[ea[re * 4 + 3] + rei * 4 + 3];
            oT := T{ pt: al[or2 + 2], us: al[or2 + 3], s: al[or2 + 4], l: al[or2 + 5] };
            rT := T{ pt: al[rr2 + 2], us: al[rr2 + 3], s: al[rr2 + 4], l: al[rr2 + 5] };
            if !tcompat(p, oT, rT) {
                put("{ln}: cannot propagate ");
                put_span(p, ea[oe * 4], ea[oe * 4 + 1]);
                put(".Err (");
                ty_put(p, st, oT);
                put(") as ");
                put_span(p, ea[re * 4], ea[re * 4 + 1]);
                put(".Err (");
                ty_put(p, st, rT);
                put(")\n");
                st[41] = 1;
                return;
            }
        }
    }
    oknf := al[ea[oe * 4 + 3] + ovi * 4 + 2];
    if form != 0 && oknf != 1 {
        put("{ln}: ");
        put_span(p, ea[oe * 4], ea[oe * 4 + 1]);
        put(".Ok carries no payload to bind — use the statement form `expr?;`\n");
        st[41] = 1;
        return;
    }
    mut okty := t_void();
    if oknf == 1 {
        orr := al[ea[oe * 4 + 3] + ovi * 4 + 3];
        okty = T{ pt: al[orr + 2], us: al[orr + 3], s: al[orr + 4], l: al[orr + 5] };
    }
    // The lhs executes only on Ok, so retain Err's post-operand state
    // before checking any moves in the assignment target.
    err_states := arena_alloc((st[40] + 1) * 8) as *i64;
    va_err := st[39] as *i64;
    mut err_index := 0;
    while err_index < st[40] {
        err_states[err_index] = va_err[err_index * 10 + 8];
        err_index = err_index + 1;
    }
    if form == 2 {                         // lhs = e?; — S_ASSIGN's own
        lhs3 := nd[i * 8 + 1];             // checks against the payload
        cexpr(p, st, lhs3);
        if st[41] == 1 { return; }
        mut r7 := lhs3;
        while nd[r7 * 8] == 7 { r7 = nd[r7 * 8 + 1]; }
        if nd[r7 * 8] == 13 {
            ibt3 := cinfer(p, st, nd[r7 * 8 + 1]);
            if span_is(p, ibt3, st[44] + 7, 3) {
                put("{ln}: cannot write through a str index — str is an immutable view of its text\n");
                st[41] = 1;
                return;
            }
        }
        if nd[r7 * 8] == 5 {
            v8 := vfind(p, st, nd[r7 * 8 + 5], nd[r7 * 8 + 6]);
            va3 := st[39] as *i64;
            if v8 >= 0 && va3[v8 * 10 + 2] == 0 {
                put("{ln}: cannot assign to immutable '");
                put_span(p, nd[r7 * 8 + 5], nd[r7 * 8 + 6]);
                put("' (declare it with 'mut')\n");
                st[41] = 1;
                return;
            }
        }
        lt4 := cinfer(p, st, lhs3);
        if !tcompat(p, okty, lt4) {
            put("{ln}: cannot assign ");
            ty_put(p, st, okty);
            put(" to a ");
            ty_put(p, st, lt4);
            put(" target\n");
            st[41] = 1;
            return;
        }
        aop3 := nd[i * 8 + 3];
        if aop3 != 0 && !is_int_ty(p, lt4) {
            put("{ln}: '");
            if aop3 == 1 { put("+="); }
            if aop3 == 2 { put("-="); }
            put("' requires an integer target (got ");
            ty_put(p, st, lt4);
            put(")\n");
            st[41] = 1;
        }
        if st[41] == 1 { return; }
    }
    // Err exits with normal return cleanup. Its drops must not mark
    // values moved on the continuing Ok path, or hide an Err-path leak.
    va := st[39] as *i64;
    states := arena_alloc((st[40] + 1) * 8) as *i64;
    mut j := 0;
    while j < st[40] {
        states[j] = va[j * 10 + 8];
        va[j * 10 + 8] = err_states[j];
        j = j + 1;
    }
    cdrops(p, st, 0);
    cheld(p, st, ln);
    cleak(p, st, 0, ln, 0);
    j = 0;
    while j < st[40] { va[j * 10 + 8] = states[j]; j = j + 1; }
    if st[41] == 1 { return; }
    if form == 1 {                         // x := e?; — bind the payload
        vadd(st, nd[i * 8 + 5], nd[i * 8 + 6], nd[i * 8 + 3], okty);
    }
}

#[caps(syscall)]
fn cstmt(p: *u8, st: *i64, i: i64) {
    if st[41] == 1 { return; }
    if i == 0 { return; }
    nd := st[33] as *i64;
    k := nd[i * 8];
    if k == 20 && nd[i * 8 + 2] == 1 {     // try statements route whole
        ctry(p, st, i, 1);                 // (ncc's gen_stmt does the
        return;                            // same before its switch)
    }
    if k == 21 && nd[i * 8 + 5] == 1 {
        ctry(p, st, i, 2);
        return;
    }
    if k == 23 && nd[i * 8 + 3] == 1 {
        ctry(p, st, i, 0);
        return;
    }
    if k == 20 {                           // let: check the rhs, infer
        cexpr(p, st, nd[i * 8 + 1]);       // its type, then bind
        if st[41] == 1 { return; }
