        cblock(p, st, nd[i * 8 + 2]);
        mut j2 := 0;
        while j2 < n0 {
            sb[n0 + j2] = va7[j2 * 10 + 8];    // thn[] = the then exit;
            va7[j2 * 10 + 8] = sb[j2];         // the else arm starts from
            j2 = j2 + 1;                       // pre again
        }
        els := nd[i * 8 + 3];
        mut er := 0;
