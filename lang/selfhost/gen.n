            put("{ln7}: cannot bind '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("': the function type ");
            ty_put(p, st, rt2);
            put(" is declared nowhere in this program — pass the function as an argument, or store it in a field, of that type\n");
            st[41] = 1;
            return;
        }
