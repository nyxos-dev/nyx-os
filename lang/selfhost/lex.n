// lex.n — ncc's lexer, rewritten in N. The first module of the
// self-host ladder (lex -> parse -> check -> gen; see
// ../docs/selfhost.md, "The mountain after the toy").
//
// THE CONTRACT IS DIFFERENTIAL: this program prints one "kind line"
// pair per token — ncc's exact kind numbers, T_EOF included — and its
// output must be byte-identical to `ncc --tokens` over the same file.
// The diff is the test; an empty diff is the proof.
//
// The stream carries LEXEMES now (rung 2): identifiers and #[drop]
// names echo their source spans verbatim, integers their PARSED value
// (hex and '_' normalized — ncc's own accumulation), string segments
// their processed byte COUNT (bodies hold control bytes, so they are
// counted, not printed — and the count still pins the escape rules,
// since a miscounted escape shifts every line after it).
// Errors return kind -1 and stop the stream; differential targets are
// valid sources, so -1 in a diff means the lexer itself is wrong.
//
// The target: `nlex file.n` (v0.23 argv), falling back to the fixed
// /tmp/n_lex_target.n the harness copies each source into.
//
// State lives in one sbrk'd word block, threaded as a single pointer:
//   st[0] pos     st[1] line    st[2] itop (-1 = none)
//   st[3] brace_depth   st[4] resume_str   st[5] token line (out)
//   st[6] lexeme: value / span start (out)   st[7] span len (out)
//   st[8..23] the interpolation brace stack (16 deep, ncc's cap)

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_exit(code: i64) -> never                       = 0
    fn sys_open(path: *u8, flags: i64, mode: i64) -> i64   = 3
    fn sys_read(fd: i64, buf: *u8, len: isize) -> i64      = 4
    fn sys_close(fd: i64) -> i64                           = 5
    fn sys_sbrk(incr: i64) -> i64                          = 7
}

#[caps(syscall)]
fn put_bytes(p: *u8, len: i64) {
    mut sent := 0;
    while sent < len {
        left := len - sent;
        n := write(1, (p as addr + sent as addr) as #[user] *u8, left as isize);
        if n <= 0 || n > left {
            // Best-effort diagnostic; exit must not depend on stderr working.
            error := "nlex: output write failed\n";
            write(2, error.ptr as #[user] *u8, error.len as isize);
            sys_exit(1);
        }
        sent = sent + n;
    }
}

#[caps(syscall)]
fn put(s: str) {
    put_bytes(s.ptr as *u8, s.len as i64);
}

fn is_idc(b: i64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_dg(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn is_hx(b: i64) -> bool {
    return is_dg(b) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

fn hxv(d: i64) -> i64 {
    if is_dg(d) { return d - 48; }
    if d >= 97 { return d - 87; }          // a-f
    return d - 55;                         // A-F
}

// Byte-compare helpers, one per span length — N has no char literals,
// so keywords are spelled in ASCII numbers (the interning pattern the
// toy proved, at the real keyword table's scale).
fn eq2(p: *u8, s: i64, a: i64, b: i64) -> bool {
    return p[s] as i64 == a && p[s + 1] as i64 == b;
}

fn eq3(p: *u8, s: i64, a: i64, b: i64, c: i64) -> bool {
    return eq2(p, s, a, b) && p[s + 2] as i64 == c;
}

fn eq4(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64) -> bool {
    return eq3(p, s, a, b, c) && p[s + 3] as i64 == d;
}

fn eq5(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> bool {
    return eq4(p, s, a, b, c, d) && p[s + 4] as i64 == e;
}

fn eq6(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> bool {
    return eq5(p, s, a, b, c, d, e) && p[s + 5] as i64 == f;
}

fn eq7(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> bool {
    return eq6(p, s, a, b, c, d, e, f) && p[s + 6] as i64 == g;
}

fn eq8(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> bool {
    return eq7(p, s, a, b, c, d, e, f, g) && p[s + 7] as i64 == h;
}

// ncc's keyword table (ncc.c kwlook), length-gated: an identifier span
// either spells one of the 22 keywords or is T_IDENT (7). The kind
// numbers are ncc's enum order — held to it by the differential.
fn kwlook(p: *u8, s: i64, n: i64) -> i64 {
    if n == 2 {
        if eq2(p, s, 102, 110) { return 10; }             // fn
        if eq2(p, s, 97, 115) { return 18; }              // as
        if eq2(p, s, 105, 102) { return 13; }             // if
        if eq2(p, s, 105, 110) { return 29; }             // in
    }
    if n == 3 {
        if eq3(p, s, 109, 117, 116) { return 11; }        // mut
        if eq3(p, s, 114, 97, 119) { return 19; }         // raw
        if eq3(p, s, 102, 111, 114) { return 28; }        // for
        if eq3(p, s, 111, 119, 110) { return 36; }        // own
    }
    if n == 4 {
        if eq4(p, s, 101, 108, 115, 101) { return 14; }   // else
        if eq4(p, s, 116, 114, 117, 101) { return 20; }   // true
        if eq4(p, s, 101, 110, 117, 109) { return 24; }   // enum
        if eq4(p, s, 105, 109, 112, 108) { return 27; }   // impl
    }
    if n == 5 {
        if eq5(p, s, 119, 104, 105, 108, 101) { return 15; }   // while
        if eq5(p, s, 98, 114, 101, 97, 107) { return 16; }     // break
        if eq5(p, s, 102, 97, 108, 115, 101) { return 21; }    // false
        if eq5(p, s, 100, 101, 102, 101, 114) { return 23; }   // defer
        if eq5(p, s, 109, 97, 116, 99, 104) { return 25; }     // match
    }
    if n == 6 {
        if eq6(p, s, 101, 120, 116, 101, 114, 110) { return 8; }    // extern
        if eq6(p, s, 115, 116, 114, 117, 99, 116) { return 22; }    // struct
        if eq6(p, s, 114, 101, 116, 117, 114, 110) { return 12; }   // return
    }
    if n == 7 {
        if eq7(p, s, 115, 121, 115, 99, 97, 108, 108) { return 9; } // syscall
    }
    if n == 8 {
        if eq8(p, s, 99, 111, 110, 116, 105, 110, 117, 101) { return 17; }  // continue
    }
    return 7;                              // T_IDENT
}

// ncc's scan_string_body, advance-only: scan to the closing quote
// (T_STR 2 / T_STR_TAIL 5) or an interpolation hole's '{' (T_STR_HEAD
// 3 / T_STR_MID 4, pushing the brace depth on the stack), processing
// escapes positionally. cont = 1 when resuming after a hole.
fn scan_string(p: *u8, n: i64, st: *i64, cont: i64) -> i64 {
    st[5] = st[1];
    mut cnt := 0;                          // processed-body byte count
    mut going := true;
    while going {
        if st[0] >= n { return -1; }       // unterminated string
        b := p[st[0]] as i64;
        if b == 34 {                       // the closing quote
            st[0] = st[0] + 1;
            st[6] = cnt;
            if cont == 1 { return 5; }
            return 2;
        }
        if b == 123 {                      // a hole opens: push and hand
            st[0] = st[0] + 1;             // the stream to the expression
            if st[2] + 1 >= 16 { return -1; }   // interpolation too deep
            st[2] = st[2] + 1;
            st[8 + st[2]] = st[3];
            st[6] = cnt;
            if cont == 1 { return 4; }
            return 3;
        }
        if b == 92 {                       // an escape: validate + skip,
            st[0] = st[0] + 1;             // one processed byte
            if st[0] >= n { return -1; }
            e := p[st[0]] as i64;
            st[0] = st[0] + 1;
            ok := e == 110 || e == 116 || e == 114 || e == 48 || e == 92
               || e == 34 || e == 39 || e == 123 || e == 125;
            if !ok { return -1; }          // bad escape
            cnt = cnt + 1;
            continue;
        }
        if b == 10 { st[1] = st[1] + 1; }
        cnt = cnt + 1;
        st[0] = st[0] + 1;
    }
    0
}

// ncc's next_token, kind-and-line only. Every branch mirrors the C
// original: the whitespace/comment skip (nested block comments,
// depth-counted), identifiers through the keyword table, integers
// (hex + '_' separators), strings + the interpolation resume, the
// full operator switch, and the three attributes.
fn next_kind(p: *u8, n: i64, st: *i64) -> i64 {
    if st[4] == 1 {                        // '}' closed a hole: resume
        st[4] = 0;                         // scanning the string body
        return scan_string(p, n, st, 1);
    }
    mut b := 0;
    mut scanning := true;
    while scanning {                       // whitespace + comments
        if st[0] >= n { st[5] = st[1]; return 0; }   // T_EOF
        b = p[st[0]] as i64;
        if b == 32 || b == 9 || b == 13 { st[0] = st[0] + 1; continue; }
        if b == 10 { st[0] = st[0] + 1; st[1] = st[1] + 1; continue; }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
            while st[0] < n && p[st[0]] as i64 != 10 { st[0] = st[0] + 1; }
            continue;
        }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
            mut d := 1;                    // nested block comments,
            st[0] = st[0] + 2;             // depth-counted like ncc's
            while st[0] < n && d > 0 {
                c := p[st[0]] as i64;
                if c == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
                    d = d + 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 42 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
                    d = d - 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 10 { st[1] = st[1] + 1; }
                st[0] = st[0] + 1;
            }
            continue;
        }
        scanning = false;
    }
    st[5] = st[1];                         // the token starts here
    if is_idc(b) {
        s := st[0];
        while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
            st[0] = st[0] + 1;
        }
        st[6] = s;                         // the span, for T_IDENT's
        st[7] = st[0] - s;                 // lexeme echo
        return kwlook(p, s, st[0] - s);
    }
    if is_dg(b) {
        mut v := 0;
        if b == 48 && st[0] + 1 < n && p[st[0] + 1] as i64 == 120 {
            st[0] = st[0] + 2;             // 0x hex, '_' separators
            while st[0] < n && (is_hx(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
                d := p[st[0]] as i64;
                if d != 95 { v = v * 16 + hxv(d); }
                st[0] = st[0] + 1;
            }
            st[6] = v;
            return 1;
        }
        while st[0] < n && (is_dg(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
            d := p[st[0]] as i64;
            if d != 95 { v = v * 10 + (d - 48); }
            st[0] = st[0] + 1;
        }
        st[6] = v;
        return 1;                          // T_INT
    }
    if b == 34 {                           // a string opens
        st[0] = st[0] + 1;
        return scan_string(p, n, st, 0);
    }
    st[0] = st[0] + 1;                     // the operator switch: b is
    mut b2 := 0;                           // consumed, b2 peeks ahead
    if st[0] < n { b2 = p[st[0]] as i64; }
    if b == 40 { return 37; }              // (
    if b == 41 { return 38; }              // )
    if b == 44 { return 41; }              // ,
    if b == 59 { return 42; }              // ;
    if b == 46 {                           // . or ..
        if b2 == 46 { st[0] = st[0] + 1; return 30; }
        return 68;
    }
    if b == 91 { return 34; }              // [
    if b == 93 { return 35; }              // ]
    if b == 63 { return 69; }              // ?
    if b == 94 { return 65; }              // ^
    if b == 37 { return 51; }              // %
    if b == 42 { return 49; }              // *
    if b == 47 { return 50; }              // /
    if b == 123 {                          // { tracks depth for the
        st[3] = st[3] + 1;                 // interpolation stack
        return 39;
    }
    if b == 125 {                          // } — a hole's closer when
        if st[2] >= 0 && st[3] == st[8 + st[2]] {   // the depths match:
            st[2] = st[2] - 1;             // pop, arm the resume, and
            st[4] = 1;                     // emit T_INTERP_R
            return 6;
        }
        st[3] = st[3] - 1;
        return 40;
    }
    if b == 58 {                           // : or :=
        if b2 == 61 { st[0] = st[0] + 1; return 44; }
        return 43;
    }
    if b == 45 {                           // - or -> or -=
        if b2 == 62 { st[0] = st[0] + 1; return 45; }
        if b2 == 61 { st[0] = st[0] + 1; return 53; }
        return 48;
    }
    if b == 43 {                           // + or +=
        if b2 == 61 { st[0] = st[0] + 1; return 52; }
        return 47;
    }
    if b == 61 {                           // = or == or =>
        if b2 == 61 { st[0] = st[0] + 1; return 54; }
        if b2 == 62 { st[0] = st[0] + 1; return 26; }
        return 46;
    }
    if b == 33 {                           // ! or !=
        if b2 == 61 { st[0] = st[0] + 1; return 55; }
        return 60;
    }
    if b == 60 {                           // < or <= or <<
        if b2 == 61 { st[0] = st[0] + 1; return 57; }
        if b2 == 60 { st[0] = st[0] + 1; return 66; }
        return 56;
    }
    if b == 62 {                           // > or >= or >>
        if b2 == 61 { st[0] = st[0] + 1; return 59; }
        if b2 == 62 { st[0] = st[0] + 1; return 67; }
        return 58;
    }
    if b == 38 {                           // & or &&
        if b2 == 38 { st[0] = st[0] + 1; return 61; }
        return 63;
    }
    if b == 124 {                          // | or ||
        if b2 == 124 { st[0] = st[0] + 1; return 62; }
        return 64;
    }
    if b == 35 {                           // the three attributes,
        if st[0] + 6 <= n && eq6(p, st[0], 91, 117, 115, 101, 114, 93) {
            st[0] = st[0] + 6;             // matched as exact spans
            return 31;                     // #[user]
        }
        if st[0] + 15 <= n && eq8(p, st[0], 91, 99, 97, 112, 115, 40, 115, 121)
            && eq7(p, st[0] + 8, 115, 99, 97, 108, 108, 41, 93) {
            st[0] = st[0] + 15;
            return 32;                     // #[caps(syscall)]
        }
        if st[0] + 6 <= n && eq6(p, st[0], 91, 100, 114, 111, 112, 40) {
            st[0] = st[0] + 6;             // #[drop(fn)]
            s2 := st[0];                   // the fn name's span starts
            mut got := false;
            while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
                st[0] = st[0] + 1;
                got = true;
            }
            if !got { return -1; }
            if st[0] + 2 > n { return -1; }
            if !(p[st[0]] as i64 == 41 && p[st[0] + 1] as i64 == 93) { return -1; }
            st[6] = s2;                    // echoed like an ident's
            st[7] = st[0] - s2;
            st[0] = st[0] + 2;
            return 33;
        }
        return -1;                         // unknown attribute
    }
    return -1;                             // unexpected character
}

// One dump line per token: kind + line, plus the lexeme where one
// exists. The format is ncc --tokens', character for character.
#[caps(syscall)]
fn dump_tok(p: *u8, st: *i64, k: i64) {
    l := st[5];
    if k == 7 || k == 33 {                 // ident / #[drop] name: the
        put("{k} {l} ");                   // source span, verbatim
        put_bytes((p as addr + st[6] as addr) as *u8, st[7]);
        put("\n");
        return;
    }
    if k == 1 {                            // int: the parsed value
        v := st[6];
        put("{k} {l} {v}\n");
        return;
    }
    if k >= 2 && k <= 5 {                  // string segment: the count
        c := st[6];
        put("{k} {l} #{c}\n");
        return;
    }
    put("{k} {l}\n");
}

#[caps(syscall)]
fn main() -> i64 {
    mut path := "/tmp/n_lex_target.n";     // the harness convention is
    if arg_count() > 1 { path = arg(1); }  // the FALLBACK; `nlex file.n`
                                           // names a target (v0.23 argv)
    fd := sys_open(path.ptr as *u8, 0, 0);
    if fd < 0 {
        if arg_count() > 1 {
            put("nlex: cannot open {path}\n");
            return 1;
        }
        put("(no lex target - skipped)\n");
        return 0;
    }
    // The source allocation and the accepted input limit are both 256 KiB.
    memory := sys_sbrk(262144);
    if memory < 0 {
        sys_close(fd);
        put("nlex: cannot allocate input buffer\n");
        return 1;
    }
    buf := memory as *u8;
    limit := 262144;
    mut total := 0;
    mut reading := true;
    while reading {
        mut count := limit - total;
        if count > 16384 { count = 16384; }
        mut target := (buf as addr + total as addr) as *u8;
        // At the exact limit, probe EOF using one byte INSIDE the buffer.
        // An extra byte may overwrite buf[0] only on the rejected path.
        if count == 0 { target = buf; count = 1; }
        r := sys_read(fd, target, count as isize);
        if r < 0 {
            sys_close(fd);
            put("nlex: cannot read {path}\n");
            return 1;
        }
        if r == 0 { reading = false; }
        else {
            if total == limit {
                sys_close(fd);
                put("nlex: input exceeds {limit} bytes: {path}\n");
                return 1;
            }
            total = total + r;
        }
    }
    sys_close(fd);
    if total < 1 { return 0; }
    st := sys_sbrk(256) as *i64;
    st[0] = 0;                             // pos
    st[1] = 1;                             // line
    st[2] = -1;                            // itop: no holes open
    st[3] = 0;                             // brace depth
    st[4] = 0;                             // resume flag
    mut k := 1;
    mut going := true;
    while going {
        k = next_kind(buf, total, st);
        dump_tok(buf, st, k);
        if k < 1 { going = false; }        // T_EOF (or -1) ends the dump
    }
    0
}
