// parse.n — ncc's parser, rewritten in N. The second module of the
// self-host ladder (lex -> parse -> check -> gen; see
// ../docs/selfhost.md, "The mountain after the toy").
//
// THE CHAIN ACCRETES: this file CONTAINS its lexer — the functions of
// lex.n, carried forward the way each link of the toy chain carried
// its predecessors (N has no modules; ncc itself is one file). lex.n
// stays frozen as the lexer's differential artifact; the lexer here
// is the same code wearing a token WINDOW (CUR + NEXT, ncc's own
// one-token lookahead plus the peek2 that tells `x := e` from an
// expression statement).
//
// THE CONTRACT IS DIFFERENTIAL: this program prints the POSTORDER
// tree dump `ncc --ast` prints — children before parents, one line
// per node, `nil` for absent slots, types as ptrs:is_user:name — and
// its output must be byte-identical over every claimed target. The
// trick that makes rung 1 small: recursive descent IS a postorder
// walk, so the parser PRINTS AS IT PARSES and no tree is stored at
// all. (When check.n needs a real tree, one materializes — that is
// its rung, not this one.)
//
// Coverage (rungs 1+2): everything but `impl` — extern blocks,
// struct and enum DECLARATIONS (with #[drop]/own), functions, every
// statement form (let/assign/return/expr, while, if-else-if, defer,
// break/continue, `match` in all four positions — statement, `:=`,
// `=`, `return` — and `for`), `?` propagation, block tails, and the
// whole expression ladder — and `impl` blocks: methods (self first,
// then params) dump as M lines after the F section, ncc's METHODS
// table mirrored by a fifth pass. An unsupported construct
// prints a PARSE-ERR line; differential targets are valid sources
// inside the coverage, so PARSE-ERR in a diff means the parser is
// wrong.
//
// THE ORDER PROBLEM, solved by MULTI-PASS: ncc dumps by category —
// all D lines, then V/U, then X, then the F sections — but sources
// interleave declarations freely (the toy nparse.n declares structs
// mid-file). Rather than buffering dump text (string building is the
// one thing N makes hard), parse.n reads the file FOUR times: pass 1
// prints only struct D lines, pass 2 enums, pass 3 extern X lines,
// pass 4 the function bodies and F lines — each pass SKIPS the other
// items by brace counting, which is safe because a string's braces
// never tokenize (a hole's close is T_INTERP_R, not T_RB), so LB/RB
// counts balance. Four cheap scans buy ncc's exact dump order with
// zero stored text.
//
// The target: `nparse file.n` (v0.23 argv), falling back to the fixed
// /tmp/n_parse_target.n the harness copies each source into.
//
// State lives in one sbrk'd word block:
//   st[0] pos     st[1] line    st[2] itop (-1 = none)
//   st[3] brace_depth   st[4] resume_str   st[5] token line (out)
//   st[6] lexeme: value / span start (out)   st[7] span len (out)
//   st[8..23] the interpolation brace stack (16 deep)
//   st[24..27] CUR token: kind, line, value/start, len
//   st[28..31] NEXT token: kind, line, value/start, len
//   st[32] NO_SLIT (ncc's flag: '{' after a condition opens the body)

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_open(path: *u8, flags: i64, mode: i64) -> i64   = 3
    fn sys_read(fd: i64, buf: *u8, len: isize) -> i64      = 4
    fn sys_close(fd: i64) -> i64                           = 5
    fn sys_sbrk(incr: i64) -> i64                          = 7
}

#[caps(syscall)]
fn put(s: str) {
    write(1, s.ptr as #[user] *u8, s.len as isize);
}

// Write buf[s .. s+l) — the span echo, from lex.n's dump.
#[caps(syscall)]
fn put_span(p: *u8, s: i64, l: i64) {
    write(1, (p as addr + s as addr) as #[user] *u8, l as isize);
}

fn is_idc(b: i64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_dg(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn is_hx(b: i64) -> bool {
    return is_dg(b) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

fn hxv(d: i64) -> i64 {
    if is_dg(d) { return d - 48; }
    if d >= 97 { return d - 87; }          // a-f
    return d - 55;                         // A-F
}

fn eq2(p: *u8, s: i64, a: i64, b: i64) -> bool {
    return p[s] as i64 == a && p[s + 1] as i64 == b;
}

fn eq3(p: *u8, s: i64, a: i64, b: i64, c: i64) -> bool {
    return eq2(p, s, a, b) && p[s + 2] as i64 == c;
}

fn eq4(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64) -> bool {
    return eq3(p, s, a, b, c) && p[s + 3] as i64 == d;
}

fn eq5(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> bool {
    return eq4(p, s, a, b, c, d) && p[s + 4] as i64 == e;
}

fn eq6(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> bool {
    return eq5(p, s, a, b, c, d, e) && p[s + 5] as i64 == f;
}

fn eq7(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> bool {
    return eq6(p, s, a, b, c, d, e, f) && p[s + 6] as i64 == g;
}

fn eq8(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> bool {
    return eq7(p, s, a, b, c, d, e, f, g) && p[s + 7] as i64 == h;
}

// ncc's keyword table (the lex.n copy, unchanged).
fn kwlook(p: *u8, s: i64, n: i64) -> i64 {
    if n == 2 {
        if eq2(p, s, 102, 110) { return 10; }             // fn
        if eq2(p, s, 97, 115) { return 18; }              // as
        if eq2(p, s, 105, 102) { return 13; }             // if
        if eq2(p, s, 105, 110) { return 29; }             // in
    }
    if n == 3 {
        if eq3(p, s, 109, 117, 116) { return 11; }        // mut
        if eq3(p, s, 114, 97, 119) { return 19; }         // raw
        if eq3(p, s, 102, 111, 114) { return 28; }        // for
        if eq3(p, s, 111, 119, 110) { return 36; }        // own
    }
    if n == 4 {
        if eq4(p, s, 101, 108, 115, 101) { return 14; }   // else
        if eq4(p, s, 116, 114, 117, 101) { return 20; }   // true
        if eq4(p, s, 101, 110, 117, 109) { return 24; }   // enum
        if eq4(p, s, 105, 109, 112, 108) { return 27; }   // impl
    }
    if n == 5 {
        if eq5(p, s, 119, 104, 105, 108, 101) { return 15; }   // while
        if eq5(p, s, 98, 114, 101, 97, 107) { return 16; }     // break
        if eq5(p, s, 102, 97, 108, 115, 101) { return 21; }    // false
        if eq5(p, s, 100, 101, 102, 101, 114) { return 23; }   // defer
        if eq5(p, s, 109, 97, 116, 99, 104) { return 25; }     // match
    }
    if n == 6 {
        if eq6(p, s, 101, 120, 116, 101, 114, 110) { return 8; }    // extern
        if eq6(p, s, 115, 116, 114, 117, 99, 116) { return 22; }    // struct
        if eq6(p, s, 114, 101, 116, 117, 114, 110) { return 12; }   // return
    }
    if n == 7 {
        if eq7(p, s, 115, 121, 115, 99, 97, 108, 108) { return 9; } // syscall
    }
    if n == 8 {
        if eq8(p, s, 99, 111, 110, 116, 105, 110, 117, 101) { return 17; }  // continue
    }
    return 7;                              // T_IDENT
}

// The lex.n scanner pair, unchanged: scan_string + next_kind.
fn scan_string(p: *u8, n: i64, st: *i64, cont: i64) -> i64 {
    st[5] = st[1];
    mut cnt := 0;                          // processed-body byte count
    mut going := true;
    while going {
        if st[0] >= n { return -1; }       // unterminated string
        b := p[st[0]] as i64;
        if b == 34 {                       // the closing quote
            st[0] = st[0] + 1;
            st[6] = cnt;
            if cont == 1 { return 5; }
            return 2;
        }
        if b == 123 {                      // a hole opens: push and hand
            st[0] = st[0] + 1;             // the stream to the expression
            if st[2] + 1 >= 16 { return -1; }   // interpolation too deep
            st[2] = st[2] + 1;
            st[8 + st[2]] = st[3];
            st[6] = cnt;
            if cont == 1 { return 4; }
            return 3;
        }
        if b == 92 {                       // an escape: validate + skip,
            st[0] = st[0] + 1;             // one processed byte
            if st[0] >= n { return -1; }
            e := p[st[0]] as i64;
            st[0] = st[0] + 1;
            ok := e == 110 || e == 116 || e == 114 || e == 48 || e == 92
               || e == 34 || e == 39 || e == 123 || e == 125;
            if !ok { return -1; }          // bad escape
            cnt = cnt + 1;
            continue;
        }
        if b == 10 { st[1] = st[1] + 1; }
        cnt = cnt + 1;
        st[0] = st[0] + 1;
    }
    0
}

fn next_kind(p: *u8, n: i64, st: *i64) -> i64 {
    if st[4] == 1 {                        // '}' closed a hole: resume
        st[4] = 0;
        return scan_string(p, n, st, 1);
    }
    mut b := 0;
    mut scanning := true;
    while scanning {                       // whitespace + comments
        if st[0] >= n { st[5] = st[1]; return 0; }   // T_EOF
        b = p[st[0]] as i64;
        if b == 32 || b == 9 || b == 13 { st[0] = st[0] + 1; continue; }
        if b == 10 { st[0] = st[0] + 1; st[1] = st[1] + 1; continue; }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
            while st[0] < n && p[st[0]] as i64 != 10 { st[0] = st[0] + 1; }
            continue;
        }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
            mut d := 1;
            st[0] = st[0] + 2;
            while st[0] < n && d > 0 {
                c := p[st[0]] as i64;
                if c == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
                    d = d + 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 42 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
                    d = d - 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 10 { st[1] = st[1] + 1; }
                st[0] = st[0] + 1;
            }
            continue;
        }
        scanning = false;
    }
    st[5] = st[1];
    if is_idc(b) {
        s := st[0];
        while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
            st[0] = st[0] + 1;
        }
        st[6] = s;
        st[7] = st[0] - s;
        return kwlook(p, s, st[0] - s);
    }
    if is_dg(b) {
        mut v := 0;
        if b == 48 && st[0] + 1 < n && p[st[0] + 1] as i64 == 120 {
            st[0] = st[0] + 2;
            while st[0] < n && (is_hx(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
                d := p[st[0]] as i64;
                if d != 95 { v = v * 16 + hxv(d); }
                st[0] = st[0] + 1;
            }
            st[6] = v;
            return 1;
        }
        while st[0] < n && (is_dg(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
            d := p[st[0]] as i64;
            if d != 95 { v = v * 10 + (d - 48); }
            st[0] = st[0] + 1;
        }
        st[6] = v;
        return 1;                          // T_INT
    }
    if b == 34 {
        st[0] = st[0] + 1;
        return scan_string(p, n, st, 0);
    }
    st[0] = st[0] + 1;
    mut b2 := 0;
    if st[0] < n { b2 = p[st[0]] as i64; }
    if b == 40 { return 37; }              // (
    if b == 41 { return 38; }              // )
    if b == 44 { return 41; }              // ,
    if b == 59 { return 42; }              // ;
    if b == 46 {
        if b2 == 46 { st[0] = st[0] + 1; return 30; }
        return 68;
    }
    if b == 91 { return 34; }              // [
    if b == 93 { return 35; }              // ]
    if b == 63 { return 69; }              // ?
    if b == 94 { return 65; }              // ^
    if b == 37 { return 51; }              // %
    if b == 42 { return 49; }              // *
    if b == 47 { return 50; }              // /
    if b == 123 {
        st[3] = st[3] + 1;
        return 39;
    }
    if b == 125 {
        if st[2] >= 0 && st[3] == st[8 + st[2]] {
            st[2] = st[2] - 1;
            st[4] = 1;
            return 6;
        }
        st[3] = st[3] - 1;
        return 40;
    }
    if b == 58 {
        if b2 == 61 { st[0] = st[0] + 1; return 44; }
        return 43;
    }
    if b == 45 {
        if b2 == 62 { st[0] = st[0] + 1; return 45; }
        if b2 == 61 { st[0] = st[0] + 1; return 53; }
        return 48;
    }
    if b == 43 {
        if b2 == 61 { st[0] = st[0] + 1; return 52; }
        return 47;
    }
    if b == 61 {
        if b2 == 61 { st[0] = st[0] + 1; return 54; }
        if b2 == 62 { st[0] = st[0] + 1; return 26; }
        return 46;
    }
    if b == 33 {
        if b2 == 61 { st[0] = st[0] + 1; return 55; }
        return 60;
    }
    if b == 60 {
        if b2 == 61 { st[0] = st[0] + 1; return 57; }
        if b2 == 60 { st[0] = st[0] + 1; return 66; }
        return 56;
    }
    if b == 62 {
        if b2 == 61 { st[0] = st[0] + 1; return 59; }
        if b2 == 62 { st[0] = st[0] + 1; return 67; }
        return 58;
    }
    if b == 38 {
        if b2 == 38 { st[0] = st[0] + 1; return 61; }
        return 63;
    }
    if b == 124 {
        if b2 == 124 { st[0] = st[0] + 1; return 62; }
        return 64;
    }
    if b == 35 {
        if st[0] + 6 <= n && eq6(p, st[0], 91, 117, 115, 101, 114, 93) {
            st[0] = st[0] + 6;
            return 31;                     // #[user]
        }
        if st[0] + 15 <= n && eq8(p, st[0], 91, 99, 97, 112, 115, 40, 115, 121)
            && eq7(p, st[0] + 8, 115, 99, 97, 108, 108, 41, 93) {
            st[0] = st[0] + 15;
            return 32;                     // #[caps(syscall)]
        }
        if st[0] + 6 <= n && eq6(p, st[0], 91, 100, 114, 111, 112, 40) {
            st[0] = st[0] + 6;
            s2 := st[0];
            mut got := false;
            while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
                st[0] = st[0] + 1;
                got = true;
            }
            if !got { return -1; }
            if st[0] + 2 > n { return -1; }
            if !(p[st[0]] as i64 == 41 && p[st[0] + 1] as i64 == 93) { return -1; }
            st[6] = s2;
            st[7] = st[0] - s2;
            st[0] = st[0] + 2;
            return 33;
        }
        return -1;                         // unknown attribute
    }
    return -1;                             // unexpected character
}

// ---------------------------------------------------------------- //
// The parser proper. A two-token WINDOW rides in the state block:
// CUR at st[24..27] (kind, line, value/start, len), NEXT at
// st[28..31] — ncc keeps one token and peeks a second exactly once
// (telling `x := e` from an expression statement); the window is
// that, made explicit. adv() shifts and lexes; the p*/-helpers
// mirror ncc's pchk/pacc/pexp.

fn adv(p: *u8, n: i64, st: *i64) {
    st[24] = st[28]; st[25] = st[29]; st[26] = st[30]; st[27] = st[31];
    k := next_kind(p, n, st);
    st[28] = k; st[29] = st[5]; st[30] = st[6]; st[31] = st[7];
}

fn ck(st: *i64, k: i64) -> bool {
    return st[24] == k;
}

fn ck2(st: *i64, k: i64) -> bool {
    return st[28] == k;
}

fn acc(p: *u8, n: i64, st: *i64, k: i64) -> bool {
    if st[24] == k { adv(p, n, st); return true; }
    return false;
}

// An unsupported or unexpected construct: differential targets are
// valid sources inside the stated coverage, so this line appearing
// in a dump means the PARSER is wrong — the diff catches it.
fn perr(st: *i64) {
    l := st[25];
    put("PARSE-ERR {l}\n");
}

// A parsed type, by value: ptrs, is_user, and the name's span.
struct T { pt: i64, us: i64, s: i64, l: i64 }

// ncc's parse_type: [#[user]] [raw] *... name.
fn pty(p: *u8, n: i64, st: *i64) -> T {
    mut us := 0;
    if acc(p, n, st, 31) { us = 1; }       // #[user]
    mut israw := 0;
    if ck(st, 19) { adv(p, n, st); israw = 1; } // raw (lowers identically)
    mut pt := 0;
    mut going := true;
    while going {
        going = false;
        if ck(st, 49) { adv(p, n, st); pt = pt + 1; going = true; }
    }
    if ck(st, 10) {                        // fn(A, B) -> R (v0.24)
        adv(p, n, st);
        if pt > 0 || us == 1 || israw == 1 { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
        return pfnty(p, n, st);
    }
    if !ck(st, 7) { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    s := st[26];
    l := st[27];
    adv(p, n, st);
    T{ pt: pt, us: us, s: s, l: l }
}

// A type's name: a source span, or — for a function type (v0.24) — the
// interned `__nyx_fnN` ncc names it by (s < 0 encodes N as -1 - s, l 0).
fn put_tyname(p: *u8, s: i64, l: i64) {
    if s < 0 {
        idx := 0 - 1 - s;
        put("__nyx_fn{idx}");
        return;
    }
    put_span(p, s, l);
}

// " ptrs:is_user:name" — the dump's type rendering, ncc's ast_ty.
fn put_ty(p: *u8, t: T) {
    pt := t.pt;
    us := t.us;
    put(" {pt}:{us}:");
    put_tyname(p, t.s, t.l);
}

// ---- function types (v0.24) ------------------------------------- //
// ncc interns each distinct signature once, in first-seen source order,
// and names it __nyx_fnN. The table lives in st[44] (32 entries of 72
// words: np, has_ret, ret T (4), then up to 16 param T's (4 each)) with
// the count in st[45]; a parse in progress fills a per-depth scratch
// slot (st[46], depth st[47]) because a parameter may itself be a fn
// type, interned first — exactly ncc's recursive parse_type.

// Two type quadruples name the same type: same shape, same name bytes;
// interned names (l 0) compare by their sentinel.
fn ty_same(p: *u8, pt1: i64, us1: i64, s1: i64, l1: i64, pt2: i64, us2: i64, s2: i64, l2: i64) -> bool {
    if pt1 != pt2 || us1 != us2 || l1 != l2 { return false; }
    if l1 == 0 { return s1 == s2; }
    mut k := 0;
    while k < l1 {
        if p[s1 + k] != p[s2 + k] { return false; }
        k = k + 1;
    }
    true
}

fn fnty_same(p: *u8, a: *i64, b: *i64) -> bool {
    if a[0] != b[0] { return false; }
    if a[1] != b[1] { return false; }
    if a[1] == 1 {
        if !ty_same(p, a[2], a[3], a[4], a[5], b[2], b[3], b[4], b[5]) { return false; }
    }
    mut k := 0;
    while k < a[0] {
        o := 6 + k * 4;
        if !ty_same(p, a[o], a[o + 1], a[o + 2], a[o + 3], b[o], b[o + 1], b[o + 2], b[o + 3]) { return false; }
        k = k + 1;
    }
    true
}

// The interned index of the signature in scratch slot sc, added on
// first sight.
fn fnty_intern(p: *u8, st: *i64, sc: *i64) -> i64 {
    cnt := st[45];
    mut i := 0;
    while i < cnt {
        e := (st[44] as addr + (i * 576) as addr) as *i64;
        if fnty_same(p, e, sc) { return i; }
        i = i + 1;
    }
    if cnt >= 32 { perr(st); return 0; }
    e2 := (st[44] as addr + (cnt * 576) as addr) as *i64;
    mut k := 0;
    while k < 72 {
        e2[k] = sc[k];
        k = k + 1;
    }
    st[45] = cnt + 1;
    cnt
}

// fn(A, B) -> R in type position, CUR at '(' (the `fn` is consumed).
fn pfnty(p: *u8, n: i64, st: *i64) -> T {
    if !ck(st, 37) { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    adv(p, n, st);
    d := st[47];
    if d >= 4 { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    st[47] = d + 1;
    sc := (st[46] as addr + (d * 576) as addr) as *i64;
    mut np := 0;
    mut more := !ck(st, 38);
    while more {
        more = false;
        t := pty(p, n, st);
        if np < 16 {
            sc[6 + np * 4] = t.pt;
            sc[7 + np * 4] = t.us;
            sc[8 + np * 4] = t.s;
            sc[9 + np * 4] = t.l;
        }
        np = np + 1;
        if acc(p, n, st, 41) { more = true; }
    }
    if !ck(st, 38) { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    adv(p, n, st);
    sc[0] = np;
    sc[1] = 0;
    sc[2] = 0;
    sc[3] = 0;
    sc[4] = 0;
    sc[5] = 0;
    if acc(p, n, st, 45) {                 // -> R
        r := pty(p, n, st);
        sc[1] = 1;
        sc[2] = r.pt;
        sc[3] = r.us;
        sc[4] = r.s;
        sc[5] = r.l;
    }
    st[47] = d;
    idx := fnty_intern(p, st, sc);
    T{ pt: 0, us: 0, s: 0 - 1 - idx, l: 0 }
}

// The numbering pass: ncc interns while it parses the file top to
// bottom, but this parser dumps by category (five passes), so a fn
// type first met in a later pass would get the wrong number. `fn`
// followed by '(' occurs only in type position (declarations and
// methods have a name after `fn`), so one scan over the tokens interns
// every fn type in source order before any category pass runs.
fn prepass_fntys(p: *u8, n: i64, st: *i64) {
    mut going := true;
    while going {
        if ck(st, 0) { going = false; continue; }
        if ck(st, 10) {
            adv(p, n, st);
            if ck(st, 37) {
                t := pfnty(p, n, st);
                if t.pt != 0 { perr(st); }
            }
            continue;
        }
        adv(p, n, st);
    }
}

// ---- the expression ladder: parse AND print, postorder ---------- //

fn pexpr(p: *u8, n: i64, st: *i64) {
    por(p, n, st);
}

// Interpolation: hole expressions print as parsed (children first);
// the frag specs — #tlen for text, @fmt.width.zero for holes — are
// remembered in a fresh arena and printed on the E 3 line.
#[caps(syscall)]
fn pinterp(p: *u8, n: i64, st: *i64) {
    fr := sys_sbrk(2048) as *i64;          // frag records, 4 words each
    mut nf := 0;
    fr[0] = 0; fr[1] = st[26];             // the HEAD text: #tlen
    nf = 1;
    adv(p, n, st);
    mut going := true;
    while going {
        mut fmt := 0;
        mut wid := 0;
        mut zer := 0;
        pexpr(p, n, st);                   // the hole, printed inline
        if acc(p, n, st, 43) {             // ':' format spec (one ident)
            ss := st[26];
            sl := st[27];
            if !ck(st, 7) { perr(st); return; }
            adv(p, n, st);
            mut i := 0;
            c0 := p[ss] as i64;
            if c0 == 119 || c0 == 122 {    // w / z
                if c0 == 122 { zer = 1; }
                i = 1;
                mut wd := 0;
                while i < sl && is_dg(p[ss + i] as i64) {
                    wd = wd * 10 + (p[ss + i] as i64 - 48);
                    i = i + 1;
                }
                wid = wd;
            }
            if i < sl && p[ss + i] as i64 == 120 { fmt = 1; i = i + 1; }
            if i < sl && p[ss + i] as i64 == 88 { fmt = 2; i = i + 1; }
        }
        fr[nf * 4] = 1; fr[nf * 4 + 1] = fmt;
        fr[nf * 4 + 2] = wid; fr[nf * 4 + 3] = zer;
        nf = nf + 1;
        if !ck(st, 6) { perr(st); return; }    // T_INTERP_R
        adv(p, n, st);
        if ck(st, 4) {                     // MID: another text + hole
            fr[nf * 4] = 0; fr[nf * 4 + 1] = st[26];
            nf = nf + 1;
            adv(p, n, st);
            continue;
        }
        if ck(st, 5) {                     // TAIL: the last text
            fr[nf * 4] = 0; fr[nf * 4 + 1] = st[26];
            nf = nf + 1;
            adv(p, n, st);
            going = false;
            continue;
        }
        perr(st);
        return;
    }
    put("E 3 {nf}");
    mut q := 0;
    while q < nf {
        if fr[q * 4] == 1 {
            f := fr[q * 4 + 1];
            w := fr[q * 4 + 2];
            z := fr[q * 4 + 3];
            put(" @{f}.{w}.{z}");
        }
        if fr[q * 4] == 0 {
            t := fr[q * 4 + 1];
            put(" #{t}");
        }
        q = q + 1;
    }
    put("\n");
}

// Struct-literal fields / call arguments share a field-name arena.
#[caps(syscall)]
fn pprimary(p: *u8, n: i64, st: *i64) {
    if ck(st, 1) {                         // int
        v := st[26];
        adv(p, n, st);
        put("E 0 {v}\n");
        return;
    }
    if ck(st, 20) || ck(st, 21) {          // true / false
        mut v := 0;
        if ck(st, 20) { v = 1; }
        adv(p, n, st);
        put("E 1 {v}\n");
        return;
    }
    if ck(st, 2) {                         // plain string: #count
        c := st[26];
        adv(p, n, st);
        put("E 2 #{c}\n");
        return;
    }
    if ck(st, 3) {                         // interpolation HEAD
        pinterp(p, n, st);
        return;
    }
    if ck(st, 37) {                        // '(': parens re-enable slits
        adv(p, n, st);
        save := st[32];
        st[32] = 0;
        pexpr(p, n, st);
        st[32] = save;
        if !ck(st, 38) { perr(st); return; }
        adv(p, n, st);
        return;
    }
    if ck(st, 7) {                         // a name, or Name{ ... }
        ns := st[26];
        nl := st[27];
        adv(p, n, st);
        if ck(st, 39) && st[32] == 0 {     // struct literal
            adv(p, n, st);
            fs := sys_sbrk(256) as *i64;   // field-name spans, 2 words each
            mut na := 0;
            mut more := !ck(st, 40);
            while more {
                more = false;
                if ck(st, 40) { continue; }    // trailing comma
                if !ck(st, 7) { perr(st); return; }
                fs[na * 2] = st[26];
                fs[na * 2 + 1] = st[27];
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return; }
                adv(p, n, st);
                pexpr(p, n, st);           // the value, printed inline
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 40) { perr(st); return; }
            adv(p, n, st);
            put("E 10 {na} ");
            put_span(p, ns, nl);
            mut q := 0;
            while q < na {
                put(" ");
                put_span(p, fs[q * 2], fs[q * 2 + 1]);
                q = q + 1;
            }
            put("\n");
            return;
        }
        put("E 4 ");
        put_span(p, ns, nl);
        put("\n");
        return;
    }
    perr(st);
}

// Postfix: field reads, calls (the callee just printed = children
// first, ncc's own dump order), enum-variant literals, indexing.
#[caps(syscall)]
fn ppostfix(p: *u8, n: i64, st: *i64) {
    // The primary may be a path that a variant literal needs by NAME
    // (E 11 prints enum+variant, no child path) — peek that case
    // before printing: Name '.' Name '{' with slits enabled.
    if ck(st, 7) && ck2(st, 68) {
        // Cannot see the 4th token; parse the path now and handle
        // `.field{` at the postfix loop with the path ALREADY printed
        // — except a variant literal must NOT print the path. So:
        // remember the name, consume '.', look one ahead.
        ns := st[26];
        nl := st[27];
        adv(p, n, st);                     // the name
        adv(p, n, st);                     // '.'
        if !ck(st, 7) { perr(st); return; }
        fs := st[26];
        fl := st[27];
        adv(p, n, st);                     // the field name
        if ck(st, 39) && st[32] == 0 {     // Enum.Variant{ ... }
            adv(p, n, st);
            fns := sys_sbrk(256) as *i64;
            mut na := 0;
            mut more := !ck(st, 40);
            while more {
                more = false;
                if ck(st, 40) { continue; }
                if !ck(st, 7) { perr(st); return; }
                fns[na * 2] = st[26];
                fns[na * 2 + 1] = st[27];
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return; }
                adv(p, n, st);
                pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 40) { perr(st); return; }
            adv(p, n, st);
            put("E 11 {na} ");
            put_span(p, ns, nl);
            put(" ");
            put_span(p, fs, fl);
            mut q := 0;
            while q < na {
                put(" ");
                put_span(p, fns[q * 2], fns[q * 2 + 1]);
                q = q + 1;
            }
            put("\n");
            ppostfix_tail(p, n, st);
            return;
        }
        // A plain field read (or method call) on a path: print the
        // path (the base child), then the field/call.
        put("E 4 ");
        put_span(p, ns, nl);
        put("\n");
        pfield_or_call(p, n, st, fs, fl);
        ppostfix_tail(p, n, st);
        return;
    }
    pprimary(p, n, st);
    ppostfix_tail(p, n, st);
}

// The postfix loop AFTER the head expression has printed.
fn ppostfix_tail(p: *u8, n: i64, st: *i64) {
    mut going := true;
    while going {
        going = false;
        if ck(st, 68) {                    // '.' field or method
            adv(p, n, st);
            if !ck(st, 7) { perr(st); return; }
            fs := st[26];
            fl := st[27];
            adv(p, n, st);
            pfield_or_call(p, n, st, fs, fl);
            going = true;
            continue;
        }
        if ck(st, 37) {                    // '(': a call on the head
            adv(p, n, st);
            mut na := 0;
            mut more := !ck(st, 38);
            while more {
                more = false;
                pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 38) { perr(st); return; }
            adv(p, n, st);
            put("E 5 {na}\n");
            going = true;
            continue;
        }
        if ck(st, 34) {                    // '[' index ']'
            adv(p, n, st);
            pexpr(p, n, st);
            if !ck(st, 35) { perr(st); return; }
            adv(p, n, st);
            put("E 12\n");
            going = true;
            continue;
        }
    }
}

// After base + '.' + name: a method call prints E 6 then the args and
// E 5 (callee = the field, ncc's shape); a plain read prints E 6.
fn pfield_or_call(p: *u8, n: i64, st: *i64, fs: i64, fl: i64) {
    if ck(st, 37) {                        // method call
        put("E 6 ");
        put_span(p, fs, fl);
        put("\n");
        adv(p, n, st);
        mut na := 0;
        mut more := !ck(st, 38);
        while more {
            more = false;
            pexpr(p, n, st);
            na = na + 1;
            if acc(p, n, st, 41) { more = true; }
        }
        if !ck(st, 38) { perr(st); return; }
        adv(p, n, st);
        put("E 5 {na}\n");
        return;
    }
    put("E 6 ");
    put_span(p, fs, fl);
    put("\n");
}

fn punary(p: *u8, n: i64, st: *i64) {
    if ck(st, 48) {                        // unary '-'
        adv(p, n, st);
        punary(p, n, st);
        put("E 7 -\n");
        return;
    }
    if ck(st, 60) {                        // '!'
        adv(p, n, st);
        punary(p, n, st);
        put("E 7 !\n");
        return;
    }
    ppostfix(p, n, st);
}

fn pcast(p: *u8, n: i64, st: *i64) {
    punary(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 18) {                    // 'as' TYPE
            adv(p, n, st);
            t := pty(p, n, st);
            put("E 9");
            put_ty(p, t);
            put("\n");
            going = true;
        }
    }
}

fn pmul(p: *u8, n: i64, st: *i64) {
    pcast(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 49) { adv(p, n, st); pcast(p, n, st); put("E 8 *\n"); going = true; continue; }
        if ck(st, 50) { adv(p, n, st); pcast(p, n, st); put("E 8 /\n"); going = true; continue; }
        if ck(st, 51) { adv(p, n, st); pcast(p, n, st); put("E 8 %\n"); going = true; }
    }
}

fn padd2(p: *u8, n: i64, st: *i64) {
    pmul(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 47) { adv(p, n, st); pmul(p, n, st); put("E 8 +\n"); going = true; continue; }
        if ck(st, 48) { adv(p, n, st); pmul(p, n, st); put("E 8 -\n"); going = true; }
    }
}

fn pshift(p: *u8, n: i64, st: *i64) {
    padd2(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 66) { adv(p, n, st); padd2(p, n, st); put("E 8 <<\n"); going = true; continue; }
        if ck(st, 67) { adv(p, n, st); padd2(p, n, st); put("E 8 >>\n"); going = true; }
    }
}

fn pband(p: *u8, n: i64, st: *i64) {
    pshift(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 63) { adv(p, n, st); pshift(p, n, st); put("E 8 &\n"); going = true; }
    }
}

fn pbxor(p: *u8, n: i64, st: *i64) {
    pband(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 65) { adv(p, n, st); pband(p, n, st); put("E 8 ^\n"); going = true; }
    }
}

fn pbor(p: *u8, n: i64, st: *i64) {
    pbxor(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 64) { adv(p, n, st); pbxor(p, n, st); put("E 8 |\n"); going = true; }
    }
}

fn pcmp(p: *u8, n: i64, st: *i64) {
    pbor(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 54) { adv(p, n, st); pbor(p, n, st); put("E 8 ==\n"); going = true; continue; }
        if ck(st, 55) { adv(p, n, st); pbor(p, n, st); put("E 8 !=\n"); going = true; continue; }
        if ck(st, 56) { adv(p, n, st); pbor(p, n, st); put("E 8 <\n"); going = true; continue; }
        if ck(st, 57) { adv(p, n, st); pbor(p, n, st); put("E 8 <=\n"); going = true; continue; }
        if ck(st, 58) { adv(p, n, st); pbor(p, n, st); put("E 8 >\n"); going = true; continue; }
        if ck(st, 59) { adv(p, n, st); pbor(p, n, st); put("E 8 >=\n"); going = true; }
    }
}

fn pand(p: *u8, n: i64, st: *i64) {
    pcmp(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 61) { adv(p, n, st); pcmp(p, n, st); put("E 8 &&\n"); going = true; }
    }
}

fn por(p: *u8, n: i64, st: *i64) {
    pand(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 62) { adv(p, n, st); pand(p, n, st); put("E 8 ||\n"); going = true; }
    }
}

// ---- statements + blocks --------------------------------------- //

// match <subject> { arms } with `match` consumed. exprarms: 1 = the
// value form (:=/=/return match — arms yield expressions), 0 = the
// statement form (arm bodies are blocks). The caller prints the
// assign lhs BEFORE calling (the anchor dumps it as a child); mt +
// the name/aop spans feed the S 9 line. Arms print children first,
// then their A line: variant, binds, form.
#[caps(syscall)]
fn pmatch(p: *u8, n: i64, st: *i64, exprarms: i64, mt: i64, ns2: i64, nl2: i64, aop: i64) {
    st[32] = 1;
    pexpr(p, n, st);
    st[32] = 0;
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    bs := sys_sbrk(512) as *i64;           // bind spans, 8 x 2 per arm
    mut na := 0;
    mut more := !ck(st, 40);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return; }
        vs := st[26];
        vl := st[27];
        adv(p, n, st);
        mut nb := 0;
        if acc(p, n, st, 37) {             // (binds)
            mut inner := true;
            while inner {
                inner = false;
                if !ck(st, 7) { perr(st); return; }
                bs[nb * 2] = st[26];
                bs[nb * 2 + 1] = st[27];
                adv(p, n, st);
                nb = nb + 1;
                if acc(p, n, st, 41) { inner = true; }
            }
            if !ck(st, 38) { perr(st); return; }
            adv(p, n, st);
        }
        if !ck(st, 26) { perr(st); return; }   // '=>'
        adv(p, n, st);
        if exprarms == 1 { pexpr(p, n, st); }
        if exprarms == 0 { pblock(p, n, st); }
        put("A ");
        put_span(p, vs, vl);
        put(" {nb}");
        mut q := 0;
        while q < nb {
            put(" ");
            put_span(p, bs[q * 2], bs[q * 2 + 1]);
            q = q + 1;
        }
        put(" {exprarms}\n");
        na = na + 1;
        if acc(p, n, st, 41) {
            if !ck(st, 40) { more = true; }
        }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
    put("S 9 {na} {mt} ");
    if nl2 > 0 { put_span(p, ns2, nl2); }
    if nl2 == 0 { put("-"); }
    put(" ");
    if aop == 0 { put("-"); }
    if aop == 1 { put("="); }
    if aop == 2 { put("+="); }
    if aop == 3 { put("-="); }
    put("\n");
}

fn pif(p: *u8, n: i64, st: *i64) {
    adv(p, n, st);                         // 'if'
    st[32] = 1;
    pexpr(p, n, st);
    st[32] = 0;
    pblock(p, n, st);
    mut has_else := 0;
    if acc(p, n, st, 14) {                 // else, or else-if (ncc wraps
        has_else = 1;                      // the nested if in a one-stmt
        mut inner := 0;                    // block with no tail)
        if ck(st, 13) {
            inner = 1;
            pif(p, n, st);
            put("B 1 0\n");
        }
        if inner == 0 {
            pblock(p, n, st);
        }
    }
    put("S 5 {has_else}\n");
}

// One block: statements print as parsed, then the tail, then B n t.
fn pblock(p: *u8, n: i64, st: *i64) {
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut ns := 0;
    mut going := true;
    while going {
        if ck(st, 40) { going = false; continue; }
        if ck(st, 0) { perr(st); return; }
        if ck(st, 11) || (ck(st, 7) && ck2(st, 44)) {   // [mut] name :=
            mut im := 0;
            if acc(p, n, st, 11) { im = 1; }
            if !ck(st, 7) { perr(st); return; }
            is := st[26];
            il := st[27];
            adv(p, n, st);
            if !ck(st, 44) { perr(st); return; }
            adv(p, n, st);
            if ck(st, 25) {                    // x := match subj { ... };
                adv(p, n, st);
                pmatch(p, n, st, 1, 1, is, il, 0);
                if !ck(st, 42) { perr(st); return; }
                adv(p, n, st);
                ns = ns + 1;
                continue;
            }
            pexpr(p, n, st);
            mut tr := 0;
            if acc(p, n, st, 69) { tr = 1; }   // x := e?;
            if !ck(st, 42) { perr(st); return; }
            adv(p, n, st);
            put("S 0 {im} {tr} ");
            put_span(p, is, il);
            put("\n");
            ns = ns + 1;
            continue;
        }
        if acc(p, n, st, 12) {             // return [e] ;
            if ck(st, 25) {                // return match subj { ... };
                adv(p, n, st);
                pmatch(p, n, st, 1, 3, 0, 0, 0);
                if !ck(st, 42) { perr(st); return; }
                adv(p, n, st);
                ns = ns + 1;
                continue;
            }
            if ck(st, 42) {
                adv(p, n, st);
                put("nil\n");
                put("S 2 0\n");
                ns = ns + 1;
                continue;
            }
            pexpr(p, n, st);
            if !ck(st, 42) { perr(st); return; }
            adv(p, n, st);
            put("S 2 0\n");
            ns = ns + 1;
            continue;
        }
        if acc(p, n, st, 16) {             // break ;
            if !ck(st, 42) { perr(st); return; }
            adv(p, n, st);
            put("S 6\n");
            ns = ns + 1;
            continue;
        }
        if acc(p, n, st, 17) {             // continue ;
            if !ck(st, 42) { perr(st); return; }
            adv(p, n, st);
            put("S 7\n");
            ns = ns + 1;
            continue;
        }
        if acc(p, n, st, 23) {             // defer e ;
            pexpr(p, n, st);
            if !ck(st, 42) { perr(st); return; }
            adv(p, n, st);
            put("S 8\n");
            ns = ns + 1;
            continue;
        }
        if ck(st, 15) {                    // while cond { }
            adv(p, n, st);
            st[32] = 1;
            pexpr(p, n, st);
            st[32] = 0;
            pblock(p, n, st);
            put("S 4\n");
            ns = ns + 1;
            continue;
        }
        if ck(st, 13) {                    // if
            pif(p, n, st);
            ns = ns + 1;
            continue;
        }
        if ck(st, 25) {                    // match subj { arms } — the
            adv(p, n, st);                 // statement form
            pmatch(p, n, st, 0, 0, 0, 0, 0);
            ns = ns + 1;
            continue;
        }
        if ck(st, 28) {                    // for name in a..b { }
            adv(p, n, st);
            if !ck(st, 7) { perr(st); return; }
            fs2 := st[26];
            fl2 := st[27];
            adv(p, n, st);
            if !ck(st, 29) { perr(st); return; }   // 'in'
            adv(p, n, st);
            st[32] = 1;
            pexpr(p, n, st);
            if !ck(st, 30) { perr(st); return; }   // '..'
            adv(p, n, st);
            pexpr(p, n, st);
            st[32] = 0;
            pblock(p, n, st);
            put("S 10 ");
            put_span(p, fs2, fl2);
            put("\n");
            ns = ns + 1;
            continue;
        }
        // expression, assignment, or the block tail
        pexpr(p, n, st);
        if ck(st, 46) || ck(st, 52) || ck(st, 53) {
            mut op := 0;                   // 0 '=', 1 '+=', 2 '-='
            if ck(st, 52) { op = 1; }
            if ck(st, 53) { op = 2; }
            adv(p, n, st);
            if ck(st, 25) {                // lhs = match subj { ... }; —
                adv(p, n, st);             // the lhs printed already (the
                pmatch(p, n, st, 1, 2, 0, 0, op + 1);   // anchor's child)
                if !ck(st, 42) { perr(st); return; }
                adv(p, n, st);
                ns = ns + 1;
                continue;
            }
            pexpr(p, n, st);
            mut tr := 0;
            if acc(p, n, st, 69) { tr = 1; }   // lhs = e?;
            if !ck(st, 42) { perr(st); return; }
            adv(p, n, st);
            if op == 0 { put("S 1 {tr} =\n"); }
            if op == 1 { put("S 1 {tr} +=\n"); }
            if op == 2 { put("S 1 {tr} -=\n"); }
            ns = ns + 1;
            continue;
        }
        if acc(p, n, st, 69) {             // e? ; — propagate only
            if !ck(st, 42) { perr(st); return; }
            adv(p, n, st);
            put("S 3 1\n");
            ns = ns + 1;
            continue;
        }
        if acc(p, n, st, 42) {             // e ; — expression statement
            put("S 3 0\n");
            ns = ns + 1;
            continue;
        }
        if ck(st, 40) {                    // the block tail
            adv(p, n, st);
            put("B {ns} 1\n");
            return;
        }
        perr(st);
        return;
    }
    adv(p, n, st);                         // '}' — no tail
    put("B {ns} 0\n");
}

// ---- items ------------------------------------------------------ //

// Params fill a caller-provided arena: name span + T, 6 words each.
// Returns the count.
fn pparams(p: *u8, n: i64, st: *i64, ps: *i64) -> i64 {
    if !ck(st, 37) { perr(st); return 0; }
    adv(p, n, st);
    mut np := 0;
    mut more := !ck(st, 38);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return np; }
        ps[np * 6] = st[26];
        ps[np * 6 + 1] = st[27];
        adv(p, n, st);
        if !ck(st, 43) { perr(st); return np; }
        adv(p, n, st);
        t := pty(p, n, st);
        ps[np * 6 + 2] = t.pt;
        ps[np * 6 + 3] = t.us;
        ps[np * 6 + 4] = t.s;
        ps[np * 6 + 5] = t.l;
        np = np + 1;
        if acc(p, n, st, 41) { more = true; }
    }
    if !ck(st, 38) { perr(st); return np; }
    adv(p, n, st);
    return np;
}

fn put_params(p: *u8, ps: *i64, np: i64) {
    mut q := 0;
    while q < np {
        put(" ");
        put_span(p, ps[q * 6], ps[q * 6 + 1]);
        pt := ps[q * 6 + 2];
        us := ps[q * 6 + 3];
        put(" {pt}:{us}:");
        put_tyname(p, ps[q * 6 + 4], ps[q * 6 + 5]);
        q = q + 1;
    }
}

// Skip one top-level item without printing: advance to its opening
// '{', then count braces to the close. Safe: string-interpolation
// braces never tokenize as LB/RB.
fn skip_item(p: *u8, n: i64, st: *i64) {
    mut going := true;
    while going {
        if ck(st, 0) { return; }
        if ck(st, 39) { going = false; continue; }
        adv(p, n, st);
    }
    adv(p, n, st);
    mut d := 1;
    while d > 0 {
        if ck(st, 0) { return; }
        if ck(st, 39) { d = d + 1; }
        if ck(st, 40) { d = d - 1; }
        adv(p, n, st);
    }
}

// struct Name { f: ty, ... } — one D line: name is_own dropfn nf
// then each field name + type. Fields collect in the shared arena
// first (the count leads the fields in the line).
fn pstruct(p: *u8, n: i64, st: *i64, isown: i64, hasdrop: i64, ds: i64, dl: i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    ns := st[26];
    nl := st[27];
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut nf := 0;
    mut more := !ck(st, 40);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return; }
        ps[nf * 6] = st[26];
        ps[nf * 6 + 1] = st[27];
        adv(p, n, st);
        if !ck(st, 43) { perr(st); return; }
        adv(p, n, st);
        t := pty(p, n, st);
        ps[nf * 6 + 2] = t.pt;
        ps[nf * 6 + 3] = t.us;
        ps[nf * 6 + 4] = t.s;
        ps[nf * 6 + 5] = t.l;
        nf = nf + 1;
        if acc(p, n, st, 41) {
            if !ck(st, 40) { more = true; }
        }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
    put("D ");
    put_span(p, ns, nl);
    put(" {isown} ");
    if hasdrop == 1 { put_span(p, ds, dl); }
    if hasdrop == 0 { put("-"); }
    put(" {nf}");
    put_params(p, ps, nf);
    put("\n");
}

// enum Name { V, W(f: ty, ...), ... } — one V line per variant (name
// nf fields...), then the U line (name nv).
fn penum(p: *u8, n: i64, st: *i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    ns := st[26];
    nl := st[27];
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut nv := 0;
    mut more := !ck(st, 40);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return; }
        vs := st[26];
        vl := st[27];
        adv(p, n, st);
        mut nf := 0;
        if acc(p, n, st, 37) {             // optional named payload
            mut inner := true;
            while inner {
                inner = false;
                if !ck(st, 7) { perr(st); return; }
                ps[nf * 6] = st[26];
                ps[nf * 6 + 1] = st[27];
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return; }
                adv(p, n, st);
                t := pty(p, n, st);
                ps[nf * 6 + 2] = t.pt;
                ps[nf * 6 + 3] = t.us;
                ps[nf * 6 + 4] = t.s;
                ps[nf * 6 + 5] = t.l;
                nf = nf + 1;
                if acc(p, n, st, 41) { inner = true; }
            }
            if !ck(st, 38) { perr(st); return; }
            adv(p, n, st);
        }
        put("V ");
        put_span(p, vs, vl);
        put(" {nf}");
        put_params(p, ps, nf);
        put("\n");
        nv = nv + 1;
        if acc(p, n, st, 41) {
            if !ck(st, 40) { more = true; }
        }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
    put("U ");
    put_span(p, ns, nl);
    put(" {nv}\n");
}

// extern syscall { fn name(params) [-> ty] = NUM [;] ... } — one X
// line per binding, printed as parsed (our targets declare externs
// first, matching ncc's category-grouped dump order; a source that
// interleaves declarations differently stays off the claimed list).
fn pextern(p: *u8, n: i64, st: *i64, caps: i64, ps: *i64) {
    if !ck(st, 9) { perr(st); return; }    // 'syscall'
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut more := ck(st, 10);
    while more {
        more = false;
        adv(p, n, st);                     // 'fn'
        if !ck(st, 7) { perr(st); return; }
        xs := st[26];
        xl := st[27];
        adv(p, n, st);
        np := pparams(p, n, st, ps);
        mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
        mut has_rt := 0;
        if acc(p, n, st, 45) {             // -> ty
            rt = pty(p, n, st);
            has_rt = 1;
        }
        if !ck(st, 46) { perr(st); return; }
        adv(p, n, st);
        if !ck(st, 1) { perr(st); return; }
        num := st[26];
        adv(p, n, st);
        if ck(st, 42) { adv(p, n, st); }   // optional ';'
        put("X ");
        put_span(p, xs, xl);
        put(" {num} {caps} {np}");
        put_params(p, ps, np);
        if has_rt == 1 { put_ty(p, rt); }
        if has_rt == 0 { put(" 0:0:-"); }
        put("\n");
        if ck(st, 10) { more = true; }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
}

// fn name(params) [-> ty] { body } — the body's block prints first
// (children before parents), then the F header line.
fn pfn(p: *u8, n: i64, st: *i64, caps: i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    fs := st[26];
    fl := st[27];
    adv(p, n, st);
    np := pparams(p, n, st, ps);
    mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
    mut has_rt := 0;
    if acc(p, n, st, 45) {
        rt = pty(p, n, st);
        has_rt = 1;
    }
    pblock(p, n, st);
    put("F ");
    put_span(p, fs, fl);
    put(" {caps} {np}");
    put_params(p, ps, np);
    if has_rt == 1 { put_ty(p, rt); }
    if has_rt == 0 { put(" 0:0:-"); }
    put("\n");
}

// impl Name { fn m(self, p: ty...) [-> ty] { body } ... } — one M
// line per method (body children first): type, name, np, params
// (self excluded, ncc's own table shape), return type. Methods hold
// no capabilities, so no caps field.
fn pimpl(p: *u8, n: i64, st: *i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    ts := st[26];
    tl := st[27];
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut more := ck(st, 10);
    while more {
        more = false;
        adv(p, n, st);                     // 'fn'
        if !ck(st, 7) { perr(st); return; }
        ms := st[26];
        ml := st[27];
        adv(p, n, st);
        if !ck(st, 37) { perr(st); return; }
        adv(p, n, st);
        if !ck(st, 7) { perr(st); return; }    // 'self' leads (ncc
        adv(p, n, st);                     // validates the spelling)
        mut np := 0;
        mut inner := acc(p, n, st, 41);
        while inner {
            inner = false;
            if !ck(st, 7) { perr(st); return; }
            ps[np * 6] = st[26];
            ps[np * 6 + 1] = st[27];
            adv(p, n, st);
            if !ck(st, 43) { perr(st); return; }
            adv(p, n, st);
            t := pty(p, n, st);
            ps[np * 6 + 2] = t.pt;
            ps[np * 6 + 3] = t.us;
            ps[np * 6 + 4] = t.s;
            ps[np * 6 + 5] = t.l;
            np = np + 1;
            if acc(p, n, st, 41) { inner = true; }
        }
        if !ck(st, 38) { perr(st); return; }
        adv(p, n, st);
        mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
        mut has_rt := 0;
        if acc(p, n, st, 45) {
            rt = pty(p, n, st);
            has_rt = 1;
        }
        pblock(p, n, st);
        put("M ");
        put_span(p, ts, tl);
        put(" ");
        put_span(p, ms, ml);
        put(" {np}");
        put_params(p, ps, np);
        if has_rt == 1 { put_ty(p, rt); }
        if has_rt == 0 { put(" 0:0:-"); }
        put("\n");
        if ck(st, 10) { more = true; }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
}

// One category pass over the whole token stream: print only `which`
// (1 structs, 2 enums, 3 externs, 4 fns, 5 impl methods), skip
// everything else by brace counting — ncc's grouped dump order.
fn pass_items(p: *u8, n: i64, st: *i64, which: i64, ps: *i64) {
    mut going := true;
    while going {
        if ck(st, 0) { going = false; continue; }
        mut caps := 0;
        mut isown := 0;
        mut hasdrop := 0;
        mut ds := 0;
        mut dl := 0;
        if ck(st, 33) {                    // #[drop(fn)] own struct
            ds = st[26];
            dl = st[27];
            hasdrop = 1;
            adv(p, n, st);
        }
        if acc(p, n, st, 32) { caps = 1; } // #[caps(syscall)]
        if acc(p, n, st, 36) { isown = 1; }   // own struct
        if ck(st, 22) {                    // struct
            adv(p, n, st);
            if which == 1 { pstruct(p, n, st, isown, hasdrop, ds, dl, ps); }
            if which != 1 { skip_item(p, n, st); }
            continue;
        }
        if ck(st, 24) {                    // enum
            adv(p, n, st);
            if which == 2 { penum(p, n, st, ps); }
            if which != 2 { skip_item(p, n, st); }
            continue;
        }
        if ck(st, 8) {                     // extern
            if which == 3 {
                adv(p, n, st);
                pextern(p, n, st, caps, ps);
            }
            if which != 3 { skip_item(p, n, st); }
            continue;
        }
        if ck(st, 10) {                    // fn
            if which == 4 {
                adv(p, n, st);
                pfn(p, n, st, caps, ps);
            }
            if which != 4 { skip_item(p, n, st); }
            continue;
        }
        if ck(st, 27) {                    // impl
            adv(p, n, st);
            if which == 5 { pimpl(p, n, st, ps); }
            if which != 5 { skip_item(p, n, st); }
            continue;
        }
        perr(st);
        going = false;
    }
}

#[caps(syscall)]
fn main() -> i64 {
    mut path := "/tmp/n_parse_target.n";   // the harness convention is
    if arg_count() > 1 { path = arg(1); }  // the FALLBACK; `nparse file.n`
                                           // names a target (v0.23 argv)
    fd := sys_open(path.ptr as *u8, 0, 0);
    if fd < 0 {
        if arg_count() > 1 {
            put("nparse: cannot open {path}\n");
            return 1;
        }
        put("(no parse target - skipped)\n");
        return 0;
    }
    // The source allocation and the accepted input limit are both 256 KiB.
    memory := sys_sbrk(262144);
    if memory < 0 {
        sys_close(fd);
        put("nparse: cannot allocate input buffer\n");
        return 1;
    }
    buf := memory as *u8;
    limit := 262144;
    mut total := 0;
    mut reading := true;
    while reading {
        mut count := limit - total;
        if count > 16384 { count = 16384; }
        mut target := (buf as addr + total as addr) as *u8;
        // At the exact limit, probe EOF using one byte INSIDE the buffer.
        // An extra byte may overwrite buf[0] only on the rejected path.
        if count == 0 { target = buf; count = 1; }
        r := sys_read(fd, target, count as isize);
        if r < 0 {
            sys_close(fd);
            put("nparse: cannot read {path}\n");
            return 1;
        }
        if r == 0 { reading = false; }
        else {
            if total == limit {
                sys_close(fd);
                put("nparse: input exceeds {limit} bytes: {path}\n");
                return 1;
            }
            total = total + r;
        }
    }
    sys_close(fd);
    if total < 1 { return 0; }
    st := sys_sbrk(512) as *i64;
    ps := sys_sbrk(1024) as *i64;          // the fields/params arena
    st[44] = sys_sbrk(18432);              // fn-type table, 32 x 72 words
    st[45] = 0;                            // ... and its count (v0.24)
    st[46] = sys_sbrk(2304);               // fn-type parse scratch, 4 deep
    st[47] = 0;
    st[0] = 0;                             // the numbering pass: intern
    st[1] = 1;                             // every fn type in source order
    st[2] = -1;
    st[3] = 0;
    st[4] = 0;
    st[32] = 0;
    adv(buf, total, st);
    adv(buf, total, st);
    prepass_fntys(buf, total, st);
    mut pass := 1;
    while pass <= 5 {                      // structs, enums, externs,
                                           // fns, impl methods
        st[0] = 0;
        st[1] = 1;
        st[2] = -1;
        st[3] = 0;
        st[4] = 0;
        st[32] = 0;
        adv(buf, total, st);               // prime NEXT
        adv(buf, total, st);               // ... and CUR
        pass_items(buf, total, st, pass, ps);
        pass = pass + 1;
    }
    put(".\n");
    0
}
