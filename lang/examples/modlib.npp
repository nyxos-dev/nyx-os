// modlib.npp — a module: the file modmain.npp uses (M6.5).
//
// A module is a file. `pub` marks what it exports — here the output helper,
// a generic enum, and a function over one instantiation of it. Everything
// else is private to this file: `is_even` is visible only here (a call
// from modmain.npp is refused), and nppc renames it `__m_1_modlib_is_even`
// in the lowered program so another module's private `is_even` could not
// collide with it. Monomorphization runs over the whole program after `use`
// resolution, so an instantiation made in modmain.npp (`Maybe<str>`) lands
// here, next to the template, once — exactly as it would inside a single
// file.

extern syscall {
    fn write(fd: i32, buf: *u8, len: isize) -> i64 = 1
}

pub fn put(s: str) {
    write(1, s.ptr as *u8, s.len as isize);
}

pub enum Maybe<T> {
    Some(v: T),
    None,
}

fn is_even(n: i64) -> bool {
    n % 2 == 0
}

pub fn first_even(a: i64, b: i64) -> Maybe<i64> {
    if is_even(a) {
        return Maybe.Some{ v: a };
    }
    if is_even(b) {
        return Maybe.Some{ v: b };
    }
    Maybe.None
}
